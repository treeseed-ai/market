{
  "schemaVersion": 2,
  "id": "platform-external-codex",
  "displayName": "External-control-plane Platform with Codex",
  "description": "A TreeSeed Platform using an explicit Admin API endpoint and external Codex execution.",
  "category": "platform",
  "tags": ["platform", "external", "codex"],
  "templateVersion": "1.0.0",
  "templateApiVersion": 2,
  "minCliVersion": "0.12.0",
  "variables": [
    { "name": "Control-plane URL", "token": "__CONTROL_PLANE_BASE_URL__", "deriveFrom": "controlPlaneBaseUrl", "required": true },
    { "name": "Runtime portfolio username", "token": "__PORTFOLIO_USERNAME__", "deriveFrom": "runtime" },
    { "name": "Runtime portfolio email", "token": "__PORTFOLIO_EMAIL__", "deriveFrom": "runtime" },
    { "name": "Runtime portfolio password", "token": "__PORTFOLIO_PASSWORD__", "deriveFrom": "runtime" },
    { "name": "Runtime Mailpit URL", "token": "__PORTFOLIO_MAILPIT_URL__", "deriveFrom": "runtime" }
  ],
  "managedSurface": {
    "coreManaged": ["treeseed.site.yaml", "seeds/platform.yaml", "scenes/team-project-portfolio-demo.yaml"],
    "validatedOnly": ["treeseed.site.yaml", "seeds/platform.yaml", "scenes/team-project-portfolio-demo.yaml"]
  },
  "platform": {
    "controlPlane": { "mode": "external", "baseUrl": "__CONTROL_PLANE_BASE_URL__" },
    "processing": { "mode": "team-owned" },
    "admin": { "enabled": true },
    "executionProvider": "codex",
    "aiAppliance": false,
    "services": ["admin", "agentProvider"],
    "seeds": ["seeds/platform.yaml"],
    "scenes": ["scenes/team-project-portfolio-demo.yaml"]
  },
  "testing": { "smokeCommand": "npx trsd platform status --json", "buildCommand": "npm run verify" }
}
