# syntax=docker/dockerfile:1.7

FROM node:22-slim AS deps
WORKDIR /app
ENV TREESEED_SKIP_PACKAGE_PREPARE=1
COPY package.json package-lock.json ./
COPY packages/sdk/package.json packages/sdk/package.json
COPY packages/sdk/scripts/prepare.mjs packages/sdk/scripts/prepare.mjs
COPY packages/agent/package.json packages/agent/package.json
COPY packages/agent/scripts/prepare.mjs packages/agent/scripts/prepare.mjs
COPY packages/core/package.json packages/core/package.json
COPY packages/core/scripts/prepare.mjs packages/core/scripts/prepare.mjs
COPY packages/cli/package.json packages/cli/package.json
COPY packages/cli/scripts/prepare.mjs packages/cli/scripts/prepare.mjs
RUN --mount=type=cache,target=/root/.npm \
	npm ci --ignore-scripts --no-audit --no-fund --prefer-offline

FROM deps AS build
COPY . .
RUN npm -w packages/sdk run build:dist
RUN npm -w packages/agent run build:dist
RUN npm -w packages/core run build:dist
RUN npm -w packages/cli run build:dist
RUN npm run build:api
RUN --mount=type=cache,target=/root/.npm \
	npm prune --omit=dev --ignore-scripts --no-audit --no-fund

FROM node:22-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV TREESEED_PROCESSING_PARITY=1
ENV TREESEED_DATA_DIR=/data
ENV TREESEED_RUNNER_VOLUME_ROOT=/data
COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/sdk/package.json ./packages/sdk/package.json
COPY --from=build /app/packages/sdk/dist ./packages/sdk/dist
COPY --from=build /app/packages/agent/package.json ./packages/agent/package.json
COPY --from=build /app/packages/agent/dist ./packages/agent/dist
COPY --from=build /app/packages/core/package.json ./packages/core/package.json
COPY --from=build /app/packages/core/dist ./packages/core/dist
COPY --from=build /app/packages/cli/package.json ./packages/cli/package.json
COPY --from=build /app/packages/cli/dist ./packages/cli/dist
COPY --from=build /app/src ./src
COPY --from=build /app/migrations ./migrations
COPY --from=build /app/seeds ./seeds
COPY --from=build /app/scripts ./scripts
COPY --from=build /app/treeseed.site.yaml ./treeseed.site.yaml
COPY --from=build /app/bin ./bin
RUN mkdir -p /data && chmod +x /app/bin/treeseed-processing
EXPOSE 3100
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 CMD ["/app/bin/treeseed-processing", "healthcheck"]
ENTRYPOINT ["/app/bin/treeseed-processing"]
CMD ["api"]
