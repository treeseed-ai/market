---
interface Props {
	slug: string;
	title: string;
	summary: string;
	category?: string;
	featured?: boolean;
	publisherName: string;
	templateVersion?: string;
	priceModel?: string;
}

const {
	slug,
	title,
	summary,
	category,
	featured = false,
	publisherName,
	templateVersion,
	priceModel,
} = Astro.props as Props;
---

<article class="market-card">
	<div class="market-card__header">
		<p class="market-card__eyebrow">{category ?? 'Template'}{featured ? ' · Featured' : ''}</p>
		<h2><a href={`/templates/${slug}/`}>{title}</a></h2>
	</div>
	<p>{summary}</p>
	<p class="market-card__meta">
		Publisher: {publisherName}
		{templateVersion ? ` · v${templateVersion}` : ''}
		{priceModel ? ` · ${priceModel.replaceAll('_', ' ')}` : ''}
	</p>
</article>

<style>
	.market-card {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		padding: 1rem 1.1rem;
		background: var(--sl-color-black);
	}

	.market-card__eyebrow {
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--sl-color-gray-3);
	}

	.market-card__meta {
		color: var(--sl-color-gray-3);
		font-size: 0.95rem;
	}

	.market-card h2 {
		margin: 0.2rem 0 0.6rem;
	}

	.market-card a {
		text-decoration: none;
	}
</style>
