---
import ActionList from '../../../../packages/core/src/components/ui/data/ActionList.astro';
import EmptyState from '../../../../packages/core/src/components/ui/surface/EmptyState.astro';
import Panel from '../../../../packages/core/src/components/ui/surface/Panel.astro';

const { inbox = [] } = Astro.props as any;

function anchorPart(value: unknown) {
	return typeof value === 'string' && value.trim() ? value.trim().replace(/[^a-zA-Z0-9_-]+/g, '-') : '';
}

function governanceHref(item: any) {
	const href = typeof item.href === 'string' ? item.href : '';
	const approvalId = anchorPart(item.metadata?.approvalId);
	const artifactId = anchorPart(item.metadata?.artifactId ?? item.metadata?.draftId);
	if (approvalId && href.includes('/agents') && !href.includes('#')) return `${href}#approval-${approvalId}`;
	if (artifactId && href.includes('/agents') && !href.includes('#')) return `${href}#artifact-${artifactId}`;
	return href || undefined;
}
---

<Panel eyebrow="Inbox" title="Action-required work across the team">
	{inbox.length > 0 ? (
		<ActionList items={inbox.map((item: any) => ({
			title: item.title,
			description: item.summary,
			href: governanceHref(item),
			meta: item.state.replaceAll('_', ' '),
			tone: item.state === 'action_required' ? 'danger' : item.state === 'waiting_for_approval' ? 'warning' : 'info',
			actionLabel: governanceHref(item) ? 'Open' : undefined,
		}))} />
	) : <EmptyState title="Inbox clear" description="No action items are waiting for this team right now." />}
</Panel>
