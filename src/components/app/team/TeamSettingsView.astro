---
import KeyValueList from '../../../../packages/core/src/components/ui/data/KeyValueList.astro';
import Panel from '../../../../packages/core/src/components/ui/surface/Panel.astro';

const { context, members = [], products = [] } = Astro.props as any;---

<div class="ts-section-grid">
	<Panel eyebrow="General" title={context.team?.name}>
		<KeyValueList items={[
			{ key: 'Team name', value: `@${context.team?.name ?? ''}` },
			{ key: 'Members', value: members.length },
			{ key: 'Products', value: products.length },
		]} />
	</Panel>
	<Panel eyebrow="Capabilities" title="Current MVP defaults">
		<KeyValueList items={[
			{ key: 'Hub visibility', value: 'Public-ready by default.' },
			{ key: 'Market publish', value: 'Always human-approved.' },
			{ key: 'Repository Host', value: 'Split software and content repositories are created through the selected repository provider.' },
		]} />
	</Panel>
</div>
