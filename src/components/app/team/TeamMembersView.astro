---
import DataTable from '../../../../packages/core/src/components/ui/data/DataTable.astro';

const { members = [] } = Astro.props as any;---

<DataTable
	columns={[
		{ key: 'member', label: 'Member' },
		{ key: 'status', label: 'Status' },
		{ key: 'roles', label: 'Roles' },
		{ key: 'joined', label: 'Joined' },
	]}
	rows={members.map((member: any) => ({
		member: `${member.displayName ?? member.email ?? member.userId} (${member.email ?? member.userId})`,
		status: member.status,
		roles: member.roles.length > 0 ? member.roles.join(', ') : 'member',
		joined: member.createdAt,
	}))}
	emptyLabel="No members are listed for this team yet."
/>
