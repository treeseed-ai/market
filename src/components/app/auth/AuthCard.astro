---
import Panel from '../../../../packages/core/src/components/ui/surface/Panel.astro';
import ThemeSelector from '../../../../packages/core/src/components/ui/theme/ThemeSelector.astro';
import type { ThemePreference } from '../../../../packages/core/src/utils/theme.ts';

interface Props {
	title: string;
	description: string;
	error?: string;
	notice?: string;
	appearance: ThemePreference;
	appearanceLabel?: string;
	showAppearance?: boolean;
}

const {
	title,
	description,
	error = '',
	notice = '',
	appearance,
	appearanceLabel = 'Appearance',
	showAppearance = true,
} = Astro.props as Props;
---

<Panel class="auth-card">
	<header class="auth-card__header">
		<h1>{title}</h1>
		<p>{description}</p>
	</header>
	{error ? <div class="auth-alert" data-tone="danger" role="alert">{error}</div> : null}
	{notice ? <div class="auth-alert" data-tone="success" role="status">{notice}</div> : null}
	<div class="auth-card__body">
		<slot />
	</div>
	{showAppearance ? (
		<div class="auth-card__appearance">
			<ThemeSelector label={appearanceLabel} selectedScheme={appearance.scheme} selectedMode={appearance.mode} />
		</div>
	) : null}
</Panel>
