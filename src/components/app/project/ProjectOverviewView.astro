---
import ActionList from '../../../../packages/core/src/components/ui/data/ActionList.astro';
import KeyValueList from '../../../../packages/core/src/components/ui/data/KeyValueList.astro';
import MetricGrid from '../../../../packages/core/src/components/ui/data/MetricGrid.astro';
import Panel from '../../../../packages/core/src/components/ui/surface/Panel.astro';
import StatusPill from '../../../../packages/core/src/components/ui/data/StatusPill.astro';

const { summary, agents } = Astro.props as any;
const docsAutomation = agents?.docsAutomation ?? {};
const activeWorkday = docsAutomation.activeWorkdayId ?? agents?.currentWorkday?.id ?? agents?.currentWorkday?.workDayId ?? null;
const latestReport = docsAutomation.latestReport ?? agents?.runtimeReports?.[0] ?? agents?.workdaySummaries?.[0] ?? null;
---

<>
	{summary?.latestLaunch && summary.latestLaunch.state !== 'completed' ? (
		<Panel eyebrow="Launch" title={summary.latestLaunch.state === 'failed' ? 'Launch needs attention' : 'Knowledge Hub is launching'} description={summary.latestLaunch.state === 'failed' ? summary.latestLaunch.error?.message : 'TreeSeed is creating repositories, configuring runtime services, and verifying the hub.'}>
			<StatusPill slot="actions" tone={summary.latestLaunch.state === 'failed' ? 'danger' : 'info'}>{summary.latestLaunch.currentPhase ?? summary.latestLaunch.state}</StatusPill>
			<KeyValueList items={[
				{ key: 'Current step', value: summary.latestLaunch.currentPhase ?? 'launch_queued' },
				{ key: 'What happens next', value: summary.latestLaunch.state === 'failed' ? 'Update the affected host settings, then retry the launch job.' : 'Backend processing will report progress as each durable phase completes.' },
			]} />
			<ActionList items={(summary.latestLaunchEvents ?? []).slice(-4).map((event: any) => ({ title: event.title ?? event.phase, description: `${event.status}${event.summary ? ` - ${event.summary}` : ''}`, tone: event.status === 'failed' ? 'danger' : 'info' }))} />
		</Panel>
	) : null}
	<MetricGrid metrics={[
		{ label: 'Objectives', value: summary?.counts.objectives ?? 0 },
		{ label: 'Proposals', value: summary?.counts.proposals ?? 0 },
		{ label: 'Decisions', value: summary?.counts.decisions ?? 0 },
		{ label: 'Workstreams', value: summary?.counts.activeWorkstreams ?? 0 },
		{ label: 'Agent pools', value: summary?.counts.agentPools ?? 0 },
		{ label: 'Published artifacts', value: summary?.counts.artifacts ?? 0 },
	]} />
	<div class="ts-section-grid ts-stack-top">
		<Panel eyebrow="Project health" title={summary?.health.label ?? 'Unknown'} description={summary?.health.reason}>
			<StatusPill slot="actions" tone={summary?.health.state === 'release_ready' ? 'success' : summary?.health.state === 'verification_failing' ? 'danger' : summary?.health.state === 'setup_needed' ? 'warning' : 'info'}>{summary?.health.label ?? 'Unknown'}</StatusPill>
			<KeyValueList items={[
				{ key: 'Next best action', value: summary?.nextBestAction ?? 'No next action recorded.' },
				{ key: 'Latest prod', value: summary?.latestProdDeployment?.releaseTag ?? 'No prod release recorded yet.' },
				{ key: 'Latest staging', value: summary?.latestStagingDeployment?.releaseTag ?? 'No staging candidate recorded yet.' },
			]} />
		</Panel>
		<Panel eyebrow="Recent activity" title="Timeline">
			<ActionList items={(summary?.recentActivity ?? []).map((item: any) => ({ title: item.title, description: `${item.status} - ${item.timestamp}${item.summary ? ` - ${item.summary}` : ''}`, tone: 'info' }))} />
		</Panel>
	</div>
	<Panel class="ts-stack-top" eyebrow="Docs automation" title={activeWorkday ? 'Governed workday active' : 'No active docs workday'} description="Current documentation agent activity, approvals, verification, and reports from the project agents runtime.">
		<MetricGrid min="8rem" metrics={[
			{ label: 'Generated drafts', value: docsAutomation.knowledgeDraftCount ?? agents?.knowledgeDrafts?.length ?? 0 },
			{ label: 'Pending approvals', value: docsAutomation.pendingApprovalCount ?? agents?.approvals?.length ?? 0, tone: (docsAutomation.pendingApprovalCount ?? agents?.approvals?.length ?? 0) ? 'warning' : 'success' },
			{ label: 'Verification issues', value: docsAutomation.verificationFailureCount ?? 0, tone: (docsAutomation.verificationFailureCount ?? 0) ? 'danger' : 'success' },
			{ label: 'Repair tasks', value: docsAutomation.repairTaskCount ?? agents?.operationLifecycle?.repairTasks?.length ?? 0, tone: (docsAutomation.repairTaskCount ?? agents?.operationLifecycle?.repairTasks?.length ?? 0) ? 'warning' : 'success' },
		]} />
		<KeyValueList items={[
			{ key: 'Active workday', value: activeWorkday ?? 'No active workday reported' },
			{ key: 'Latest report', value: latestReport ? `${latestReport.kind ?? 'workday report'} · ${latestReport.createdAt ?? latestReport.created_at ?? 'recorded'}` : 'No report recorded yet' },
			{ key: 'Review surface', value: 'Open Project Agents for drafts, source maps, approvals, mutations, and task events.' },
		]} />
	</Panel>
	<div class="ts-section-grid ts-stack-top">
		<Panel eyebrow="Repositories" title="Software and content">
			<ActionList items={(summary?.repositories ?? []).map((repository: any) => ({ title: repository.role, description: `${repository.owner}/${repository.name} - ${repository.status}` }))} />
		</Panel>
		<Panel eyebrow="Content source" title="Published content">
			<KeyValueList items={[{ key: 'Production', value: summary?.contentSource?.productionSource ?? 'R2 published artifacts' }, { key: 'Overlay', value: summary?.contentSource?.overlayPolicy ?? 'src/content when present' }]} />
		</Panel>
	</div>
	<Panel class="ts-stack-top" eyebrow="Approvals" title="Action policy">
		<ActionList items={(summary?.capabilityGrants ?? []).filter((grant: any) => grant.approvalPolicy?.requiresApproval).slice(0, 6).map((grant: any) => ({ title: grant.label ?? `${grant.namespace}.${grant.operation}`, description: grant.approvalPolicy?.reason ?? 'Human approval required.', tone: 'warning' }))} />
	</Panel>
</>
