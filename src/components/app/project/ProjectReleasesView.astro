---
import ActionList from '../../../../packages/core/src/components/ui/data/ActionList.astro';
import KeyValueList from '../../../../packages/core/src/components/ui/data/KeyValueList.astro';
import Panel from '../../../../packages/core/src/components/ui/surface/Panel.astro';

const { releases } = Astro.props as any;
---

<div class="ts-section-grid">
	<Panel eyebrow="Current environments" title="Release state">
		<KeyValueList items={[{ key: 'Production', value: releases?.currentProd?.releaseTag ?? 'No production release recorded.' }, { key: 'Staging candidates', value: releases?.stagingCandidates?.length ?? 0 }]} />
	</Panel>
	<Panel eyebrow="Release history" title="Deployments">
		<ActionList items={(releases?.history ?? []).map((entry: any) => ({ title: entry.environment, description: `${entry.status} - ${entry.releaseTag ?? entry.id}`, tone: entry.status === 'failed' ? 'danger' : 'info' }))} />
	</Panel>
</div>
