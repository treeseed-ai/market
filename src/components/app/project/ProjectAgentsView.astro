---
import ActionList from '../../../../packages/core/src/components/ui/data/ActionList.astro';
import DataTable from '../../../../packages/core/src/components/ui/data/DataTable.astro';
import KeyValueList from '../../../../packages/core/src/components/ui/data/KeyValueList.astro';
import MetricGrid from '../../../../packages/core/src/components/ui/data/MetricGrid.astro';
import Panel from '../../../../packages/core/src/components/ui/surface/Panel.astro';
import StatusPill from '../../../../packages/core/src/components/ui/data/StatusPill.astro';

const { agents, capacitySummary, agentReadinessLabel, agentReadinessToneValue, agentReadinessReasons } = Astro.props as any;

const currentWorkday = agents?.currentWorkday ?? null;
const codex = agents?.codexReadiness ?? {};
const generatedArtifacts = Array.isArray(agents?.generatedArtifacts) ? agents.generatedArtifacts : [];
const researchNotes = Array.isArray(agents?.researchNotes) ? agents.researchNotes : [];
const knowledgeDrafts = Array.isArray(agents?.knowledgeDrafts) ? agents.knowledgeDrafts : [];
const optimizationReports = Array.isArray(agents?.optimizationReports) ? agents.optimizationReports : [];
const approvals = Array.isArray(agents?.approvals) ? agents.approvals : [];
const promotionApprovals = approvals.filter((item: any) => compact(item.approvalKind, 'promote_knowledge_draft') !== 'release_staged_knowledge');
const releaseApprovals = approvals.filter((item: any) => compact(item.approvalKind, '') === 'release_staged_knowledge');
const operationGrants = Array.isArray(agents?.operationGrants) ? agents.operationGrants : [];
const operationEvents = Array.isArray(agents?.operationEvents) ? agents.operationEvents : [];
const operationLifecycle = agents?.operationLifecycle ?? {};
const worktreeSnapshots = Array.isArray(operationLifecycle.worktreeSnapshots) ? operationLifecycle.worktreeSnapshots : [];
const stagingMerges = Array.isArray(operationLifecycle.stagingMerges) ? operationLifecycle.stagingMerges : [];
const mergeFailures = Array.isArray(operationLifecycle.mergeFailures) ? operationLifecycle.mergeFailures : [];
const repairTasks = Array.isArray(operationLifecycle.repairTasks) ? operationLifecycle.repairTasks : [];
const releaseResults = Array.isArray(operationLifecycle.releaseResults) ? operationLifecycle.releaseResults : [];
const codexUsage = Array.isArray(operationLifecycle.codexUsage) ? operationLifecycle.codexUsage : [];
const runtimeReports = Array.isArray(agents?.runtimeReports) ? agents.runtimeReports : [];
const docsAutomation = agents?.docsAutomation ?? {};
const taskHealth = agents?.taskHealth ?? {};
const staleTasks = Array.isArray(taskHealth.staleTasks) ? taskHealth.staleTasks : [];
const activeTasks = Array.isArray(taskHealth.activeTasks) ? taskHealth.activeTasks : [];
const workerRunners = Array.isArray(agents?.workerRunners) ? agents.workerRunners : [];
const managerLease = agents?.managerLease ?? null;
const docsMutationArtifacts = generatedArtifacts.filter((item: any) => compact(item.artifactKind, '') === 'docs_mutation_result');
const runtimeWarningValues: string[] = Array.isArray(agents?.runtimeWarnings)
	? agents.runtimeWarnings.filter(Boolean).map(String)
	: [];
const runtimeWarnings = [...new Set(runtimeWarningValues)];
const projectId = compact(agents?.projectId, '');
const promotionDecisionOptions = [
	{ decision: 'approve', label: 'Approve', tone: 'success' },
	{ decision: 'request_changes', label: 'Request changes', tone: 'warning' },
	{ decision: 'defer', label: 'Defer', tone: 'warning' },
	{ decision: 'reject', label: 'Reject', tone: 'danger' },
];
const releaseDecisionOptions = [
	{ decision: 'approve_release', label: 'Approve release', tone: 'success' },
	{ decision: 'reject_release', label: 'Reject release', tone: 'danger' },
];

function compact(value: unknown, fallback = 'none') {
	return typeof value === 'string' && value.trim() ? value.trim() : fallback;
}

function asRecord(value: unknown) {
	return value && typeof value === 'object' && !Array.isArray(value) ? value as Record<string, any> : {};
}

function boolLabel(value: unknown) {
	return value === true ? 'yes' : value === false ? 'no' : 'unknown';
}

function anchorPart(value: unknown) {
	return compact(value, 'item').replace(/[^a-zA-Z0-9_-]+/g, '-');
}

function list(value: unknown) {
	return Array.isArray(value) ? value.filter((entry) => typeof entry === 'string' && entry.trim()).map(String) : [];
}

function jsonSummary(value: unknown) {
	if (!value || typeof value !== 'object') return 'not recorded';
	try {
		const text = JSON.stringify(value);
		return text.length > 180 ? `${text.slice(0, 177)}...` : text;
	} catch {
		return 'not recorded';
	}
}

function artifactTitle(item: any) {
	return compact(item.title, compact(item.draftId, compact(item.reportId, compact(item.id, 'artifact'))));
}

function artifactScore(item: any) {
	const score = Number.isFinite(Number(item.totalScore)) ? String(Number(item.totalScore)) : '';
	return [score, compact(item.recommendation, '')].filter(Boolean).join(' / ') || 'pending';
}

function workdayLabel(workday: any) {
	return workday ? `${compact(workday.state ?? workday.status, 'active')} · ${compact(workday.id ?? workday.workDayId, 'workday')}` : 'No active workday reported';
}

function approvalAction(item: any) {
	const approvalId = compact(item.id, '');
	return projectId && approvalId
		? `/v1/projects/${encodeURIComponent(projectId)}/approvals/${encodeURIComponent(approvalId)}/decision`
		: '#';
}

function approvalDetailHref(item: any) {
	const approvalId = compact(item.id, '');
	return projectId && approvalId
		? `/v1/projects/${encodeURIComponent(projectId)}/approvals/${encodeURIComponent(approvalId)}`
		: '#';
}

function agentAction(slug: string, action: 'run' | 'pause' | 'resume') {
	return projectId && slug
		? `/v1/projects/${encodeURIComponent(projectId)}/agents/${encodeURIComponent(slug)}/${action}`
		: '#';
}

function artifactHref(id: unknown, suffix = '') {
	const artifactId = compact(id, '');
	return projectId && artifactId
		? `/v1/projects/${encodeURIComponent(projectId)}/agent-artifacts/${encodeURIComponent(artifactId)}${suffix}`
		: '#';
}

function approvalForDraft(draft: any) {
	const draftId = compact(draft?.id, '');
	return promotionApprovals.find((approval: any) => compact(approval.draftId, '') === draftId || compact(approval.targetPath, '') === compact(draft?.targetPath, ''));
}

function optimizationForDraft(draft: any) {
	const draftId = compact(draft?.id, '');
	return optimizationReports.map((entry: any) => entry.optimizationReport ?? entry).find((report: any) => compact(report.draftId, '') === draftId);
}

function mutationForDraft(draft: any) {
	const draftId = compact(draft?.id, '');
	const targetPath = compact(draft?.targetPath, '');
	return docsMutationArtifacts.find((artifact: any) => compact(artifact.draftId, '') === draftId || compact(artifact.targetPath, '') === targetPath);
}

function sourceMapEntries(draft: any) {
	const frontmatter = asRecord(draft?.frontmatter);
	return Array.isArray(frontmatter.source_map) ? frontmatter.source_map : [];
}

function sourceRefsForDraft(draft: any) {
	return [...new Set(sourceMapEntries(draft).flatMap((entry: any) => list(entry?.sourceFiles)))];
}

function reviewItemForDraft(entry: any) {
	const draft = entry.knowledgeDraft ?? entry;
	const optimization = optimizationForDraft(draft);
	const approval = approvalForDraft(draft);
	const mutation = mutationForDraft(draft);
	const sourceMapCount = sourceMapEntries(draft).length;
	return {
		id: compact(draft.id, compact(entry.taskId, compact(entry.id, 'draft'))),
		taskId: compact(entry.taskId ?? draft.taskId, ''),
		workDayId: compact(entry.workDayId ?? draft.workDayId, ''),
		draft,
		optimization,
		approval,
		mutation,
		sourceMapCount,
		sourceRefs: sourceRefsForDraft(draft),
	};
}

const reviewItems = knowledgeDrafts.map(reviewItemForDraft);
const draftIds = new Set(reviewItems.map((item: any) => item.id));
for (const artifact of generatedArtifacts.filter((item: any) => compact(item.artifactKind, '') === 'knowledge_draft')) {
	if (!draftIds.has(compact(artifact.id, ''))) {
		reviewItems.push({
			id: compact(artifact.id, compact(artifact.taskId, 'draft-artifact')),
			taskId: compact(artifact.taskId, ''),
			workDayId: compact(artifact.workDayId, ''),
			draft: artifact,
			optimization: null,
			approval: approvalForDraft(artifact),
			mutation: mutationForDraft(artifact),
			sourceMapCount: 0,
			sourceRefs: list(artifact.sourceRefs),
		});
	}
}

const generatedRows = reviewItems.map((item: any) => ({
	title: compact(item.draft.title, artifactTitle(item.draft)),
	target: [compact(item.draft.book, ''), compact(item.draft.section, '')].filter(Boolean).join(' / ') || compact(item.draft.targetPath, 'not assigned'),
	source: [compact(item.draft.sourceQuestionId, ''), ...list(item.draft.sourceResearchIds)].filter(Boolean).join(', ') || 'not linked',
	confidence: compact(asRecord(item.draft.frontmatter).confidence, 'unknown'),
	score: item.optimization ? artifactScore(item.optimization) : 'pending',
	review: compact(item.optimization?.recommendation, compact(item.draft.reviewState, compact(item.draft.state, 'draft'))),
	approval: compact(item.approval?.state, 'not requested'),
	verification: compact(item.mutation?.verificationStatus, item.mutation ? 'recorded' : 'not run'),
	paths: list(item.mutation?.changedPaths).length ? list(item.mutation.changedPaths).join(', ') : compact(item.draft.targetPath, 'none'),
}));

const agentRows = (agents?.agents ?? []).map((agent: any) => ({
	agent: compact(agent.agentSlug ?? agent.slug),
	handler: compact(agent.handler),
	status: compact(agent.status ?? agent.runtimeStatus),
	task: compact(agent.currentTask, 'idle'),
	last: compact(agent.lastRunAt, 'never'),
}));

const agentDetailItems = (agents?.agents ?? []).map((agent: any) => {
	const slug = compact(agent.agentSlug ?? agent.slug, 'agent');
	const taskRefs = operationEvents.filter((event: any) => compact(event.agentRole, '') === compact(agent.handler, '') || compact(event.agentSlug, '') === slug);
	return {
		agent,
		slug,
		detailRows: [
			{ key: 'Handler', value: compact(agent.handler) },
			{ key: 'Runtime status', value: compact(agent.status ?? agent.runtimeStatus) },
			{ key: 'Current task', value: compact(agent.currentTask, 'idle') },
			{ key: 'Last run', value: compact(agent.lastRunAt, 'never') },
			{ key: 'Triggers', value: Array.isArray(agent.triggers) ? `${agent.triggers.length} configured` : compact(agent.triggerSummary, 'not reported') },
			{ key: 'Permissions', value: Array.isArray(agent.permissions) ? `${agent.permissions.length} model rule(s)` : compact(agent.permissionSummary, 'not reported') },
			{ key: 'Governance', value: jsonSummary(agent.governance) },
			{ key: 'Recent outputs', value: String(taskRefs.length) },
		],
	};
});

const operationGrantRows = operationGrants.slice(0, 8).map((item: any) => ({
	id: compact(item.id),
	operations: Array.isArray(item.operations) ? item.operations.join(', ') : 'none',
	role: Array.isArray(item.agentRoles) ? item.agentRoles.join(', ') : 'any',
	paths: Array.isArray(item.allowedPaths) ? item.allowedPaths.join(', ') : 'not scoped',
	task: compact(item.taskId, 'not linked'),
}));

const operationEventRows = operationEvents.slice(0, 12).map((item: any) => ({
	operation: compact(item.operation),
	status: compact(item.status, 'unknown'),
	role: compact(item.agentRole, 'role'),
	paths: Array.isArray(item.changedPaths) ? item.changedPaths.join(', ') : 'none',
	task: compact(item.taskId, 'not linked'),
}));

const runnerRows = workerRunners.map((runner: any) => ({
	runner: compact(runner.runnerId, compact(runner.id, 'runner')),
	state: compact(runner.state, 'unknown'),
	service: compact(runner.runnerServiceName, 'not reported'),
	capacity: `${Number(runner.activeLocalWorkers ?? 0)} / ${Number(runner.maxLocalWorkers ?? 0)}`,
	available: Number(runner.availableCapacity ?? 0),
	heartbeat: compact(runner.lastHeartbeatAt, compact(runner.updatedAt, 'never')),
}));

const staleTaskRows = staleTasks.map((task: any) => ({
	task: compact(task.id, 'task'),
	type: compact(task.type, 'unknown'),
	state: compact(task.state, 'unknown'),
	claimedBy: compact(task.claimedBy ?? task.claimed_by, 'unknown'),
	lease: compact(task.leaseExpiresAt ?? task.lease_expires_at, 'not reported'),
	attempts: `${Number(task.attemptCount ?? task.attempt_count ?? 0)} / ${Number(task.maxAttempts ?? task.max_attempts ?? 0)}`,
}));

const workdayRequestAction = projectId
	? `/v1/projects/${encodeURIComponent(projectId)}/workday-requests`
	: '#';
const workdayEnvironment = compact(managerLease?.environment, compact(currentWorkday?.environment, 'local'));

const timelineItems = [
	currentWorkday ? {
		title: 'Workday opened',
		description: `${compact(currentWorkday.id ?? currentWorkday.workDayId, 'workday')} · ${compact(currentWorkday.updatedAt ?? currentWorkday.updated_at, 'No update timestamp')}`,
		meta: compact(currentWorkday.state ?? currentWorkday.status, 'active'),
		tone: 'info' as const,
	} : null,
	...generatedArtifacts.slice(0, 8).map((item: any) => ({
		title: `Generated ${compact(item.artifactKind, 'artifact').replaceAll('_', ' ')}`,
		description: `${artifactTitle(item)} · ${compact(item.taskId, 'task not linked')}`,
		href: `#artifact-${anchorPart(item.id ?? item.taskId)}`,
		meta: compact(item.taskState, compact(item.recommendation, 'artifact')),
		tone: item.artifactKind === 'docs_mutation_result' && item.verificationStatus === 'failed' ? 'danger' as const : 'info' as const,
	})),
	...promotionApprovals.slice(0, 6).map((item: any) => ({
		title: compact(item.title, 'Promotion approval requested'),
		description: `${compact(item.targetPath, 'No target path')} · ${compact(item.summary, compact(item.recommendation, 'waiting'))}`,
		href: `#approval-${anchorPart(item.id)}`,
		meta: compact(item.state, 'pending'),
		tone: compact(item.state, 'pending') === 'pending' ? 'warning' as const : 'info' as const,
	})),
	...operationEvents.slice(0, 8).map((item: any) => ({
		title: compact(item.operation, 'operation'),
		description: `${compact(item.summary, compact(item.taskId, 'task'))} · ${Array.isArray(item.changedPaths) ? item.changedPaths.length : 0} changed path(s)`,
		href: item.taskId ? `#task-${anchorPart(item.taskId)}` : undefined,
		meta: compact(item.status, 'event'),
		tone: compact(item.status, '') === 'failed' ? 'danger' as const : 'info' as const,
	})),
	...repairTasks.slice(0, 5).map((item: any) => ({
		title: compact(item.kind, 'repair task'),
		description: compact(item.targetPath, compact(item.taskId, 'task')),
		href: item.taskId ? `#task-${anchorPart(item.taskId)}` : undefined,
		meta: 'repair',
		tone: 'warning' as const,
	})),
].filter(Boolean).slice(0, 20);

const lifecycleItems = [
	...worktreeSnapshots.slice(0, 4).map((item: any) => ({
		title: compact(item.summary, compact(item.kind, 'snapshot')),
		description: `${compact(item.taskId, 'task')} · ${Array.isArray(item.changedPaths) ? item.changedPaths.length : 0} changed path(s)`,
		meta: 'snapshot',
	})),
	...mergeFailures.slice(0, 4).map((item: any) => ({
		title: compact(item.message, 'Merge to staging failed'),
		description: Array.isArray(item.conflictedPaths) ? item.conflictedPaths.join(', ') : compact(item.taskId, 'task'),
		meta: 'merge failure',
		tone: 'warning' as const,
	})),
	...repairTasks.slice(0, 4).map((item: any) => ({
		title: compact(item.kind, 'repair task'),
		description: compact(item.targetPath, compact(item.taskId, 'task')),
		meta: 'repair',
		tone: 'warning' as const,
	})),
	...releaseResults.slice(0, 4).map((item: any) => ({
		title: compact(item.summary, compact(item.status, 'release result')),
		description: compact(item.taskId, 'release task'),
		meta: 'release',
		tone: item.status === 'completed' ? 'success' as const : 'warning' as const,
	})),
];

const reportItems = [
	...runtimeReports.map((item: any) => ({
		title: compact(item.kind, 'runtime report'),
		description: `${compact(item.workDayId, 'No workday')} · ${compact(item.createdAt, 'No timestamp')}`,
		meta: compact(item.sentAt, 'recorded'),
	})),
	...(agents?.workdaySummaries ?? []).map((item: any) => ({
		title: compact(item.kind, 'workday summary'),
		description: `${compact(item.environment, 'local')} · ${compact(item.createdAt, 'No timestamp')}`,
		meta: compact(item.state, 'saved'),
	})),
].slice(0, 8);

const messageItems = (agents?.messages ?? []).slice(0, 6).map((message: any) => ({
	title: compact(message.summary, compact(message.type, 'Agent message')),
	description: `${compact(message.agentSlug, 'agent')} · ${compact(message.createdAt, 'No timestamp')}`,
	meta: compact(message.kind, compact(message.status, 'message')),
	tone: message.kind === 'action_requested' ? 'warning' as const : message.kind === 'warning' ? 'danger' as const : 'muted' as const,
}));

const warningItems = runtimeWarnings.map((warning: string) => ({
	title: warning,
	meta: 'runtime',
	tone: 'warning' as const,
}));

const codexTone = codex.ok ? 'success' : codex.providerSelected ? 'warning' : 'muted';
---

<div class="ts-section-grid">
	<Panel eyebrow="Runtime readiness" title={agentReadinessLabel} description={agentReadinessReasons || 'Agent runtime, capacity, and provider signals are summarized here.'}>
		<StatusPill slot="actions" tone={agentReadinessToneValue}>{agentReadinessLabel}</StatusPill>
		<MetricGrid min="8rem" metrics={[
			{ label: 'Remaining today', value: capacitySummary?.dailyRemainingCredits ?? 0 },
			{ label: 'Reserved', value: capacitySummary?.dailyReservedCredits ?? 0 },
			{ label: 'Providers', value: capacitySummary?.activeProviderCount ?? 0 },
			{ label: 'Warnings', value: runtimeWarnings.length },
		]} />
	</Panel>

	<Panel eyebrow="Current workday" title={workdayLabel(currentWorkday)} description={currentWorkday ? compact(currentWorkday.updatedAt ?? currentWorkday.updated_at, 'No update timestamp') : 'Manager and worker services have not reported a current workday.'}>
		<div slot="actions" class="ts-workday-actions">
			<form method="post" action={workdayRequestAction}>
				<input type="hidden" name="environment" value={workdayEnvironment} />
				<input type="hidden" name="type" value="pause" />
				<input type="hidden" name="reason" value="Paused from Project Agents governance surface" />
				<button class="ts-small-action" type="submit">Pause</button>
			</form>
			<form method="post" action={workdayRequestAction}>
				<input type="hidden" name="environment" value={workdayEnvironment} />
				<input type="hidden" name="type" value="retry_open" />
				<input type="hidden" name="reason" value="Resumed from Project Agents governance surface" />
				<button class="ts-small-action" type="submit">Resume</button>
			</form>
		</div>
		<MetricGrid min="8rem" metrics={[
			{ label: 'Generated artifacts', value: generatedArtifacts.length },
			{ label: 'Pending approvals', value: docsAutomation.pendingApprovalCount ?? approvals.length, tone: approvals.length ? 'warning' : 'success' },
			{ label: 'Research notes', value: researchNotes.length },
			{ label: 'Repair tasks', value: repairTasks.length, tone: repairTasks.length ? 'warning' : 'success' },
			{ label: 'Stale tasks', value: docsAutomation.staleTaskCount ?? staleTasks.length, tone: staleTasks.length ? 'danger' : 'success' },
			{ label: 'Worker runners', value: docsAutomation.workerRunnerCount ?? workerRunners.length },
		]} />
	</Panel>

	<Panel eyebrow="Background health" title="Manager lease and worker runners" description="Lease, heartbeat, queue recovery, and retry state are reported by the existing manager and worker runtime.">
		<MetricGrid min="8rem" metrics={[
			{ label: 'Active tasks', value: activeTasks.length },
			{ label: 'Recovered tasks', value: Number(taskHealth.recoveredTaskCount ?? docsAutomation.recoveredTaskCount ?? 0), tone: Number(taskHealth.recoveredTaskCount ?? 0) ? 'warning' : 'success' },
			{ label: 'Failed stale tasks', value: Number(taskHealth.failedStaleTaskCount ?? docsAutomation.failedStaleTaskCount ?? 0), tone: Number(taskHealth.failedStaleTaskCount ?? 0) ? 'danger' : 'success' },
			{ label: 'Backoff cap', value: `${Number(taskHealth.retryBackoffPolicy?.maxSeconds ?? 300)}s` },
		]} />
		<KeyValueList items={[
			{ key: 'Manager lease', value: managerLease ? `${compact(managerLease.managerId, 'manager')} · ${compact(managerLease.state, 'active')}` : 'not reported' },
			{ key: 'Lease heartbeat', value: compact(managerLease?.heartbeatAt, 'not reported') },
			{ key: 'Lease expires', value: compact(managerLease?.expiresAt, 'not reported') },
			{ key: 'Queue policy', value: jsonSummary(docsAutomation.queuePolicy) },
		]} />
		<DataTable
			columns={[
				{ key: 'runner', label: 'Runner' },
				{ key: 'state', label: 'State' },
				{ key: 'service', label: 'Service' },
				{ key: 'capacity', label: 'Active / max' },
				{ key: 'available', label: 'Available' },
				{ key: 'heartbeat', label: 'Last heartbeat' },
			]}
			rows={runnerRows}
			emptyLabel="No worker runner heartbeats have been reported."
		/>
		<DataTable
			columns={[
				{ key: 'task', label: 'Task' },
				{ key: 'type', label: 'Type' },
				{ key: 'state', label: 'State' },
				{ key: 'claimedBy', label: 'Claimed by' },
				{ key: 'lease', label: 'Lease expired' },
				{ key: 'attempts', label: 'Attempts' },
			]}
			rows={staleTaskRows}
			emptyLabel="No stale task leases are visible."
		/>
	</Panel>

	<Panel eyebrow="Execution provider" title="Codex provider" description={`Plan ${compact(codex.subscriptionPlan, 'unknown')} · model ${compact(codex.defaultModel, 'default not set')}`}>
		<StatusPill slot="actions" tone={codexTone}>{codex.ok ? 'Ready' : 'Unavailable'}</StatusPill>
		<MetricGrid min="8rem" metrics={[
			{ label: 'Selected', value: boolLabel(codex.providerSelected) },
			{ label: 'SDK', value: boolLabel(codex.sdkInstalled) },
			{ label: 'Node', value: boolLabel(codex.nodeVersionOk) },
			{ label: 'Auth', value: boolLabel(codex.authDetected) },
		]} />
		<KeyValueList items={[
			{ key: 'Sandbox', value: compact(codex.sandboxMode, compact(codex.sandbox, 'policy controlled')) },
			{ key: 'Approval policy', value: compact(codex.approvalPolicy, compact(codex.approval_policy, 'manual for governed docs')) },
			{ key: 'Allowed mutation paths', value: operationGrants.flatMap((grant: any) => list(grant.allowedPaths)).slice(0, 4).join(', ') || 'Reported per approved task' },
			{ key: 'Forbidden path hints', value: operationGrants.flatMap((grant: any) => list(grant.forbiddenPaths)).slice(0, 4).join(', ') || 'Enforced by task policy' },
		]} />
	</Panel>

	{runtimeWarnings.length ? (
		<Panel eyebrow="Runtime warnings" title="Attention needed" tone="warning">
			<ActionList items={warningItems} />
		</Panel>
	) : null}

	<Panel eyebrow="Workday Timeline" title="Documentation automation activity" description="Workday, artifact, approval, verification, repair, and staging events collected from the existing task and operation stream.">
		<ActionList items={timelineItems as any}>
			<p>No docs automation timeline events have been reported yet.</p>
		</ActionList>
	</Panel>

	<Panel eyebrow="Generated Knowledge Review" title="Drafts, source maps, approvals, and verification" description="Review generated knowledge without leaving the existing Market project agents surface.">
		<DataTable
			columns={[
				{ key: 'title', label: 'Title' },
				{ key: 'target', label: 'Book / section' },
				{ key: 'source', label: 'Source' },
				{ key: 'confidence', label: 'Confidence' },
				{ key: 'score', label: 'Score' },
				{ key: 'review', label: 'Recommendation' },
				{ key: 'approval', label: 'Approval' },
				{ key: 'verification', label: 'Verification' },
				{ key: 'paths', label: 'Changed paths' },
			]}
			rows={generatedRows}
			emptyLabel="No generated agent knowledge drafts have been reported yet."
		/>
		<div class="ts-governance-detail-list">
			{reviewItems.map((item: any) => (
				<details class="ts-governance-detail" id={`artifact-${anchorPart(item.id)}`}>
					<summary>{compact(item.draft.title, artifactTitle(item.draft))}</summary>
					<p class="ts-governance-links">
						<a href={artifactHref(item.id)}>Artifact detail</a>
						<a href={artifactHref(item.id, '/source-map')}>Source map</a>
						<a href={artifactHref(item.mutation?.id ?? item.id, '/diff')}>Diff detail</a>
						{item.approval ? <a href={approvalDetailHref(item.approval)}>Approval detail</a> : null}
					</p>
					<KeyValueList items={[
						{ key: 'Target path', value: compact(item.draft.targetPath, 'not assigned') },
						{ key: 'Review state', value: compact(item.draft.reviewState, compact(item.draft.state, 'draft')) },
						{ key: 'Source map entries', value: String(item.sourceMapCount) },
						{ key: 'Optimization', value: item.optimization ? `${item.optimization.totalScore} · ${compact(item.optimization.recommendation, 'pending')}` : 'not reported' },
						{ key: 'Approval', value: item.approval ? `${compact(item.approval.id)} · ${compact(item.approval.state, 'pending')}` : 'not requested' },
						{ key: 'Verification', value: item.mutation ? compact(item.mutation.verificationStatus, 'recorded') : 'not run' },
						{ key: 'Changed paths', value: list(item.mutation?.changedPaths).join(', ') || compact(item.draft.targetPath, 'none') },
						{ key: 'Source refs', value: item.sourceRefs.slice(0, 8).join(', ') || 'none reported' },
					]} />
					{item.draft.body ? <pre class="ts-governance-pre">{String(item.draft.body).slice(0, 1400)}</pre> : null}
					{item.optimization ? <p class="ts-governance-note">Remaining issues: {list(item.optimization.remainingIssues).join('; ') || 'none'} · Critical issues: {list(item.optimization.criticalIssues).join('; ') || 'none'}</p> : null}
					{item.approval ? <p class="ts-governance-note">Policy snapshot: {jsonSummary(item.approval.policySnapshot)} · Verification plan: {jsonSummary(item.approval.verificationPlan)}</p> : null}
					{item.mutation ? <p class="ts-governance-note">Mutation result: staging {String(item.mutation.mergedToStaging ?? 'unknown')} · repair {compact(item.mutation.repairTaskId, 'none')}</p> : null}
				</details>
			))}
		</div>
	</Panel>

	<Panel eyebrow="Approval Detail" title="Draft promotion requests" description="Approving content starts the gated staging workflow. Production release still requires a separate human release approval.">
		{promotionApprovals.length ? (
			<div class="ts-approval-list">
				{promotionApprovals.map((item: any) => (
					<article class="ts-approval-item" id={`approval-${anchorPart(item.id)}`}>
						<div class="ts-approval-copy">
							<strong>{compact(item.title, compact(item.draftId, compact(item.id, 'Promotion request')))}</strong>
							<span>{compact(item.targetPath, 'No target path')} · score {Number.isFinite(Number(item.totalScore)) ? Number(item.totalScore) : 'pending'} · {compact(item.recommendation, 'waiting')} · source maps {Array.isArray(item.sourceMapRefs) ? item.sourceMapRefs.length : 0}</span>
							<span>Policy {jsonSummary(item.policySnapshot)} · verification {jsonSummary(item.verificationPlan)}</span>
						</div>
						<form class="ts-approval-actions" method="post" action={approvalAction(item)}>
							<input class="ts-approval-reason" type="text" name="reason" placeholder="Optional reason" aria-label={`Reason for ${compact(item.id, 'approval')}`} />
							{promotionDecisionOptions.map((option) => (
								<button class={`ts-approval-button ts-approval-button--${option.tone}`} type="submit" name="decision" value={option.decision}>
									{option.label}
								</button>
							))}
						</form>
					</article>
				))}
			</div>
		) : (
			<p>No generated knowledge is waiting for approval.</p>
		)}
	</Panel>

	<Panel eyebrow="Mutation Diff Viewer" title="Changed paths, verification, and repair" description="Existing mutation outputs are shown as changed paths, snapshots, verification status, staging state, and repair task references.">
		<DataTable
			columns={[
				{ key: 'artifact', label: 'Mutation' },
				{ key: 'target', label: 'Target' },
				{ key: 'paths', label: 'Changed paths' },
				{ key: 'verification', label: 'Verification' },
				{ key: 'staging', label: 'Staging' },
				{ key: 'repair', label: 'Repair' },
			]}
			rows={docsMutationArtifacts.map((item: any) => ({
				artifact: compact(item.id, compact(item.taskId, 'mutation')),
				target: compact(item.targetPath, compact(item.draftId, 'not assigned')),
				paths: list(item.changedPaths).join(', ') || 'none reported',
				verification: compact(item.verificationStatus, 'not reported'),
				staging: item.mergedToStaging === true ? 'merged' : item.mergedToStaging === false ? 'not merged' : 'unknown',
				repair: compact(item.repairTaskId, 'none'),
			}))}
			emptyLabel="No docs mutation results have been reported."
		/>
		<div class="ts-governance-detail-list">
			{docsMutationArtifacts.map((item: any) => (
				<details class="ts-governance-detail" id={`artifact-${anchorPart(item.id ?? item.taskId)}`}>
					<summary>{compact(item.id, compact(item.taskId, 'docs mutation'))}</summary>
					<p class="ts-governance-links">
						<a href={artifactHref(item.id ?? item.taskId)}>Artifact detail</a>
						<a href={artifactHref(item.id ?? item.taskId, '/diff')}>Changed-path diff detail</a>
					</p>
					<KeyValueList items={[
						{ key: 'Target', value: compact(item.targetPath, compact(item.draftId, 'not assigned')) },
						{ key: 'Changed paths', value: list(item.changedPaths).join(', ') || 'none reported' },
						{ key: 'Verification', value: compact(item.verificationStatus, 'not reported') },
						{ key: 'Merged to staging', value: String(item.mergedToStaging ?? 'unknown') },
						{ key: 'Repair task', value: compact(item.repairTaskId, 'none') },
					]} />
				</details>
			))}
		</div>
	</Panel>

	<Panel eyebrow="Operations" title="Grants and task event log" description="Handler-controlled workflow operation permissions and recent operation outcomes.">
		<MetricGrid min="8rem" metrics={[
			{ label: 'Grants', value: operationGrants.length },
			{ label: 'Events', value: operationEvents.length },
			{ label: 'Snapshots', value: worktreeSnapshots.length },
			{ label: 'Merge failures', value: mergeFailures.length, tone: mergeFailures.length ? 'warning' : 'success' },
		]} />
		<DataTable
			columns={[
				{ key: 'id', label: 'Grant' },
				{ key: 'operations', label: 'Operations' },
				{ key: 'role', label: 'Role' },
				{ key: 'paths', label: 'Paths' },
				{ key: 'task', label: 'Task' },
			]}
			rows={operationGrantRows}
			emptyLabel="No operation grants have been reported."
		/>
		<DataTable
			columns={[
				{ key: 'operation', label: 'Operation' },
				{ key: 'status', label: 'Status' },
				{ key: 'role', label: 'Role' },
				{ key: 'paths', label: 'Changed paths' },
				{ key: 'task', label: 'Task' },
			]}
			rows={operationEventRows}
			emptyLabel="No operation events have been reported."
		/>
		<div class="ts-governance-detail-list">
			{operationEvents.slice(0, 8).map((item: any) => (
				<details class="ts-governance-detail" id={item.taskId ? `task-${anchorPart(item.taskId)}` : undefined}>
					<summary>{compact(item.operation, 'operation')} · {compact(item.status, 'event')}</summary>
					<KeyValueList items={[
						{ key: 'Task', value: compact(item.taskId, 'not linked') },
						{ key: 'Workday', value: compact(item.workDayId, 'not linked') },
						{ key: 'Changed paths', value: list(item.changedPaths).join(', ') || 'none reported' },
						{ key: 'Staged paths', value: list(item.stagedPaths).join(', ') || 'none reported' },
						{ key: 'Summary', value: compact(item.summary, 'not reported') },
					]} />
				</details>
			))}
		</div>
	</Panel>

	<Panel eyebrow="Lifecycle" title="Snapshots, repair, and release" description={`Staging merges ${stagingMerges.length} · Codex usage records ${codexUsage.length}`}>
		<ActionList items={lifecycleItems}>
			<p>No worktree snapshots, merge repairs, or release results have been reported.</p>
		</ActionList>
	</Panel>

	<Panel eyebrow="Release approvals" title="Staged knowledge release" description="Release approval is a second explicit human decision after content has merged to staging. Codex and agents cannot release directly.">
		{releaseApprovals.length ? (
			<div class="ts-approval-list">
				{releaseApprovals.map((item: any) => (
					<article class="ts-approval-item" id={`approval-${anchorPart(item.id)}`}>
						<div class="ts-approval-copy">
							<strong>{compact(item.draftId, compact(item.id, 'Release request'))}</strong>
							<span>{compact(item.targetPath, 'No target path')} · staging {compact(item.stagingBranch, 'staging')} · {compact(item.recommendation, 'waiting')}</span>
						</div>
						<form class="ts-approval-actions" method="post" action={approvalAction(item)}>
							<input class="ts-approval-reason" type="text" name="reason" placeholder="Optional reason" aria-label={`Reason for ${compact(item.id, 'approval')}`} />
							{releaseDecisionOptions.map((option) => (
								<button class={`ts-approval-button ts-approval-button--${option.tone}`} type="submit" name="decision" value={option.decision}>
									{option.label}
								</button>
							))}
						</form>
					</article>
				))}
			</div>
		) : (
			<p>No staged knowledge is waiting for release approval.</p>
		)}
	</Panel>

	<Panel eyebrow="Active agents" title="Handler status">
		<DataTable
			columns={[
				{ key: 'agent', label: 'Agent' },
				{ key: 'handler', label: 'Handler' },
				{ key: 'status', label: 'Status' },
				{ key: 'task', label: 'Current task' },
				{ key: 'last', label: 'Last run' },
			]}
			rows={agentRows}
			emptyLabel="No agent runtime status has been reported."
		/>
		<div class="ts-governance-detail-list">
			{agentDetailItems.map((item: any) => (
				<details class="ts-governance-detail" id={`agent-${anchorPart(item.slug)}`}>
					<summary>{item.slug}</summary>
					<div class="ts-agent-actions">
						<form method="post" action={agentAction(item.slug, 'run')}>
							<input type="hidden" name="environment" value={workdayEnvironment} />
							<button class="ts-small-action" type="submit">Run</button>
						</form>
						<form method="post" action={agentAction(item.slug, 'pause')}>
							<input type="hidden" name="environment" value={workdayEnvironment} />
							<button class="ts-small-action" type="submit">Pause</button>
						</form>
						<form method="post" action={agentAction(item.slug, 'resume')}>
							<input type="hidden" name="environment" value={workdayEnvironment} />
							<button class="ts-small-action" type="submit">Resume</button>
						</form>
					</div>
					<KeyValueList items={item.detailRows} />
				</details>
			))}
		</div>
	</Panel>

	<DataTable
		columns={[
			{ key: 'pool', label: 'Pool' },
			{ key: 'environment', label: 'Environment' },
			{ key: 'status', label: 'Status' },
			{ key: 'service', label: 'Service' },
		]}
		rows={(agents?.pools ?? []).map((pool: any) => ({
			pool: compact(pool.name),
			environment: compact(pool.environment),
			status: compact(pool.status),
			service: compact(pool.serviceBaseUrl, 'not registered'),
		}))}
		emptyLabel="No agent pools are registered for this project yet."
	/>

	<Panel eyebrow="Recent messages" title="Agent event stream">
		<ActionList items={messageItems}>
			<p>No agent messages have been recorded yet.</p>
		</ActionList>
	</Panel>

	<div id="workday-report-timeline">
		<Panel eyebrow="Reports" title="Workday report timeline">
			<ActionList items={reportItems}>
				<p>No workday reports are available yet.</p>
			</ActionList>
		</Panel>
	</div>
</div>
