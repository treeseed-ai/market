---
import ActionList from '../../../../packages/core/src/components/ui/data/ActionList.astro';
import KeyValueList from '../../../../packages/core/src/components/ui/data/KeyValueList.astro';
import Panel from '../../../../packages/core/src/components/ui/surface/Panel.astro';
import Field from '../../../../packages/core/src/components/ui/forms/Field.astro';
import TextInput from '../../../../packages/core/src/components/ui/forms/TextInput.astro';
import Textarea from '../../../../packages/core/src/components/ui/forms/Textarea.astro';
import Select from '../../../../packages/core/src/components/ui/forms/Select.astro';
import Button from '../../../../packages/core/src/components/ui/forms/Button.astro';
import FormActions from '../../../../packages/core/src/components/ui/forms/FormActions.astro';

const { summary, settings } = Astro.props as any;
const project = settings?.project ?? summary?.project ?? null;
const team = settings?.team ?? null;
const connection = summary?.connection ?? null;
const hosting = summary?.hosting ?? null;
const seedMetadata = [project?.metadata?.seed, project?.metadata?.metadata?.seed, hosting?.metadata?.seed, connection?.metadata?.seed].find(Boolean) ?? null;
const deletionBlockers = settings?.deletionBlockers ?? [];
const deleteConfirmation = settings?.deleteConfirmation ?? (project?.slug ? `DELETE ${project.slug}` : 'DELETE project');
const teamHandle = team?.name ?? team?.slug ?? '';
const redirectHref = teamHandle ? `/app/teams/${teamHandle}/home` : '/app/';
const currentProjectHref = teamHandle && project?.slug ? `/app/teams/${teamHandle}/projects/${project.slug}/settings` : '';
const blockerLabels: Record<string, string> = {
	active_job: 'Active job',
	active_workday: 'Active workday',
	workday_request: 'Workday request',
	manager_lease: 'Manager lease',
	worker_runner: 'Worker runner',
	capacity_reservation: 'Capacity reservation',
	pending_approval: 'Pending approval',
};
const blockerHelp: Record<string, string> = {
	manager_lease: 'A Workday Manager currently holds this project lock for an environment. Stop the manager or let the lease expire before deleting the project.',
	worker_runner: 'A worker runner is still registered for this project.',
	workday_request: 'A workday request is queued or running for this project.',
	active_job: 'A remote job is queued or running for this project.',
	active_workday: 'A workday is still open for this project.',
	capacity_reservation: 'Credits are still reserved or being consumed for this project.',
	pending_approval: 'A human decision is still pending for this project.',
};
---

<div class="ts-section-grid">
	<Panel eyebrow="Project settings" title="Profile">
		<form class="ts-form-stack" data-project-settings-form data-project-id={project?.id ?? ''} data-team-handle={teamHandle} data-current-project-href={currentProjectHref}>
			<Field label="Project slug" name="slug" help="Used in project URLs. Use lowercase letters, numbers, and single hyphens." required>
				<TextInput name="slug" value={project?.slug ?? ''} required maxlength={80} pattern="[A-Za-z0-9](?:[A-Za-z0-9-]{0,78}[A-Za-z0-9])?" autocomplete="off" />
			</Field>
			<Field label="Project name" name="name" required>
				<TextInput name="name" value={project?.name ?? ''} required />
			</Field>
			<Field label="Description" name="description">
				<Textarea name="description" rows={4} value={project?.description ?? ''} />
			</Field>
			<p class="ts-field__help" data-project-settings-status aria-live="polite"></p>
			<FormActions align="start">
				<Button type="submit" disabled={!project?.id}>Save project settings</Button>
			</FormActions>
		</form>
	</Panel>
	<Panel eyebrow="Runtime" title="Connection and hosting">
		<KeyValueList items={[{ key: 'Connection mode', value: summary?.connection?.mode ?? 'unconfigured' }, { key: 'Execution owner', value: summary?.connection?.executionOwner ?? 'unconfigured' }, { key: 'Hosting kind', value: summary?.hosting?.kind ?? 'unconfigured' }]} />
	</Panel>
	<Panel eyebrow="Advanced runtime" title="Connection">
		<form class="ts-form-grid" data-project-connection-form data-project-id={project?.id ?? ''}>
			<Field label="Connection mode" name="mode" help="Controls whether work is dispatched to a hosted project API, a local/project runner, or both.">
				<Select name="mode" value={connection?.mode ?? 'self_hosted'} options={[
					{ label: 'Hosted project API', value: 'hosted' },
					{ label: 'Hybrid', value: 'hybrid' },
					{ label: 'Self-hosted runner', value: 'self_hosted' },
				]} />
			</Field>
			<Field label="Execution owner" name="executionOwner" help="Selects the runtime that owns agent and workflow execution.">
				<Select name="executionOwner" value={connection?.executionOwner ?? 'project_runner'} options={[
					{ label: 'Project API', value: 'project_api' },
					{ label: 'Project runner', value: 'project_runner' },
				]} />
			</Field>
			<Field label="Project API base URL" name="projectApiBaseUrl" full help="Required only when dispatching to a hosted project API.">
				<TextInput name="projectApiBaseUrl" type="url" value={connection?.projectApiBaseUrl ?? ''} placeholder="https://api.example.com" />
			</Field>
			<label class="ts-list-item ts-field ts-field--full">
				<span class="ts-field__label">Rotate runner token</span>
				<input type="checkbox" name="rotateRunnerToken" value="true" />
				<span class="ts-field__help">Creates a new one-time project runner token. Existing runners must be updated after rotation.</span>
			</label>
			<p class="ts-field__help ts-field--full" data-project-connection-status aria-live="polite"></p>
			<FormActions align="start">
				<Button type="submit" disabled={!project?.id}>Save connection</Button>
			</FormActions>
		</form>
	</Panel>
	<Panel eyebrow="Advanced runtime" title="Hosting">
		<form class="ts-form-grid" data-project-hosting-form data-project-id={project?.id ?? ''}>
			<Field label="Hosting kind" name="kind" help="Describes where the project surface is hosted.">
				<Select name="kind" value={hosting?.kind ?? 'self_hosted_project'} options={[
					{ label: 'Hosted project', value: 'hosted_project' },
					{ label: 'Self-hosted project', value: 'self_hosted_project' },
				]} />
			</Field>
			<Field label="Registration" name="registration" help="Controls whether this project is expected to register runtime connectivity.">
				<Select name="registration" value={hosting?.registration ?? 'none'} options={[
					{ label: 'None', value: 'none' },
					{ label: 'Optional', value: 'optional' },
					{ label: 'Required', value: 'required' },
				]} />
			</Field>
			<Field label="Market base URL" name="marketBaseUrl" full help="Market API/web URL associated with this hosted project, when applicable.">
				<TextInput name="marketBaseUrl" type="url" value={hosting?.marketBaseUrl ?? ''} placeholder="https://api.treeseed.ai" />
			</Field>
			<Field label="Source repo owner" name="sourceRepoOwner">
				<TextInput name="sourceRepoOwner" value={hosting?.sourceRepoOwner ?? ''} />
			</Field>
			<Field label="Source repo name" name="sourceRepoName">
				<TextInput name="sourceRepoName" value={hosting?.sourceRepoName ?? ''} />
			</Field>
			<Field label="Source repo URL" name="sourceRepoUrl" full>
				<TextInput name="sourceRepoUrl" type="url" value={hosting?.sourceRepoUrl ?? ''} />
			</Field>
			<Field label="Source workflow path" name="sourceRepoWorkflowPath" full>
				<TextInput name="sourceRepoWorkflowPath" value={hosting?.sourceRepoWorkflowPath ?? ''} placeholder=".github/workflows/deploy.yml" />
			</Field>
			<p class="ts-field__help ts-field--full" data-project-hosting-status aria-live="polite"></p>
			<FormActions align="start">
				<Button type="submit" disabled={!project?.id}>Save hosting</Button>
			</FormActions>
		</form>
	</Panel>
	<Panel eyebrow="Advanced metadata" title="Seed ownership">
		<KeyValueList items={seedMetadata ? [
			{ key: 'Seed', value: seedMetadata.name ?? 'unknown' },
			{ key: 'Resource key', value: seedMetadata.resourceKey ?? 'unknown' },
			{ key: 'Version', value: String(seedMetadata.version ?? 'unknown') },
			{ key: 'Last applied', value: seedMetadata.lastAppliedAt ?? 'not applied' },
			{ key: 'Manifest hash', value: seedMetadata.manifestHash ?? 'not recorded' },
		] : [{ key: 'Seed', value: 'No seed ownership metadata recorded' }]} />
	</Panel>
	<Panel eyebrow="Environments" title="Configured surfaces">
		<ActionList items={(summary?.environments ?? []).map((environment: any) => ({ title: environment.environment, description: environment.deploymentProfile }))} />
	</Panel>
	<Panel eyebrow="Danger zone" title="Delete project" tone="danger">
		{deletionBlockers.length > 0 ? (
			<div class="ts-list">
				{deletionBlockers.map((blocker: any) => (
					<div class="ts-list-item">
						<strong>{blockerLabels[blocker.code] ?? blocker.label ?? blocker.code}</strong>
						<span>{blocker.label ?? ''}</span>
						<span class="ts-field__help">{blockerHelp[blocker.code] ?? String(blocker.code ?? 'blocked').replaceAll('_', ' ')}</span>
					</div>
				))}
			</div>
		) : (
			<form class="ts-form-stack" data-project-delete-form data-project-id={project?.id ?? ''} data-redirect-href={redirectHref}>
				<p class="ts-field__help">Deleting this project removes its repository links, work policies, capacity grants, run history, inbox items, and catalog project listing. Active workdays, pending jobs, reservations, and approvals block deletion.</p>
				<Field label="Confirmation text" name="confirmation" help={`Type ${deleteConfirmation} to confirm.`}>
					<TextInput name="confirmation" autocomplete="off" />
				</Field>
				<p class="ts-field__help" data-project-delete-status aria-live="polite"></p>
				<FormActions align="start">
					<Button variant="danger" type="submit" disabled={!project?.id}>Delete project</Button>
				</FormActions>
			</form>
		)}
	</Panel>
</div>

<script>
	for (const form of document.querySelectorAll<HTMLFormElement>('[data-project-settings-form]')) {
		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const projectId = form.dataset.projectId ?? '';
			const teamHandle = form.dataset.teamHandle ?? '';
			const currentHref = form.dataset.currentProjectHref || window.location.pathname;
			const status = form.querySelector<HTMLElement>('[data-project-settings-status]');
			const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
			const data = new FormData(form);
			const slug = String(data.get('slug') ?? '').trim().toLowerCase();
			const name = String(data.get('name') ?? '').trim();
			const description = String(data.get('description') ?? '').trim();
			if (!projectId) return;
			button?.setAttribute('disabled', 'true');
			if (status) status.textContent = 'Saving project settings...';
			try {
				const response = await fetch(`/v1/projects/${encodeURIComponent(projectId)}`, {
					method: 'PUT',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ slug, name, description }),
				});
				const payload = await response.json().catch(() => ({}));
				if (!response.ok || payload?.ok === false) {
					if (status) status.textContent = payload?.message ?? payload?.error ?? 'Project settings could not be saved.';
					button?.removeAttribute('disabled');
					return;
				}
				const nextSlug = payload?.payload?.project?.slug ?? slug;
				const nextHref = teamHandle && nextSlug ? `/app/teams/${teamHandle}/projects/${nextSlug}/settings?settings=updated` : currentHref;
				window.location.assign(nextHref);
			} catch (error) {
				if (status) status.textContent = error instanceof Error ? error.message : 'Project settings could not be saved.';
				button?.removeAttribute('disabled');
			}
		});
	}

	for (const form of document.querySelectorAll<HTMLFormElement>('[data-project-connection-form]')) {
		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const projectId = form.dataset.projectId ?? '';
			const status = form.querySelector<HTMLElement>('[data-project-connection-status]');
			const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
			const data = new FormData(form);
			if (!projectId) return;
			button?.setAttribute('disabled', 'true');
			if (status) status.textContent = 'Saving connection...';
			try {
				const response = await fetch(`/v1/projects/${encodeURIComponent(projectId)}/connection`, {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({
						mode: String(data.get('mode') ?? ''),
						executionOwner: String(data.get('executionOwner') ?? ''),
						projectApiBaseUrl: String(data.get('projectApiBaseUrl') ?? '').trim(),
						rotateRunnerToken: data.get('rotateRunnerToken') === 'true',
					}),
				});
				const payload = await response.json().catch(() => ({}));
				if (!response.ok || payload?.ok === false) {
					if (status) status.textContent = payload?.error ?? 'Connection settings could not be saved.';
					button?.removeAttribute('disabled');
					return;
				}
				if (status) status.textContent = payload?.payload?.runnerToken ? `Connection saved. New runner token: ${payload.payload.runnerToken}` : 'Connection saved.';
				button?.removeAttribute('disabled');
			} catch (error) {
				if (status) status.textContent = error instanceof Error ? error.message : 'Connection settings could not be saved.';
				button?.removeAttribute('disabled');
			}
		});
	}

	for (const form of document.querySelectorAll<HTMLFormElement>('[data-project-hosting-form]')) {
		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const projectId = form.dataset.projectId ?? '';
			const status = form.querySelector<HTMLElement>('[data-project-hosting-status]');
			const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
			const data = new FormData(form);
			if (!projectId) return;
			button?.setAttribute('disabled', 'true');
			if (status) status.textContent = 'Saving hosting...';
			try {
				const response = await fetch(`/v1/projects/${encodeURIComponent(projectId)}/hosting`, {
					method: 'PUT',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({
						kind: String(data.get('kind') ?? ''),
						registration: String(data.get('registration') ?? ''),
						marketBaseUrl: String(data.get('marketBaseUrl') ?? '').trim(),
						sourceRepoOwner: String(data.get('sourceRepoOwner') ?? '').trim(),
						sourceRepoName: String(data.get('sourceRepoName') ?? '').trim(),
						sourceRepoUrl: String(data.get('sourceRepoUrl') ?? '').trim(),
						sourceRepoWorkflowPath: String(data.get('sourceRepoWorkflowPath') ?? '').trim(),
					}),
				});
				const payload = await response.json().catch(() => ({}));
				if (!response.ok || payload?.ok === false) {
					if (status) status.textContent = payload?.error ?? 'Hosting settings could not be saved.';
					button?.removeAttribute('disabled');
					return;
				}
				if (status) status.textContent = 'Hosting saved.';
				button?.removeAttribute('disabled');
			} catch (error) {
				if (status) status.textContent = error instanceof Error ? error.message : 'Hosting settings could not be saved.';
				button?.removeAttribute('disabled');
			}
		});
	}

	for (const form of document.querySelectorAll<HTMLFormElement>('[data-project-delete-form]')) {
		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const projectId = form.dataset.projectId ?? '';
			const redirectHref = form.dataset.redirectHref || '/app/';
			const status = form.querySelector<HTMLElement>('[data-project-delete-status]');
			const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
			const data = new FormData(form);
			const confirmation = String(data.get('confirmation') ?? '');
			if (!projectId) return;
			button?.setAttribute('disabled', 'true');
			if (status) status.textContent = 'Deleting project...';
			try {
				const response = await fetch(`/v1/projects/${encodeURIComponent(projectId)}`, {
					method: 'DELETE',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ confirmation }),
				});
				const payload = await response.json().catch(() => ({}));
				if (!response.ok || payload?.ok === false) {
					if (status) status.textContent = payload?.message ?? 'Project deletion failed.';
					button?.removeAttribute('disabled');
					return;
				}
				window.location.assign(redirectHref);
			} catch (error) {
				if (status) status.textContent = error instanceof Error ? error.message : 'Project deletion failed.';
				button?.removeAttribute('disabled');
			}
		});
	}
</script>
