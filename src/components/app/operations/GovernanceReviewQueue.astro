---
import Badge from '../../../../packages/core/src/components/ui/data/Badge.astro';
import Panel from '../../../../packages/core/src/components/ui/surface/Panel.astro';

interface Props {
	title?: string;
	description?: string;
	items?: any[];
	empty?: string;
}

const {
	title = 'Review queue',
	description = 'Operational decisions waiting for deliberate human review.',
	items = [],
	empty = 'No approvals are waiting.',
} = Astro.props as Props;
---

<Panel eyebrow="Governance" title={title} description={description}>
	<div class="ts-governance-queue">
		{items.length > 0 ? items.map((item) => (
			<article class="ts-governance-queue__item" id={`approval-${item.approvalId ?? item.id}`} aria-label={`${item.severity ?? 'moderate'} severity review: ${item.title}`}>
				<div class="ts-governance-queue__severity" data-severity={item.severity ?? 'moderate'} aria-hidden="true"></div>
				<div class="ts-governance-queue__body">
					<div class="ts-governance-queue__header">
						<div>
							<p>{item.projectName ?? 'Organization'}</p>
							<h3><a href={item.href}>{item.title}</a></h3>
						</div>
						<Badge tone={item.tone ?? 'default'} size="sm">{item.severity ?? item.state}</Badge>
					</div>
					<p>{item.description}</p>
					<div class="ts-operational-timeline__meta">
						<span>{item.state ?? 'pending'}</span>
						{item.workDayId ? <a href={`/app/workdays/${encodeURIComponent(item.workDayId)}`}>Workday {item.workDayId}</a> : null}
						{item.requestedAt ? <span>{item.requestedAt}</span> : null}
					</div>
				</div>
			</article>
		)) : <p class="ts-empty-inline">{empty}</p>}
	</div>
</Panel>
