---
import ActionList from '../../../../packages/core/src/components/ui/data/ActionList.astro';
import Panel from '../../../../packages/core/src/components/ui/surface/Panel.astro';

interface Props {
	title?: string;
	description?: string;
	items?: any[];
	empty?: string;
}

const {
	title = 'Governance',
	description = 'Operational review items requiring traceable human attention.',
	items = [],
	empty = 'No governance items are waiting.',
} = Astro.props as Props;
---

<Panel eyebrow="Governance" title={title} description={description}>
	<ActionList items={items.map((item) => ({
		title: item.title,
		description: item.description,
		href: item.href,
		meta: item.meta ?? item.state,
		tone: item.tone ?? 'default',
		actionLabel: item.href ? 'Open' : undefined,
	}))}>
		<p class="ts-empty-inline">{empty}</p>
	</ActionList>
</Panel>
