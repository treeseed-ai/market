---
import Badge from '../../../../packages/core/src/components/ui/data/Badge.astro';
import type { Tone } from '../../../../packages/core/src/components/ui/types.ts';

interface Props {
	sections: Array<{
		label: string;
		href: string;
		count: number;
		state?: string;
		tone?: Tone;
		description?: string;
	}>;
}

const { sections } = Astro.props as Props;
---

<nav class="ts-infra-status-grid" aria-label="Infrastructure sections">
	{sections.map((section) => (
		<a class="ts-infra-status-grid__item" href={section.href}>
			<span>
				<strong>{section.label}</strong>
				{section.description ? <small>{section.description}</small> : null}
			</span>
			<span class="ts-infra-status-grid__meta">
				<Badge tone={section.tone ?? 'muted'} size="sm">{section.state ?? `${section.count}`}</Badge>
			</span>
		</a>
	))}
</nav>
