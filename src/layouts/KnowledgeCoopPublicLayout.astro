---
import '../styles/knowledge-coop.css';

interface NavItem {
	label: string;
	href: string;
}

interface Props {
	title?: string;
	description?: string;
	currentPath?: string;
}

const {
	title = 'Knowledge Coop',
	description = 'Launch, guide, release, and publish knowledge hubs with your team and your agents.',
	currentPath = '/',
} = Astro.props as Props;

const navItems: NavItem[] = [
	{ label: 'Home', href: '/' },
	{ label: 'Market', href: '/market/' },
	{ label: 'Templates', href: '/market/templates/' },
	{ label: 'Knowledge Packs', href: '/market/knowledge-packs/' },
];

const isSignedIn = Boolean(Astro.locals.auth?.principal);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<div class="kc-page">
			<div class="kc-public-shell">
				<header class="kc-public-header">
					<a class="kc-brand" href="/">
						<span class="kc-brand__mark">KC</span>
						<span class="kc-brand__text">
							<span class="kc-brand__name">Knowledge Coop</span>
							<span class="kc-brand__tag">The GitHub of knowledge and agent teams</span>
						</span>
					</a>
					<nav class="kc-public-nav" aria-label="Primary">
						{navItems.map((item) => (
							<a class="kc-nav-link" href={item.href} aria-current={currentPath.startsWith(item.href) && item.href !== '/' || currentPath === item.href ? 'page' : undefined}>
								{item.label}
							</a>
						))}
					</nav>
					<div class="kc-user-actions">
						{isSignedIn ? (
							<a class="kc-button-secondary" href="/app/">Open app</a>
						) : (
							<>
								<a class="kc-action-link" href="/auth/sign-in?provider=github">Sign in</a>
								<a class="kc-button" href="/auth/sign-in?provider=github">Launch your coop</a>
							</>
						)}
					</div>
				</header>
				<slot />
			</div>
		</div>
	</body>
</html>
