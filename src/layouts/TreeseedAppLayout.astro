---
import '../styles/treeseed.css';
import AppShell from '../../packages/core/src/components/ui/shell/AppShell.astro';
import SensitiveDataUnlock from '../components/app/sensitive/SensitiveDataUnlock.astro';
import { resolveAuthenticatedThemePreference } from '../lib/auth/appearance';

interface TeamEntry {
	id: string;
	name: string;
	slug?: string;
	displayName?: string | null;
}

interface Props {
	title: string;
	description?: string;
	currentPath: string;
	teams: TeamEntry[];
	activeTeam?: TeamEntry | null;
}

const {
	title,
	description = 'Coordinate objectives, workdays, governance, knowledge, and infrastructure from one operational control plane.',
	currentPath,
	teams,
	activeTeam = null,
} = Astro.props as Props;

const railItems = [
	{ label: 'Mission Control', href: '/app/' },
	{ label: 'Workdays', href: '/app/workdays' },
	{ label: 'Governance', href: '/app/governance' },
	{ label: 'Knowledge', href: '/app/knowledge' },
	{ label: 'Infrastructure', href: '/app/infrastructure' },
];

const appearance = await resolveAuthenticatedThemePreference(Astro);
const quickActions = [
	{ label: 'New objective', href: '/app/launch', variant: 'primary' as const },
	{ label: 'Account', href: '/app/account', variant: 'secondary' as const },
	{ label: 'Sign out', href: '/auth/sign-out', variant: 'secondary' as const },
];
---

<AppShell
	title={title}
	description={description}
	currentPath={currentPath}
	appearance={appearance}
	brand={{
		name: 'TreeSeed Platform',
		tag: 'Governable AI Infrastructure for Organizational Continuity',
		href: '/app/',
		logoSrc: '/logo.svg',
		logoAlt: '',
	}}
	navItems={railItems}
	quickActions={quickActions}
>
	<div slot="railContext" class="ts-team-switcher">
		<div class="ts-section__eyebrow">Operational context</div>
		{teams.length > 0 ? (
			<div class="ts-team-selector">
				<select aria-label="Active organization" onchange="if (this.value) window.location.href = this.value;">
					{teams.map((team) => (
						<option value="/app/infrastructure#teams" selected={activeTeam?.id === team.id}>
							{team.displayName ?? team.name}
						</option>
					))}
				</select>
				<a class="ts-icon-button" href="/app/infrastructure#teams" title="Inspect organization" aria-label="Inspect organization">Open</a>
			</div>
		) : (
			<a class="ts-create-team-button" href="/app/infrastructure#teams">Open infrastructure</a>
		)}
	</div>
	<SensitiveDataUnlock part="button" slot="headerAction" />
	<slot />
	<SensitiveDataUnlock part="modal" slot="sensitiveModal" />
</AppShell>
