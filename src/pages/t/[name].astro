---
import KnowledgeCoopPublicLayout from '../../layouts/KnowledgeCoopPublicLayout.astro';
import { normalizeTeamName, validateTeamName } from '../../api/store.js';
import { resolveMarketStore } from '../../lib/market/store.js';

export const prerender = false;

const requestedName = String(Astro.params.name ?? '');
const normalizedName = normalizeTeamName(requestedName);
if (requestedName !== normalizedName && validateTeamName(normalizedName).ok) {
	return Astro.redirect(`/t/${normalizedName}`, 301);
}

const store = resolveMarketStore(Astro.locals);
const profile = store ? await (store as any).loadTeamProfileByName(normalizedName, Astro.locals.auth?.principal ?? null) : null;
if (!profile) {
	return new Response('Not found', { status: 404 });
}

const team = profile.team;
const displayName = team.displayName ?? team.name;
const joinedDate = new Date(team.createdAt).toLocaleDateString('en', { month: 'long', year: 'numeric' });
const visibleCount = profile.activity.projects.length + profile.activity.catalogItems.length + profile.activity.knowledgePacks.length;
---

<KnowledgeCoopPublicLayout
	title={`${displayName} (@${team.name}) | Knowledge Coop`}
	description={team.profileSummary ?? `Public Knowledge Coop profile for @${team.name}.`}
	currentPath={`/t/${team.name}`}
>
	<main class="kc-section">
		<section class="kc-user-profile">
			<div class="kc-user-profile__avatar" aria-hidden="true">
				{team.logoUrl ? <img src={team.logoUrl} alt="" loading="lazy" /> : <span>{displayName.slice(0, 1).toUpperCase()}</span>}
			</div>
			<div>
				<p class="kc-section__eyebrow">Team profile</p>
				<h1>{displayName}</h1>
				<p class="kc-user-profile__handle">@{team.name}</p>
				<p class="kc-user-profile__meta">Created {joinedDate}</p>
				{team.profileSummary ? <p>{team.profileSummary}</p> : null}
			</div>
		</section>

		<section class="kc-grid-2 kc-profile-activity" aria-label="Team activity">
			<div class="kc-panel">
				<div class="kc-panel__header">
					<h2>Projects</h2>
					<span class="kc-badge">{profile.activity.projects.length}</span>
				</div>
				<div class="kc-list">
					{profile.activity.projects.length > 0 ? profile.activity.projects.map((project: any) => (
						<div class="kc-list-item">
							<strong>{project.name}</strong><br />
							<span>{project.description || project.slug}</span>
						</div>
					)) : <p>No visible projects.</p>}
				</div>
			</div>

			<div class="kc-panel">
				<div class="kc-panel__header">
					<h2>Catalog listings</h2>
					<span class="kc-badge">{profile.activity.catalogItems.length}</span>
				</div>
				<div class="kc-list">
					{profile.activity.catalogItems.length > 0 ? profile.activity.catalogItems.map((item: any) => (
						<a class="kc-list-item" href={`/market/${item.kind === 'knowledge_pack' ? 'knowledge-packs' : 'templates'}/${item.slug}`}>
							<strong>{item.title}</strong><br />
							<span>{item.summary || item.kind}</span>
						</a>
					)) : <p>No visible listings.</p>}
				</div>
			</div>

			<div class="kc-panel">
				<div class="kc-panel__header">
					<h2>Knowledge packs</h2>
					<span class="kc-badge">{profile.activity.knowledgePacks.length}</span>
				</div>
				<div class="kc-list">
					{profile.activity.knowledgePacks.length > 0 ? profile.activity.knowledgePacks.map((pack: any) => (
						<a class="kc-list-item" href={`/market/knowledge-packs/${pack.slug}`}>
							<strong>{pack.name}</strong><br />
							<span>{pack.summary || pack.visibility}</span>
						</a>
					)) : <p>No visible knowledge packs.</p>}
				</div>
			</div>
		</section>
		{visibleCount === 0 ? <p class="kc-muted">No team activity is visible to you yet.</p> : null}
	</main>
	<style>
		.kc-user-profile {
			display: grid;
			grid-template-columns: auto 1fr;
			align-items: center;
			gap: 1rem;
			margin-bottom: 1.5rem;
		}
		.kc-user-profile__avatar {
			width: 5rem;
			height: 5rem;
			border-radius: 8px;
			overflow: hidden;
			display: grid;
			place-items: center;
			background: #204c3f;
			color: #fff;
			font-weight: 900;
			font-size: 2rem;
		}
		.kc-user-profile__avatar img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
	</style>
</KnowledgeCoopPublicLayout>
