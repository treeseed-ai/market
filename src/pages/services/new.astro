---
import TreeseedOperationalMarketLayout from '@treeseed/admin/layouts/TreeseedOperationalMarketLayout.astro';
import SettingsTemplate from '@treeseed/ui/components/astro/templates/SettingsTemplate.astro';
import Panel from '@treeseed/ui/components/astro/surface/Panel.astro';
import '@treeseed/ui/styles/commerce.css';
import { loadServiceRequestFormPage, submitServiceRequest } from '../../lib/market-public-view-models';

let actionError: string | undefined;

if (Astro.request.method === 'POST') {
	const result = await submitServiceRequest(Astro, await Astro.request.formData());
	if (result.ok) return Astro.redirect(`/services/${encodeURIComponent(String(result.payload.id))}`, 303);
	actionError = result.error;
}

const page = loadServiceRequestFormPage(Astro, actionError);
---

<TreeseedOperationalMarketLayout title={page.title} description={page.description} currentPath={Astro.url.pathname} helpContext={page.helpContext} feedbackContext={page.feedbackContext}>
	<main class="ts-commerce-page">
		<SettingsTemplate title={page.title} description={page.description} actions={page.actions}>
			<div class="ts-commerce-two-column">
				<form class="ts-commerce-panel ts-commerce-form" method="post">
					<p class="ts-commerce-eyebrow">Request</p>
					<h2>Scope request</h2>
					{actionError ? <p class="ts-commerce-error">{actionError}</p> : null}
					<label class="ts-commerce-field"><span>Offer ID</span><input name="offerId" value={page.data.offerId} required autocomplete="off" /></label>
					<label class="ts-commerce-field"><span>Requested scope</span><textarea name="requestedScope" required></textarea></label>
					<label class="ts-commerce-field"><span>Access needs</span><textarea name="accessNeeds"></textarea></label>
					<label class="ts-commerce-field"><span>Related project ID</span><input name="relatedProjectId" autocomplete="off" /></label>
					<label class="ts-commerce-field"><span>Related workday ID</span><input name="relatedWorkdayId" autocomplete="off" /></label>
					<button class="ts-commerce-button" type="submit">Create request</button>
				</form>
				<Panel title="Governed flow">
					<ul class="ts-commerce-timeline">
						<li><span>The seller scopes the request and creates immutable quote versions.</span></li>
						<li><span>Buyer and vendor approvals are separate governance steps.</span></li>
						<li><span>Checkout becomes available only after an accepted quote creates a pending contract.</span></li>
					</ul>
				</Panel>
			</div>
		</SettingsTemplate>
	</main>
</TreeseedOperationalMarketLayout>
