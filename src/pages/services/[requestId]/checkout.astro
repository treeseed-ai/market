---
import TreeseedPublicLayout from '@treeseed/admin/layouts/TreeseedPublicLayout.astro';

const requestId = Astro.params.requestId ?? '';
---

<TreeseedPublicLayout title="Service checkout" description="Confirm an approved scoped service contract." currentPath={Astro.url.pathname}>
	<main class="service-checkout-shell" data-request-id={requestId}>
		<section class="checkout-header">
			<p class="eyebrow">Scoped Service Checkout</p>
			<h1>Confirm the accepted quote</h1>
			<p class="lede">The contract amount comes from the approved TreeSeed quote. Stripe confirms the seller payment, while TreeSeed records the order, entitlement, service contract, and ownership snapshot.</p>
		</section>
		<section class="checkout-grid">
			<div class="checkout-panel">
				<div class="panel-title">
					<h2>Contract payment</h2>
					<button type="button" id="start-service-checkout">Create checkout</button>
				</div>
				<div id="service-payment" class="group-list" aria-live="polite">Ready to create checkout.</div>
			</div>
			<div class="checkout-panel">
				<h2>Contract state</h2>
				<div id="service-contract">Loading request...</div>
			</div>
		</section>
	</main>
</TreeseedPublicLayout>

<script is:inline src="https://js.stripe.com/v3/" async></script>
<script>
	// @ts-nocheck
	const shell = document.querySelector('.service-checkout-shell');
	const requestId = shell?.dataset.requestId;
	const paymentEl = document.querySelector('#service-payment');
	const contractEl = document.querySelector('#service-contract');
	const startButton = document.querySelector('#start-service-checkout');
	let stripeConfig = null;
	let currentCheckout = null;

	async function api(path, options = {}) {
		const response = await fetch(path, {
			...options,
			headers: {
				'content-type': 'application/json',
				...(options.headers ?? {}),
			},
		});
		const payload = await response.json().catch(() => null);
		if (!response.ok || !payload?.ok) throw new Error(payload?.error ?? `Request failed: ${response.status}`);
		return payload.payload;
	}

	async function loadStripeConfig() {
		if (stripeConfig) return stripeConfig;
		stripeConfig = await api('/v1/commerce/stripe/config');
		return stripeConfig;
	}

	function renderContract(request, contract) {
		contractEl.innerHTML = `
			<article class="state-row">
				<strong>${contract?.status || request.status}</strong>
				<span>${request.buyerVisibleSummary || request.requestedScope}</span>
				<small>${contract?.id || 'No contract'}</small>
			</article>
		`;
	}

	function renderGroups(groups) {
		if (!groups?.length) {
			paymentEl.textContent = 'No payment group returned.';
			return;
		}
		paymentEl.innerHTML = groups.map((group) => `
			<article class="group-row" data-group-id="${group.id}">
				<div>
					<strong>${group.groupKind}</strong>
					<span>${group.currency.toUpperCase()} ${(group.totalAmount / 100).toFixed(2)}</span>
					<small>${group.status}</small>
				</div>
				${group.status === 'succeeded' ? '<span class="pill">Confirmed</span>' : `<button type="button" data-confirm="${group.id}">${group.clientSecret ? 'Confirm' : 'Refresh'}</button>`}
			</article>
		`).join('');
		for (const button of paymentEl.querySelectorAll('[data-confirm]')) {
			button.addEventListener('click', () => confirmGroup(groups.find((group) => group.id === button.dataset.confirm)));
		}
	}

	async function loadRequest() {
		try {
			const request = await api(`/v1/commerce/services/requests/${encodeURIComponent(requestId)}`);
			const contract = request.contractId ? await api(`/v1/commerce/services/contracts/${encodeURIComponent(request.contractId)}`) : null;
			renderContract(request, contract);
			return { request, contract };
		} catch (error) {
			contractEl.textContent = error instanceof Error ? error.message : 'Service contract could not be loaded.';
			return null;
		}
	}

	async function startCheckout() {
		try {
			const state = await loadRequest();
			if (!state?.contract?.id) throw new Error('No accepted service contract is ready for checkout.');
			currentCheckout = await api(`/v1/commerce/services/contracts/${encodeURIComponent(state.contract.id)}/checkout`, { method: 'POST', body: '{}' });
			renderGroups(currentCheckout.paymentGroups ?? []);
		} catch (error) {
			paymentEl.textContent = error instanceof Error ? error.message : 'Checkout could not be created.';
		}
	}

	async function confirmGroup(group) {
		if (!group) return;
		try {
			const config = await loadStripeConfig();
			const stripeFactory = window.Stripe;
			if (!stripeFactory) throw new Error('Stripe.js is still loading.');
			const stripe = stripeFactory(config.publishableKey, group.connectedAccountId ? { stripeAccount: group.connectedAccountId } : undefined);
			const result = await stripe.confirmPayment({
				clientSecret: group.clientSecret,
				confirmParams: { return_url: window.location.href },
				redirect: 'if_required',
			});
			if (result.error) throw new Error(result.error.message ?? 'Stripe confirmation failed.');
			await api(`/v1/commerce/payment-groups/${encodeURIComponent(group.id)}/refresh`, { method: 'POST', body: '{}' });
			await loadRequest();
		} catch (error) {
			paymentEl.insertAdjacentHTML('afterbegin', `<p class="error">${error instanceof Error ? error.message : 'Payment confirmation failed.'}</p>`);
		}
	}

	startButton?.addEventListener('click', startCheckout);
	loadRequest();
</script>

<style>
	.service-checkout-shell {
		min-height: 76vh;
		background: #f6f1e8;
		color: #17251f;
	}
	.checkout-header,
	.checkout-grid {
		width: min(1120px, calc(100% - 32px));
		margin: 0 auto;
	}
	.checkout-header {
		padding: 56px 0 28px;
	}
	.eyebrow {
		margin: 0 0 10px;
		color: #7a5c2e;
		font-size: 0.76rem;
		font-weight: 800;
		letter-spacing: 0;
		text-transform: uppercase;
	}
	h1 {
		max-width: 820px;
		margin: 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(2.35rem, 6vw, 4.8rem);
		line-height: 0.98;
		font-weight: 500;
	}
	.lede {
		max-width: 760px;
		margin: 18px 0 0;
		color: #4e5b52;
		line-height: 1.6;
	}
	.checkout-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
		gap: 16px;
		padding-bottom: 56px;
	}
	.checkout-panel {
		border: 1px solid #d4cbb9;
		background: #fffaf0;
		padding: 18px;
	}
	.panel-title,
	.group-row,
	.state-row {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		align-items: center;
	}
	.group-row,
	.state-row {
		border: 1px solid #e2d9c9;
		background: #fffdf8;
		padding: 14px;
		margin-bottom: 10px;
	}
	strong,
	span,
	small {
		display: block;
		overflow-wrap: anywhere;
	}
	small {
		color: #6b735f;
	}
	button,
	.pill {
		border: 0;
		background: #24493d;
		color: #fffdf8;
		padding: 10px 14px;
		font-weight: 800;
		cursor: pointer;
	}
	@media (max-width: 760px) {
		.checkout-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
