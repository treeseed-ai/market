---
import TreeseedOperationalMarketLayout from '@treeseed/admin/layouts/TreeseedOperationalMarketLayout.astro';
import DetailTemplate from '@treeseed/ui/components/astro/templates/DetailTemplate.astro';
import CommercePaymentGroupPanel from '@treeseed/ui/components/astro/commerce/CommercePaymentGroupPanel.astro';
import Panel from '@treeseed/ui/components/astro/surface/Panel.astro';
import '@treeseed/ui/styles/commerce.css';
import { label, loadServiceCheckoutPage, money, startServiceContractCheckout } from '../../../lib/market-public-view-models';

const requestId = Astro.params.requestId ?? '';
let actionError: string | undefined;
let checkoutPayload: any | null = null;

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const contractId = String(form.get('contractId') ?? '').trim();
	const result = await startServiceContractCheckout(Astro, contractId);
	if (result.ok) checkoutPayload = result.payload;
	else actionError = result.error;
}

const page = await loadServiceCheckoutPage(Astro, requestId, actionError);
const groups: any[] = checkoutPayload?.paymentGroups ?? page.data.groups;
---

<TreeseedOperationalMarketLayout title={page.title} description={page.description} currentPath={Astro.url.pathname} helpContext={page.helpContext} feedbackContext={page.feedbackContext}>
	<main class="ts-commerce-page">
		<DetailTemplate title="Confirm the accepted quote" description={page.description} eyebrow="Scoped service checkout" metadata={page.data.metadata} actions={page.actions}>
			{page.data.error ? <p class="ts-commerce-error">{page.data.error}</p> : null}
			<div class="ts-commerce-two-column" data-commerce-checkout data-service-request-id={requestId}>
				<CommercePaymentGroupPanel title="Contract payment">
					{!groups.length ? (
						<form method="post" class="ts-commerce-form">
							<input type="hidden" name="contractId" value={page.data.contract?.id ?? ''} />
							<button class="ts-commerce-button" type="submit" disabled={!page.data.contract?.id}>Create checkout</button>
						</form>
					) : (
						<div class="ts-commerce-grid" data-commerce-payment-groups>
							{groups.map((group) => (
								<article class="ts-commerce-card" data-payment-group-id={group.id}>
									<div class="ts-commerce-panel-header">
										<div>
											<p class="ts-commerce-eyebrow">{label(group.groupKind, 'payment group')}</p>
											<h3>{money(group.totalAmount, group.currency)}</h3>
										</div>
										<span class="ts-status-pill" data-tone={group.status === 'succeeded' ? 'success' : 'muted'}>{label(group.status, 'pending')}</span>
									</div>
									{group.status === 'succeeded'
										? <span class="ts-commerce-muted">Confirmed</span>
										: <button type="button" class="ts-commerce-button" data-confirm-payment-group={group.id}>Confirm securely</button>}
								</article>
							))}
						</div>
					)}
				</CommercePaymentGroupPanel>
				<Panel title="Contract state">
					<p>{page.data.request?.buyerVisibleSummary ?? page.data.request?.requestedScope ?? 'Service contract unavailable.'}</p>
					<dl class="ts-commerce-kv">
						<div><dt>Status</dt><dd>{label(page.data.contract?.status ?? page.data.request?.status, 'pending')}</dd></div>
						<div><dt>Contract</dt><dd>{label(page.data.contract?.id, 'not ready')}</dd></div>
					</dl>
				</Panel>
			</div>
		</DetailTemplate>
	</main>
	<script is:inline src="https://js.stripe.com/v3/" async></script>
	<script src="../../../scripts/commerce-checkout.ts"></script>
</TreeseedOperationalMarketLayout>
