---
import TreeseedPublicLayout from '@treeseed/admin/layouts/TreeseedPublicLayout.astro';

const requestId = Astro.params.requestId ?? '';
---

<TreeseedPublicLayout title="Service request" description="Review scoped service quotes and contract state." currentPath={Astro.url.pathname}>
	<main class="service-shell" data-request-id={requestId}>
		<section class="service-header">
			<p class="eyebrow">Scoped Service</p>
			<h1>Review request and quotes</h1>
			<p class="lede">TreeSeed tracks scope, approval, contract, fulfillment, and cooperative ownership evidence. Seller-private notes and internal evidence stay out of buyer views.</p>
		</section>
		<section class="service-grid">
			<div class="service-panel">
				<div class="panel-title">
					<h2>Request</h2>
					<button type="button" id="refresh-service">Refresh</button>
				</div>
				<div id="service-request" aria-live="polite">Loading request...</div>
			</div>
			<div class="service-panel">
				<h2>Quotes</h2>
				<div id="service-quotes">Waiting for quotes.</div>
			</div>
			<div class="service-panel wide">
				<h2>Timeline</h2>
				<div id="service-events">No events loaded.</div>
			</div>
		</section>
	</main>
</TreeseedPublicLayout>

<script>
	// @ts-nocheck
	const shell = document.querySelector('.service-shell');
	const requestId = shell?.dataset.requestId;
	const requestEl = document.querySelector('#service-request');
	const quotesEl = document.querySelector('#service-quotes');
	const eventsEl = document.querySelector('#service-events');
	const refreshButton = document.querySelector('#refresh-service');

	async function api(path, options = {}) {
		const response = await fetch(path, {
			...options,
			headers: {
				'content-type': 'application/json',
				...(options.headers ?? {}),
			},
		});
		const payload = await response.json().catch(() => null);
		if (!response.ok || !payload?.ok) throw new Error(payload?.error ?? `Request failed: ${response.status}`);
		return payload.payload;
	}

	function money(amount, currency) {
		return `${String(currency || 'usd').toUpperCase()} ${(Number(amount || 0) / 100).toFixed(2)}`;
	}

	async function approveQuote(quoteId) {
		await api(`/v1/commerce/services/quotes/${encodeURIComponent(quoteId)}/buyer-approve`, { method: 'POST', body: '{}' });
		await loadService();
	}

	async function rejectQuote(quoteId) {
		await api(`/v1/commerce/services/quotes/${encodeURIComponent(quoteId)}/reject`, { method: 'POST', body: '{}' });
		await loadService();
	}

	function renderRequest(request) {
		requestEl.innerHTML = `
			<article class="service-row">
				<strong>${request.status}</strong>
				<span>${request.buyerVisibleSummary || request.requestedScope}</span>
				<small>Product ${request.productId}</small>
				${request.contractId ? `<a class="button-link" href="/services/${encodeURIComponent(request.id)}/checkout">Open contract checkout</a>` : ''}
			</article>
		`;
	}

	function renderQuotes(quotes) {
		if (!quotes.length) {
			quotesEl.textContent = 'No quotes yet.';
			return;
		}
		quotesEl.innerHTML = quotes.map((quote) => `
			<article class="service-row">
				<strong>${quote.title}</strong>
				<span>${money(quote.amount, quote.currency)}</span>
				<small>v${quote.quoteVersion} · ${quote.status}</small>
				${quote.status === 'submitted' ? `<div class="inline-actions"><button type="button" data-approve="${quote.id}">Approve quote</button><button type="button" data-reject="${quote.id}">Reject</button></div>` : ''}
			</article>
		`).join('');
		for (const button of quotesEl.querySelectorAll('[data-approve]')) {
			button.addEventListener('click', () => approveQuote(button.dataset.approve));
		}
		for (const button of quotesEl.querySelectorAll('[data-reject]')) {
			button.addEventListener('click', () => rejectQuote(button.dataset.reject));
		}
	}

	function renderEvents(events) {
		if (!events.length) {
			eventsEl.textContent = 'No events yet.';
			return;
		}
		eventsEl.innerHTML = events.map((event) => `
			<article class="event-row">
				<strong>${event.eventType}</strong>
				<span>${event.nextState || ''}</span>
				<small>${event.createdAt || ''}</small>
			</article>
		`).join('');
	}

	async function loadService() {
		try {
			const request = await api(`/v1/commerce/services/requests/${encodeURIComponent(requestId)}`);
			const quotes = await api(`/v1/commerce/services/requests/${encodeURIComponent(requestId)}/quotes`);
			const events = await api(`/v1/commerce/services/events?requestId=${encodeURIComponent(requestId)}`);
			renderRequest(request);
			renderQuotes(quotes);
			renderEvents(events);
		} catch (error) {
			requestEl.textContent = error instanceof Error ? error.message : 'Service request could not be loaded.';
		}
	}

	refreshButton?.addEventListener('click', loadService);
	loadService();
</script>

<style>
	.service-shell {
		min-height: 76vh;
		background: #f7f4ed;
		color: #1d2521;
	}
	.service-header,
	.service-grid {
		width: min(1120px, calc(100% - 32px));
		margin: 0 auto;
	}
	.service-header {
		padding: 56px 0 28px;
	}
	.eyebrow {
		margin: 0 0 10px;
		color: #6c673e;
		font-size: 0.76rem;
		font-weight: 800;
		letter-spacing: 0;
		text-transform: uppercase;
	}
	h1 {
		max-width: 820px;
		margin: 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(2.35rem, 6vw, 4.8rem);
		line-height: 0.98;
		font-weight: 500;
	}
	.lede {
		max-width: 760px;
		margin: 18px 0 0;
		color: #4e5b52;
		line-height: 1.6;
	}
	.service-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
		padding-bottom: 56px;
	}
	.service-panel {
		border: 1px solid #d4cbb9;
		background: #fffaf0;
		padding: 18px;
	}
	.service-panel.wide {
		grid-column: 1 / -1;
	}
	.panel-title,
	.inline-actions,
	.event-row,
	.service-row {
		display: flex;
		gap: 12px;
	}
	.panel-title,
	.event-row,
	.service-row {
		justify-content: space-between;
		align-items: center;
	}
	.service-row,
	.event-row {
		border: 1px solid #e2d9c9;
		background: #fffdf8;
		padding: 14px;
		margin-bottom: 10px;
	}
	strong,
	span,
	small {
		display: block;
		overflow-wrap: anywhere;
	}
	small {
		color: #6b735f;
	}
	button,
	.button-link {
		border: 0;
		background: #254b3f;
		color: #fffdf8;
		padding: 10px 14px;
		font-weight: 800;
		text-decoration: none;
		cursor: pointer;
	}
	@media (max-width: 760px) {
		.service-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
