---
import TreeseedOperationalMarketLayout from '@treeseed/admin/layouts/TreeseedOperationalMarketLayout.astro';
import DetailTemplate from '@treeseed/ui/components/astro/templates/DetailTemplate.astro';
import Panel from '@treeseed/ui/components/astro/surface/Panel.astro';
import ServiceQuotePanel from '@treeseed/ui/components/astro/commerce/ServiceQuotePanel.astro';
import ServiceRequestTimeline from '@treeseed/ui/components/astro/commerce/ServiceRequestTimeline.astro';
import '@treeseed/ui/styles/commerce.css';
import { label, loadServiceRequestPage, money, submitServiceQuoteDecision } from '../../lib/market-public-view-models';

const requestId = Astro.params.requestId ?? '';
let actionError: string | undefined;

if (Astro.request.method === 'POST') {
	const result = await submitServiceQuoteDecision(Astro, await Astro.request.formData());
	if (result.ok) return Astro.redirect(Astro.url.pathname, 303);
	actionError = result.error;
}

const page = await loadServiceRequestPage(Astro, requestId, actionError);
const request = page.data.request;
---

<TreeseedOperationalMarketLayout title={page.title} description={page.description} currentPath={Astro.url.pathname} helpContext={page.helpContext} feedbackContext={page.feedbackContext}>
	<main class="ts-commerce-page">
		<DetailTemplate title="Review request and quotes" description={page.description} eyebrow="Scoped service" metadata={page.data.metadata} actions={page.actions}>
			{page.data.error ? <p class="ts-commerce-error">{page.data.error}</p> : null}
			<div class="ts-commerce-two-column">
				<Panel title="Request">
					<p>{request?.buyerVisibleSummary ?? request?.requestedScope ?? 'Service request unavailable.'}</p>
					<dl class="ts-commerce-kv">
						<div><dt>Status</dt><dd>{label(request?.status, 'requested')}</dd></div>
						<div><dt>Product</dt><dd>{label(request?.productId, 'not linked')}</dd></div>
						<div><dt>Contract</dt><dd>{label(request?.contractId, 'not ready')}</dd></div>
					</dl>
				</Panel>
				<ServiceQuotePanel>
					{page.data.quotes.length ? page.data.quotes.map((quote) => (
						<article class="ts-commerce-card">
							<div class="ts-commerce-panel-header">
								<div>
									<p class="ts-commerce-eyebrow">v{quote.quoteVersion} · {label(quote.status, 'draft')}</p>
									<h3>{quote.title}</h3>
								</div>
								<span class="ts-status-pill" data-tone="muted">{money(quote.amount, quote.currency)}</span>
							</div>
							{quote.status === 'submitted' ? (
								<form class="ts-commerce-actions" method="post">
									<input type="hidden" name="quoteId" value={quote.id} />
									<button class="ts-commerce-button" type="submit" name="decision" value="approve">Approve quote</button>
									<button class="ts-commerce-button" data-variant="secondary" type="submit" name="decision" value="reject">Reject</button>
								</form>
							) : null}
						</article>
					)) : <p class="ts-commerce-muted">No quotes yet.</p>}
				</ServiceQuotePanel>
			</div>
			<ServiceRequestTimeline events={page.data.events} />
		</DetailTemplate>
	</main>
</TreeseedOperationalMarketLayout>
