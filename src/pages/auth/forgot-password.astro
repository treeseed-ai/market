---
import { getSiteAuthConfig } from '../../lib/auth/config';
import { authEmailConfigurationMessage, canDeliverAuthEmail } from '../../lib/auth/email';
import { normalizeReturnTo, redirectAuthenticatedToApp } from '../../lib/auth/flow';
import { requestPasswordResetEmail } from '../../lib/auth/password-reset';

export const prerender = false;

const authenticatedRedirect = redirectAuthenticatedToApp(Astro);
if (authenticatedRedirect) {
	return authenticatedRedirect;
}

const returnTo = normalizeReturnTo(Astro);
let error = '';

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const email = String(form.get('email') ?? '').trim();
	if (!email) {
		error = 'Email is required.';
	} else if (!canDeliverAuthEmail(Astro)) {
		error = authEmailConfigurationMessage();
	} else {
		const config = getSiteAuthConfig(Astro);
		const redirectTo = new URL('/auth/reset-password', config.siteBaseUrl);
		redirectTo.searchParams.set('returnTo', returnTo);
		const result = await requestPasswordResetEmail(Astro, {
			email,
			redirectTo: redirectTo.href,
		});
		if (result.ok) {
			return Astro.redirect(`/auth/check-email?kind=reset&email=${encodeURIComponent(email)}&returnTo=${encodeURIComponent(returnTo)}`, 303);
		}
		error = result.error;
	}
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Forgot Password | Knowledge Coop</title>
		<style>
			:root {
				color-scheme: light;
				font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				background: #f6f7f2;
				color: #17211b;
			}
			body {
				margin: 0;
				min-height: 100vh;
				display: grid;
				place-items: center;
				padding: 2rem;
			}
			main {
				width: min(100%, 460px);
				background: #ffffff;
				border: 1px solid #d9ded4;
				border-radius: 8px;
				box-shadow: 0 18px 40px rgba(19, 31, 22, 0.08);
				padding: 2rem;
			}
			h1 {
				margin: 0 0 0.5rem;
				font-size: 1.65rem;
				letter-spacing: 0;
			}
			p {
				margin: 0 0 1.25rem;
				color: #516052;
				line-height: 1.5;
			}
			form {
				display: grid;
				gap: 0.9rem;
			}
			label {
				display: grid;
				gap: 0.35rem;
				font-size: 0.9rem;
				font-weight: 700;
			}
			input {
				width: 100%;
				box-sizing: border-box;
				border: 1px solid #c9d1c4;
				border-radius: 6px;
				padding: 0.78rem 0.85rem;
				font: inherit;
			}
			button {
				min-height: 2.75rem;
				border-radius: 6px;
				border: 1px solid #17211b;
				background: #17211b;
				color: #fff;
				font: inherit;
				font-weight: 800;
				cursor: pointer;
			}
			.auth-error {
				background: #fff2f0;
				border: 1px solid #f0b8b0;
				color: #8a1f11;
				border-radius: 6px;
				padding: 0.75rem;
				margin-bottom: 1rem;
			}
			.auth-footer {
				margin-top: 1rem;
				font-size: 0.92rem;
			}
			.auth-footer a {
				color: #204c3f;
				font-weight: 800;
			}
		</style>
	</head>
	<body>
		<main>
			<h1>Reset password</h1>
			<p>Enter your account email and we will send a reset link.</p>
			{error ? <div class="auth-error" role="alert">{error}</div> : null}
			<form method="POST" action={`/auth/forgot-password?returnTo=${encodeURIComponent(returnTo)}`}>
				<label>
					Email
					<input name="email" type="email" autocomplete="email" required />
				</label>
				<button type="submit">Send reset link</button>
			</form>
			<p class="auth-footer">
				<a href={`/auth/sign-in?returnTo=${encodeURIComponent(returnTo)}`}>Back to sign in</a>
			</p>
		</main>
	</body>
</html>
