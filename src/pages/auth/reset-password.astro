---
import { createSiteBetterAuth, ensureBetterAuthD1Schema } from '../../lib/auth/better-auth';
import { getSiteAuthConfig } from '../../lib/auth/config';
import { normalizeReturnTo, redirectAuthenticatedToApp } from '../../lib/auth/flow';
import { PASSWORD_RULE_DEFINITIONS, passwordMeetsPolicy, passwordPolicyMessage } from '../../lib/auth/password-policy';

export const prerender = false;

const authenticatedRedirect = redirectAuthenticatedToApp(Astro);
if (authenticatedRedirect) {
	return authenticatedRedirect;
}

const returnTo = normalizeReturnTo(Astro);
const passwordRules = PASSWORD_RULE_DEFINITIONS.map((rule) => ({ id: rule.id, label: rule.label }));
let token = Astro.url.searchParams.get('token') ?? '';
let error = Astro.url.searchParams.get('error') ? 'This password reset link is invalid or expired.' : '';

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	token = String(form.get('token') ?? '').trim();
	const password = String(form.get('password') ?? '');
	const confirmPassword = String(form.get('confirmPassword') ?? '');
	if (!token) {
		error = 'This password reset link is invalid or expired.';
	} else if (!password || !confirmPassword) {
		error = 'Password and password confirmation are required.';
	} else if (password !== confirmPassword) {
		error = 'Passwords do not match.';
	} else if (!passwordMeetsPolicy(password)) {
		error = passwordPolicyMessage();
	} else {
		await ensureBetterAuthD1Schema(Astro);
		const config = getSiteAuthConfig(Astro);
		const auth = createSiteBetterAuth(Astro);
		const headers = new Headers(Astro.request.headers);
		headers.delete('content-length');
		headers.set('content-type', 'application/json');
		headers.set('accept', 'application/json');
		const response = await auth.handler(new Request(`${config.betterAuthBaseUrl}/reset-password`, {
			method: 'POST',
			headers,
			body: JSON.stringify({
				token,
				newPassword: password,
			}),
		}));
		if (response.ok) {
			return Astro.redirect(`/auth/sign-in?reset=complete&returnTo=${encodeURIComponent(returnTo)}`, 303);
		}
		const payload = await response.json().catch(() => null) as { message?: string; error?: string } | null;
		error = payload?.message ?? payload?.error ?? 'Unable to reset password.';
	}
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Reset Password | Knowledge Coop</title>
		<style>
			:root {
				color-scheme: light;
				font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				background: #f6f7f2;
				color: #17211b;
			}
			body {
				margin: 0;
				min-height: 100vh;
				display: grid;
				place-items: center;
				padding: 2rem;
			}
			main {
				width: min(100%, 460px);
				background: #ffffff;
				border: 1px solid #d9ded4;
				border-radius: 8px;
				box-shadow: 0 18px 40px rgba(19, 31, 22, 0.08);
				padding: 2rem;
			}
			h1 {
				margin: 0 0 0.5rem;
				font-size: 1.65rem;
				letter-spacing: 0;
			}
			p {
				margin: 0 0 1.25rem;
				color: #516052;
				line-height: 1.5;
			}
			form {
				display: grid;
				gap: 0.9rem;
			}
			label {
				display: grid;
				gap: 0.35rem;
				font-size: 0.9rem;
				font-weight: 700;
			}
			input {
				width: 100%;
				box-sizing: border-box;
				border: 1px solid #c9d1c4;
				border-radius: 6px;
				padding: 0.78rem 0.85rem;
				font: inherit;
			}
			button {
				min-height: 2.75rem;
				border-radius: 6px;
				border: 1px solid #17211b;
				background: #17211b;
				color: #fff;
				font: inherit;
				font-weight: 800;
				cursor: pointer;
			}
			.auth-error {
				background: #fff2f0;
				border: 1px solid #f0b8b0;
				color: #8a1f11;
				border-radius: 6px;
				padding: 0.75rem;
				margin-bottom: 1rem;
			}
			.password-meter {
				display: grid;
				gap: 0.55rem;
				margin-top: -0.15rem;
				border: 1px solid #d9ded4;
				border-radius: 6px;
				padding: 0.75rem;
				background: #fbfcf9;
			}
			.password-meter__bar {
				height: 0.45rem;
				border-radius: 999px;
				background: #e5e9df;
				overflow: hidden;
			}
			.password-meter__fill {
				display: block;
				height: 100%;
				width: 0%;
				background: #a42c20;
				transition: width 160ms ease, background-color 160ms ease;
			}
			.password-meter__label {
				margin: 0;
				font-size: 0.86rem;
				font-weight: 800;
				color: #516052;
			}
			.password-rules {
				display: grid;
				gap: 0.35rem;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.password-rules li {
				color: #9d2f20;
				font-size: 0.86rem;
				font-weight: 700;
			}
			.password-rules li[data-met="true"] {
				color: #1d7a42;
			}
			.auth-footer {
				margin-top: 1rem;
				font-size: 0.92rem;
			}
			.auth-footer a {
				color: #204c3f;
				font-weight: 800;
			}
		</style>
	</head>
	<body>
		<main>
			<h1>Choose a new password</h1>
			<p>Set a strong password for your internal Treeseed Market login.</p>
			{error ? <div class="auth-error" role="alert">{error}</div> : null}
			<form method="POST" action={`/auth/reset-password?returnTo=${encodeURIComponent(returnTo)}`}>
				<input type="hidden" name="token" value={token} />
				<label>
					New password
					<input data-password-input name="password" type="password" autocomplete="new-password" required minlength="12" />
				</label>
				<label>
					Confirm new password
					<input name="confirmPassword" type="password" autocomplete="new-password" required minlength="12" />
				</label>
				<div class="password-meter" aria-live="polite">
					<div class="password-meter__bar" aria-hidden="true">
						<span data-password-fill class="password-meter__fill"></span>
					</div>
					<p data-password-label class="password-meter__label">Too weak</p>
					<ul class="password-rules">
						{passwordRules.map((rule) => <li data-password-rule={rule.id} data-met="false">{rule.label}</li>)}
					</ul>
				</div>
				<button type="submit">Reset password</button>
			</form>
			<p class="auth-footer">
				<a href={`/auth/sign-in?returnTo=${encodeURIComponent(returnTo)}`}>Back to sign in</a>
			</p>
		</main>
		<script is:inline define:vars={{ passwordRules }}>
			const input = document.querySelector('[data-password-input]');
			const fill = document.querySelector('[data-password-fill]');
			const label = document.querySelector('[data-password-label]');
			const tests = {
				length: (value) => value.length >= 12,
				lowercase: (value) => /[a-z]/.test(value),
				uppercase: (value) => /[A-Z]/.test(value),
				number: (value) => /\d/.test(value),
				symbol: (value) => /[^A-Za-z0-9\s]/.test(value),
				spaces: (value) => value.length > 0 && !/\s/.test(value),
			};
			function updatePasswordMeter() {
				const value = input?.value ?? '';
				let score = 0;
				for (const rule of passwordRules) {
					const met = Boolean(tests[rule.id]?.(value));
					if (met) score += 1;
					document.querySelector(`[data-password-rule="${rule.id}"]`)?.setAttribute('data-met', String(met));
				}
				const total = passwordRules.length;
				const percent = total > 0 ? Math.round((score / total) * 100) : 0;
				if (fill) {
					fill.style.width = `${percent}%`;
					fill.style.backgroundColor = score === total ? '#1d7a42' : score >= 4 ? '#9a6700' : '#a42c20';
				}
				if (label) {
					label.textContent = score === total ? 'Strong' : score >= 4 ? 'Almost there' : score >= 2 ? 'Weak' : 'Too weak';
				}
			}
			input?.addEventListener('input', updatePasswordMeter);
			updatePasswordMeter();
		</script>
	</body>
</html>
