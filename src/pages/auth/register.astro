---
import { authProviderCapabilities, normalizeReturnTo, redirectAuthenticatedToApp, submitBetterAuthEmailFlow } from '../../lib/auth/flow';
import { getSiteAuthConfig } from '../../lib/auth/config';
import { authEmailConfigurationMessage, canDeliverAuthEmail } from '../../lib/auth/email';
import { composeDisplayNameFromParts, isUsernameAvailable, normalizeUsername, validateUsername } from '../../lib/auth/account';
import { PASSWORD_RULE_DEFINITIONS, passwordMeetsPolicy, passwordPolicyMessage } from '../../lib/auth/password-policy';

export const prerender = false;

const authenticatedRedirect = redirectAuthenticatedToApp(Astro);
if (authenticatedRedirect) {
	return authenticatedRedirect;
}

const returnTo = normalizeReturnTo(Astro);
const capabilities = authProviderCapabilities(Astro);
const passwordRules = PASSWORD_RULE_DEFINITIONS.map((rule) => ({ id: rule.id, label: rule.label }));
let error = Astro.url.searchParams.get('error') ?? '';

if (!capabilities.internal.signupEnabled) {
	return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(returnTo)}&error=${encodeURIComponent('Registration is not open in this environment.')}`, 302);
}

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const firstName = String(form.get('firstName') ?? '').trim();
	const lastName = String(form.get('lastName') ?? '').trim();
	const name = composeDisplayNameFromParts(firstName, lastName);
	const username = normalizeUsername(String(form.get('username') ?? ''));
	const email = String(form.get('email') ?? '').trim();
	const password = String(form.get('password') ?? '');
	const confirmPassword = String(form.get('confirmPassword') ?? '');
	const usernameValidation = validateUsername(username);
	if (!firstName || !lastName || !username || !email || !password || !confirmPassword) {
		error = 'First name, last name, username, email, password, and password confirmation are required.';
	} else if (!usernameValidation.ok) {
		error = usernameValidation.message;
	} else if (password !== confirmPassword) {
		error = 'Passwords do not match.';
	} else if (!passwordMeetsPolicy(password)) {
		error = passwordPolicyMessage();
	} else if (!canDeliverAuthEmail(Astro)) {
		error = authEmailConfigurationMessage();
	} else if (!(await isUsernameAvailable(Astro, usernameValidation.username))) {
		error = 'That username is already taken.';
	} else {
		const config = getSiteAuthConfig(Astro);
		const callbackURL = new URL('/auth/verified', config.betterAuthBaseUrl);
		callbackURL.searchParams.set('returnTo', returnTo);
		const result = await submitBetterAuthEmailFlow(Astro, 'sign-up/email', {
			name,
			firstName,
			lastName,
			username: usernameValidation.username,
			email,
			password,
			rememberMe: true,
			callbackURL: callbackURL.href,
		}, { finalize: false });
		if (result.ok) {
			return Astro.redirect(`/auth/check-email?kind=verify&email=${encodeURIComponent(email)}&returnTo=${encodeURIComponent(returnTo)}`, 303);
		}
		error = result.error;
	}
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Create Account | Knowledge Coop</title>
		<style>
			:root {
				color-scheme: light;
				font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				background: #f6f7f2;
				color: #17211b;
			}
			body {
				margin: 0;
				min-height: 100vh;
				display: grid;
				place-items: center;
				padding: 2rem;
			}
			main {
				width: min(100%, 460px);
				background: #fff;
				border: 1px solid #d9ded4;
				border-radius: 8px;
				box-shadow: 0 18px 40px rgba(19, 31, 22, 0.08);
				padding: 2rem;
			}
			h1 {
				margin: 0 0 0.5rem;
				font-size: 1.65rem;
				letter-spacing: 0;
			}
			p {
				margin: 0 0 1.25rem;
				color: #516052;
				line-height: 1.5;
			}
			form {
				display: grid;
				gap: 0.9rem;
			}
			.name-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 0.75rem;
			}
			label {
				display: grid;
				gap: 0.35rem;
				font-size: 0.9rem;
				font-weight: 700;
			}
			input {
				width: 100%;
				box-sizing: border-box;
				border: 1px solid #c9d1c4;
				border-radius: 6px;
				padding: 0.78rem 0.85rem;
				font: inherit;
			}
			button {
				min-height: 2.75rem;
				border-radius: 6px;
				border: 1px solid #17211b;
				background: #17211b;
				color: #fff;
				font: inherit;
				font-weight: 800;
				cursor: pointer;
			}
			.auth-error {
				background: #fff2f0;
				border: 1px solid #f0b8b0;
				color: #8a1f11;
				border-radius: 6px;
				padding: 0.75rem;
				margin-bottom: 1rem;
			}
			.password-meter {
				display: grid;
				gap: 0.55rem;
				margin-top: -0.15rem;
				border: 1px solid #d9ded4;
				border-radius: 6px;
				padding: 0.75rem;
				background: #fbfcf9;
			}
			.password-meter[hidden] {
				display: none;
			}
			.password-meter__bar {
				height: 0.45rem;
				border-radius: 999px;
				background: #e5e9df;
				overflow: hidden;
			}
			.password-meter__fill {
				display: block;
				height: 100%;
				width: 0%;
				background: #a42c20;
				transition: width 160ms ease, background-color 160ms ease;
			}
			.password-meter__label {
				margin: 0;
				font-size: 0.86rem;
				font-weight: 800;
				color: #516052;
			}
			.password-rules {
				display: grid;
				gap: 0.35rem;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.password-rules li {
				color: #9d2f20;
				font-size: 0.86rem;
				font-weight: 700;
			}
			.password-rules li[data-met="true"] {
				color: #1d7a42;
			}
			input[data-match-state="match"] {
				border: 2px solid #1d7a42;
				padding: calc(0.78rem - 1px) calc(0.85rem - 1px);
			}
			input[data-match-state="mismatch"] {
				border: 2px solid #9d2f20;
				padding: calc(0.78rem - 1px) calc(0.85rem - 1px);
			}
			input[data-username-state="available"] {
				border: 2px solid #1d7a42;
				padding: calc(0.78rem - 1px) calc(0.85rem - 1px);
			}
			input[data-username-state="taken"],
			input[data-username-state="invalid"],
			input[data-username-state="reserved"],
			input[data-username-state="error"] {
				border: 2px solid #9d2f20;
				padding: calc(0.78rem - 1px) calc(0.85rem - 1px);
			}
			.auth-footer {
				margin-top: 1rem;
				font-size: 0.92rem;
			}
			.auth-footer a {
				color: #204c3f;
				font-weight: 800;
			}
			.field-help {
				color: #667266;
				font-size: 0.82rem;
				font-weight: 600;
			}
			.field-help[data-tone="success"] {
				color: #1d7a42;
			}
			.field-help[data-tone="danger"] {
				color: #9d2f20;
			}
			@media (max-width: 560px) {
				.name-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<main>
			<h1>Create account</h1>
			<p>Create an internal login for the market control plane.</p>
			{error ? <div class="auth-error" role="alert">{error}</div> : null}
			<form method="POST" action={`/auth/register?returnTo=${encodeURIComponent(returnTo)}`}>
				<div class="name-grid">
					<label>
						First name
						<input name="firstName" type="text" autocomplete="given-name" required />
					</label>
					<label>
						Last name
						<input name="lastName" type="text" autocomplete="family-name" required />
					</label>
				</div>
				<label>
					Username
					<input data-username-input name="username" type="text" autocomplete="username" required minlength="1" maxlength="39" pattern="[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?" aria-describedby="username-status" />
					<span id="username-status" data-username-status class="field-help">Username is public and cannot be changed after registration.</span>
				</label>
				<label>
					Email
					<input name="email" type="email" autocomplete="email" required />
				</label>
				<label>
					Password
					<input data-password-input name="password" type="password" autocomplete="new-password" required minlength="12" />
				</label>
				<label>
					Confirm password
					<input data-confirm-password-input name="confirmPassword" type="password" autocomplete="new-password" required minlength="12" />
				</label>
				<div data-password-meter class="password-meter" aria-live="polite" hidden>
					<div class="password-meter__bar" aria-hidden="true">
						<span data-password-fill class="password-meter__fill"></span>
					</div>
					<p data-password-label class="password-meter__label">Too weak</p>
					<ul class="password-rules">
						{passwordRules.map((rule) => <li data-password-rule={rule.id} data-met="false">{rule.label}</li>)}
					</ul>
				</div>
				<button type="submit">Create account</button>
			</form>
			<p class="auth-footer">
				Already have an account? <a href={`/auth/sign-in?returnTo=${encodeURIComponent(returnTo)}`}>Sign in</a>
			</p>
		</main>
		<script is:inline define:vars={{ passwordRules }}>
			const input = document.querySelector('[data-password-input]');
			const confirmInput = document.querySelector('[data-confirm-password-input]');
			const usernameInput = document.querySelector('[data-username-input]');
			const usernameStatus = document.querySelector('[data-username-status]');
			const meter = document.querySelector('[data-password-meter]');
			const fill = document.querySelector('[data-password-fill]');
			const passwordLabel = document.querySelector('[data-password-label]');
			const tests = {
				length: (value) => value.length >= 12,
				lowercase: (value) => /[a-z]/.test(value),
				uppercase: (value) => /[A-Z]/.test(value),
				number: (value) => /\d/.test(value),
				symbol: (value) => /[^A-Za-z0-9\s]/.test(value),
				spaces: (value) => value.length > 0 && !/\s/.test(value),
			};
			function updatePasswordMeter() {
				const value = input?.value ?? '';
				if (meter) {
					meter.hidden = value.length === 0;
				}
				let score = 0;
				for (const rule of passwordRules) {
					const met = Boolean(tests[rule.id]?.(value));
					if (met) score += 1;
					document.querySelector(`[data-password-rule="${rule.id}"]`)?.setAttribute('data-met', String(met));
				}
				const total = passwordRules.length;
				const percent = total > 0 ? Math.round((score / total) * 100) : 0;
				if (fill) {
					fill.style.width = `${percent}%`;
					fill.style.backgroundColor = score === total ? '#1d7a42' : score >= 4 ? '#9a6700' : '#a42c20';
				}
				if (passwordLabel) {
					passwordLabel.textContent = score === total ? 'Strong' : score >= 4 ? 'Almost there' : score >= 2 ? 'Weak' : 'Too weak';
				}
			}
			function setUsernameState(status, message) {
				if (!usernameInput || !usernameStatus) return;
				if (!status || status === 'empty') {
					usernameInput.removeAttribute('data-username-state');
					usernameStatus.removeAttribute('data-tone');
					usernameStatus.textContent = message || 'Username is public and cannot be changed after registration.';
					return;
				}
				usernameInput.setAttribute('data-username-state', status);
				usernameStatus.setAttribute('data-tone', status === 'available' ? 'success' : 'danger');
				usernameStatus.textContent = message;
			}
			let usernameCheckSequence = 0;
			async function updateUsernameAvailability() {
				if (!usernameInput) return;
				const value = usernameInput.value.trim();
				const sequence = ++usernameCheckSequence;
				if (!value) {
					setUsernameState('empty', 'Username is public and cannot be changed after registration.');
					return;
				}
				try {
					const response = await fetch(`/auth/username/check?username=${encodeURIComponent(value)}`, {
						headers: { accept: 'application/json' },
					});
					const result = await response.json();
					if (sequence !== usernameCheckSequence || usernameInput.value.trim() !== value) return;
					setUsernameState(result.status, result.message);
				} catch {
					if (sequence !== usernameCheckSequence) return;
					setUsernameState('error', 'Username availability could not be checked.');
				}
			}
			function updateConfirmState() {
				const password = input?.value ?? '';
				const confirmPassword = confirmInput?.value ?? '';
				if (!confirmInput) return;
				if (!confirmPassword) {
					confirmInput.removeAttribute('data-match-state');
					return;
				}
				confirmInput.setAttribute('data-match-state', password && password === confirmPassword ? 'match' : 'mismatch');
			}
			input?.addEventListener('input', () => {
				updatePasswordMeter();
				updateConfirmState();
			});
			usernameInput?.addEventListener('input', updateUsernameAvailability);
			usernameInput?.addEventListener('change', updateUsernameAvailability);
			confirmInput?.addEventListener('input', updateConfirmState);
			updatePasswordMeter();
			updateConfirmState();
			updateUsernameAvailability();
		</script>
	</body>
</html>
