---
import { normalizeReturnTo, redirectAuthenticatedToApp } from '../../lib/auth/flow';

export const prerender = false;

const authenticatedRedirect = redirectAuthenticatedToApp(Astro);
if (authenticatedRedirect) {
	return authenticatedRedirect;
}

const returnTo = normalizeReturnTo(Astro);
const kind = Astro.url.searchParams.get('kind') ?? 'verify';
const email = Astro.url.searchParams.get('email') ?? '';
const isReset = kind === 'reset';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Check Email | Knowledge Coop</title>
		<style>
			:root {
				color-scheme: light;
				font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				background: #f6f7f2;
				color: #17211b;
			}
			body {
				margin: 0;
				min-height: 100vh;
				display: grid;
				place-items: center;
				padding: 2rem;
			}
			main {
				width: min(100%, 460px);
				background: #ffffff;
				border: 1px solid #d9ded4;
				border-radius: 8px;
				box-shadow: 0 18px 40px rgba(19, 31, 22, 0.08);
				padding: 2rem;
			}
			h1 {
				margin: 0 0 0.5rem;
				font-size: 1.65rem;
				letter-spacing: 0;
			}
			p {
				margin: 0 0 1.25rem;
				color: #516052;
				line-height: 1.5;
			}
			a {
				color: #204c3f;
				font-weight: 800;
			}
		</style>
	</head>
	<body>
		<main>
			<h1>Check your email</h1>
			<p>
				{isReset
					? 'If that account exists, a password reset link is on its way.'
					: 'Open the verification link to finish creating your account.'}
				{email ? ` We sent it to ${email}.` : ''}
			</p>
			<p>
				{isReset ? (
					<a href={`/auth/sign-in?returnTo=${encodeURIComponent(returnTo)}`}>Back to sign in</a>
				) : (
					<a href={`/auth/sign-in?returnTo=${encodeURIComponent(returnTo)}`}>I verified my email</a>
				)}
			</p>
		</main>
	</body>
</html>
