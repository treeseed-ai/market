---
import { createSiteBetterAuth, ensureBetterAuthD1Schema } from '../../lib/auth/better-auth';
import {
	assignImmutableUsername,
	deriveAvailableUsernameForAccount,
	isUsernameAvailable,
	normalizeUsername,
	validateUsername,
} from '../../lib/auth/account';
import { finalizeBetterAuthSession, normalizeReturnTo } from '../../lib/auth/flow';

export const prerender = false;

const returnTo = normalizeReturnTo(Astro);
await ensureBetterAuthD1Schema(Astro);
const auth = createSiteBetterAuth(Astro);
const sessionData = await auth.api.getSession({ headers: Astro.request.headers });
if (!sessionData?.user || !sessionData?.session) {
	return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(returnTo)}`, 302);
}
const accounts = await auth.api.listUserAccounts({ headers: Astro.request.headers }).catch(() => []);
if (normalizeUsername((sessionData.user as any).username)) {
	return Astro.redirect(returnTo, 302);
}

let error = '';
const suggestedUsername = await deriveAvailableUsernameForAccount(Astro, { user: sessionData.user, accounts }) ?? '';

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const username = normalizeUsername(String(form.get('username') ?? ''));
	const validation = validateUsername(username);
	if (!validation.ok) {
		error = validation.message;
	} else if (!(await isUsernameAvailable(Astro, validation.username, { excludeBetterAuthUserId: sessionData.user.id }))) {
		error = 'That username is already taken.';
	} else {
		const assigned = await assignImmutableUsername(Astro, {
			username: validation.username,
			betterAuthUserId: sessionData.user.id,
		});
		if (!assigned.ok) {
			error = assigned.message;
		} else {
			const account = accounts[0];
			await finalizeBetterAuthSession(Astro, {
				provider: account?.providerId ?? 'credential',
				providerSubject: account?.accountId ?? sessionData.user.id,
				user: { ...sessionData.user, username: assigned.username },
				session: sessionData.session,
			});
			const response = Astro.redirect(returnTo, 303);
			for (const cookie of Astro.cookies.headers()) response.headers.append('set-cookie', cookie);
			return response;
		}
	}
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Choose Username | Knowledge Coop</title>
		<style>
			:root {
				color-scheme: light;
				font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				background: #f6f7f2;
				color: #17211b;
			}
			body {
				margin: 0;
				min-height: 100vh;
				display: grid;
				place-items: center;
				padding: 2rem;
			}
			main {
				width: min(100%, 460px);
				background: #fff;
				border: 1px solid #d9ded4;
				border-radius: 8px;
				box-shadow: 0 18px 40px rgba(19, 31, 22, 0.08);
				padding: 2rem;
			}
			h1 {
				margin: 0 0 0.5rem;
				font-size: 1.65rem;
				letter-spacing: 0;
			}
			p {
				margin: 0 0 1.25rem;
				color: #516052;
				line-height: 1.5;
			}
			form {
				display: grid;
				gap: 0.9rem;
			}
			label {
				display: grid;
				gap: 0.35rem;
				font-size: 0.9rem;
				font-weight: 700;
			}
			input {
				width: 100%;
				box-sizing: border-box;
				border: 1px solid #c9d1c4;
				border-radius: 6px;
				padding: 0.78rem 0.85rem;
				font: inherit;
			}
			button {
				min-height: 2.75rem;
				border-radius: 6px;
				border: 1px solid #17211b;
				background: #17211b;
				color: #fff;
				font: inherit;
				font-weight: 800;
				cursor: pointer;
			}
			.auth-error {
				background: #fff2f0;
				border: 1px solid #f0b8b0;
				color: #8a1f11;
				border-radius: 6px;
				padding: 0.75rem;
				margin-bottom: 1rem;
			}
			.field-help {
				color: #667266;
				font-size: 0.82rem;
				font-weight: 600;
			}
		</style>
	</head>
	<body>
		<main>
			<h1>Choose username</h1>
			<p>Your username is public, appears in profile URLs, and cannot be changed after registration.</p>
			{error ? <div class="auth-error" role="alert">{error}</div> : null}
			<form method="POST" action={`/auth/username?returnTo=${encodeURIComponent(returnTo)}`}>
				<label>
					Username
					<input name="username" type="text" autocomplete="username" value={suggestedUsername} required minlength="1" maxlength="39" pattern="[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?" />
					<span class="field-help">Use letters, numbers, or single hyphens.</span>
				</label>
				<button type="submit">Save username</button>
			</form>
		</main>
	</body>
</html>
