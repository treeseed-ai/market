---
import ActionList from '../../../packages/core/src/components/ui/data/ActionList.astro';
import MetricGrid from '../../../packages/core/src/components/ui/data/MetricGrid.astro';
import Panel from '../../../packages/core/src/components/ui/surface/Panel.astro';
import CapacityDiagnosticsPanel from '../../components/app/operations/CapacityDiagnosticsPanel.astro';
import InfrastructureResourceTable from '../../components/app/operations/InfrastructureResourceTable.astro';
import InfrastructureStatusGrid from '../../components/app/operations/InfrastructureStatusGrid.astro';
import SeedOperationsPanel from '../../components/app/operations/SeedOperationsPanel.astro';
import WorkerQueuePanel from '../../components/app/operations/WorkerQueuePanel.astro';
import TreeseedAppLayout from '../../layouts/TreeseedAppLayout.astro';
import { loadInfrastructureViewModel } from '../../view-models/infrastructure.vm.js';

if (!Astro.locals.auth?.principal) {
	return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent('/app/infrastructure')}`);
}

const vm = await loadInfrastructureViewModel(Astro.locals, Astro.url);
const sectionLinks = [
	{ label: 'Repositories', href: '/app/infrastructure/repositories', count: vm.repositories.length, description: 'Git and repository context' },
	{ label: 'Deployments', href: '/app/infrastructure/deployments', count: vm.deployments.length, description: 'Release and deploy state' },
	{ label: 'Capacity', href: '/app/infrastructure/capacity', count: vm.capacity.length, description: 'Budgets, grants, routing' },
	{ label: 'Workers', href: '/app/infrastructure/workers', count: vm.workers.length, description: 'Runtime queues and runners' },
	{ label: 'Hosts', href: '/app/infrastructure/hosts', count: vm.hosts.length, description: 'Web, processing, repository' },
	{ label: 'Resources', href: '/app/infrastructure/resources', count: vm.resources.length, description: 'Operational assets and imports' },
	{ label: 'Seeds', href: '/app/infrastructure/seeds', count: vm.seeds.length, description: 'Environment seed plans' },
	{ label: 'Policies', href: '/app/infrastructure/policies', count: vm.policies.length, description: 'Constraints and diagnostics' },
].map((section) => ({
	...section,
	state: String(section.count),
	tone: section.count > 0 ? 'info' as const : 'muted' as const,
}));
const actionItems = (items: any[]) => items.slice(0, 8).map((item) => ({
	title: item.title,
	description: item.description,
	href: item.href,
	meta: item.meta,
	tone: item.tone,
	actionLabel: item.href ? 'Inspect' : undefined,
}));
---

<TreeseedAppLayout
	title="Infrastructure"
	description="Advanced operator tooling for repositories, deployments, capacity, workers, hosts, integrations, resources, seeds, and policies."
	currentPath={Astro.url.pathname}
	teams={vm.context.teams}
	activeTeam={vm.context.activeTeam}
>
	<MetricGrid metrics={vm.metrics} min="9rem" />

	<Panel class="ts-stack-top" eyebrow="System Overview" title="Operator surfaces" description="Infrastructure is intentionally dense and technical. Primary workflows stay in Mission Control, Workdays, Governance, and Knowledge.">
		<InfrastructureStatusGrid sections={sectionLinks} />
	</Panel>

	<section class="ts-operational-grid ts-stack-top" id="teams">
		<Panel eyebrow="Teams and Projects" title="Operational context">
			<InfrastructureResourceTable items={vm.projects} emptyTitle="No projects configured" emptyDescription="Projects are contextual metadata for workdays and infrastructure." />
		</Panel>
		<Panel eyebrow="Diagnostics" title="Policy and runtime signals">
			<ActionList items={actionItems(vm.diagnostics)}>
				<p class="ts-empty-inline">No infrastructure diagnostics require attention.</p>
			</ActionList>
		</Panel>
	</section>

	<section class="ts-operational-grid ts-stack-top">
		<Panel eyebrow="Repositories" title="Repository context">
			<InfrastructureResourceTable items={vm.repositories} emptyTitle="No repositories visible" />
		</Panel>
		<Panel eyebrow="Deployments" title="Deployment state">
			<InfrastructureResourceTable items={vm.deployments} emptyTitle="No deployment history visible" />
		</Panel>
	</section>

	<section class="ts-operational-grid ts-stack-top">
		<CapacityDiagnosticsPanel capacity={vm.capacity} diagnostics={vm.diagnostics} />
		<WorkerQueuePanel workers={vm.workers} />
	</section>

	<section class="ts-operational-grid ts-stack-top">
		<Panel eyebrow="Hosts and Integrations" title="Configured hosts">
			<InfrastructureResourceTable items={vm.hosts} emptyTitle="No hosts configured" />
		</Panel>
		<Panel eyebrow="Resources and Imports" title="Operational resources">
			<InfrastructureResourceTable items={vm.resources} emptyTitle="No operational resources available" />
		</Panel>
	</section>

	<section class="ts-operational-grid ts-stack-top">
		<SeedOperationsPanel seeds={vm.seeds} />
		<Panel eyebrow="Policies" title="Infrastructure policies">
			<InfrastructureResourceTable items={vm.policies} emptyTitle="No policies visible" />
		</Panel>
	</section>
</TreeseedAppLayout>
