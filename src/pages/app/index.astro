---
import ActionList from '../../../packages/core/src/components/ui/data/ActionList.astro';
import MetricGrid from '../../../packages/core/src/components/ui/data/MetricGrid.astro';
import Button from '../../../packages/core/src/components/ui/forms/Button.astro';
import EmptyState from '../../../packages/core/src/components/ui/surface/EmptyState.astro';
import Panel from '../../../packages/core/src/components/ui/surface/Panel.astro';
import GovernancePanel from '../../components/app/operations/GovernancePanel.astro';
import KnowledgeArtifactCard from '../../components/app/operations/KnowledgeArtifactCard.astro';
import RepositoryContextPanel from '../../components/app/operations/RepositoryContextPanel.astro';
import WorkdaySummaryCard from '../../components/app/operations/WorkdaySummaryCard.astro';
import TreeseedAppLayout from '../../layouts/TreeseedAppLayout.astro';
import { loadMissionControlViewModel } from '../../view-models/mission-control.vm.js';

if (!Astro.locals.auth?.principal) {
	return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent('/app/')}`);
}

const vm = await loadMissionControlViewModel(Astro.locals);
---

<TreeseedAppLayout
	title="Mission Control"
	description="Operational overview for objectives, workdays, governance, knowledge, and infrastructure health."
	currentPath={Astro.url.pathname}
	teams={vm.context.teams}
	activeTeam={vm.context.activeTeam}
>
	<Panel eyebrow={vm.teamName} title={vm.currentObjective} description={vm.summary}>
		<Button slot="actions" href="/app/workdays" variant="secondary" size="sm">Open workdays</Button>
		<MetricGrid metrics={vm.metrics} min="10rem" />
	</Panel>

	<section class="ts-operational-grid ts-stack-top">
		<Panel eyebrow="Execution" title="Active workdays" description="Current operational work across repositories and approvals.">
			<div class="ts-card-list">
				{vm.activeWorkdays.length > 0 ? vm.activeWorkdays.map((workday) => (
					<WorkdaySummaryCard workday={workday} />
				)) : <EmptyState title="No active workdays" description="Start with a new objective when the organization is ready for coordinated work." actions={[{ label: 'New objective', href: '/app/launch' }]} />}
			</div>
		</Panel>

		<GovernancePanel title="Pending approvals" description="Operational decisions waiting for deliberate review." items={vm.pendingApprovals} />
	</section>

	<section class="ts-operational-grid ts-stack-top">
		<Panel eyebrow="Queue" title="Queued operational work" description="Execution work that is visible without exposing implementation chatter.">
			<ActionList items={vm.queuedWork.map((item) => ({
				title: item.title,
				description: item.description,
				href: item.href,
				meta: item.meta,
				tone: item.tone,
				actionLabel: item.href ? 'Open' : undefined,
			}))}>
				<p class="ts-empty-inline">No queued execution work is currently visible.</p>
			</ActionList>
		</Panel>

		<RepositoryContextPanel repositories={vm.repositoryHealth} />
	</section>

	<section class="ts-operational-grid ts-stack-top">
		<Panel eyebrow="Knowledge" title="Recent knowledge produced" description="Operational work compounding into durable organizational memory.">
			<div class="ts-card-list">
				{vm.recentKnowledge.length > 0 ? vm.recentKnowledge.map((artifact) => (
					<KnowledgeArtifactCard artifact={artifact} />
				)) : <EmptyState title="No knowledge produced yet" description="Knowledge outputs will appear as workdays generate reports, decisions, and operational artifacts." />}
			</div>
		</Panel>

		<Panel eyebrow="Operational record" title="Recent decisions and releases">
			<ActionList items={[...vm.recentDecisions, ...vm.recentReleases].map((item) => ({
				title: item.title,
				description: item.description,
				href: item.href,
				meta: item.meta,
				tone: item.tone,
				actionLabel: item.href ? 'Open' : undefined,
			}))}>
				<p class="ts-empty-inline">No recent decisions or releases are recorded yet.</p>
			</ActionList>
		</Panel>
	</section>
</TreeseedAppLayout>
