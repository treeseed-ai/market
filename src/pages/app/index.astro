---
import { loadAccessibleTeams } from '../../lib/market/store.js';

if (!Astro.locals.auth?.principal) {
	return Astro.redirect(`/auth/sign-in?provider=github&next=${encodeURIComponent('/app/')}`);
}

const teams = await loadAccessibleTeams(Astro.locals);
if (teams[0]) {
	return Astro.redirect(`/app/teams/${teams[0].slug}/home`);
}
---

<html lang="en">
	<body>
		<main style="padding: 2rem; font-family: sans-serif;">
			<h1>Knowledge Coop</h1>
			<p>No teams are available for this account yet.</p>
			<p><a href="/v1/teams">Use the API to create a team</a></p>
		</main>
	</body>
</html>
