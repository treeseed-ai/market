---
import InfrastructureSectionPage from '../../../components/app/operations/InfrastructureSectionPage.astro';
import { loadInfrastructureViewModel } from '../../../view-models/infrastructure.vm.js';

if (!Astro.locals.auth?.principal) {
	return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
}

const vm = await loadInfrastructureViewModel(Astro.locals, Astro.url);
---

<InfrastructureSectionPage vm={vm} section="deployments" title="Deployments" description="Release and deployment records for operator inspection." items={vm.deployments} emptyTitle="No deployment history visible" />
