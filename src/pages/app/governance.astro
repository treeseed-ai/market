---
import MetricGrid from '../../../packages/core/src/components/ui/data/MetricGrid.astro';
import Panel from '../../../packages/core/src/components/ui/surface/Panel.astro';
import GovernancePolicySummary from '../../components/app/operations/GovernancePolicySummary.astro';
import GovernanceReviewQueue from '../../components/app/operations/GovernanceReviewQueue.astro';
import OperationalTimeline from '../../components/app/operations/OperationalTimeline.astro';
import TreeseedAppLayout from '../../layouts/TreeseedAppLayout.astro';
import { loadGovernanceViewModel } from '../../view-models/governance.vm.js';

if (!Astro.locals.auth?.principal) {
	return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent('/app/governance')}`);
}

const vm = await loadGovernanceViewModel(Astro.locals);
---

<TreeseedAppLayout
	title="Governance"
	description="Operational review, approval, escalation, policy, and audit visibility."
	currentPath={Astro.url.pathname}
	teams={vm.context.teams}
	activeTeam={vm.context.activeTeam}
>
	<MetricGrid metrics={vm.metrics} min="10rem" />

	<section class="ts-operational-grid ts-stack-top">
		<GovernanceReviewQueue title="Pending approvals" items={vm.pendingApprovals} />
		<GovernanceReviewQueue title="Escalations" description="High-severity, blocked, or escalated operational review items." items={vm.escalations} empty="No escalations are active." />
	</section>

	<section class="ts-operational-grid ts-stack-top">
		<GovernancePolicySummary policies={vm.policies} constraints={vm.capacityConstraints} />
		<GovernancePolicySummary title="Policy violations" description="Blocked routing, exhausted budget, paused execution, and approval-required capacity signals." constraints={vm.policyViolations} />
	</section>

	<section class="ts-operational-grid ts-stack-top">
		<Panel eyebrow="Review Timeline" title="Governance audit trail">
			<OperationalTimeline events={vm.reviewTimeline} emptyTitle="No review events recorded" />
		</Panel>
		<Panel eyebrow="Audit Trail" title="Operational audit stream" description="Approvals, policy events, activity, and capacity signals in one trace.">
			<OperationalTimeline events={vm.auditTrail} emptyTitle="No audit events recorded" />
		</Panel>
	</section>
</TreeseedAppLayout>
