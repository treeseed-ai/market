---
import Button from '../../../../../packages/core/src/components/ui/forms/Button.astro';
import Field from '../../../../../packages/core/src/components/ui/forms/Field.astro';
import FormActions from '../../../../../packages/core/src/components/ui/forms/FormActions.astro';
import TextInput from '../../../../../packages/core/src/components/ui/forms/TextInput.astro';
import EmptyState from '../../../../../packages/core/src/components/ui/surface/EmptyState.astro';
import Panel from '../../../../../packages/core/src/components/ui/surface/Panel.astro';
import PlainTable from '../../../../components/app/controls/PlainTable.astro';
import TreeseedAppLayout from '../../../../layouts/TreeseedAppLayout.astro';
import { escapeHtml as esc } from '../../../../lib/market/control-ui.js';
import { loadOperationalContext } from '../../../../view-models/shared.js';

const teamParam = String(Astro.params.teamId ?? '');
if (!Astro.locals.auth?.principal) {
	return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
}
const context = await loadOperationalContext(Astro.locals, Astro);
const team = context.teams.find((entry: any) => entry.id === teamParam || entry.slug === teamParam) ?? null;
const blockers = team && context.store ? await context.store.evaluateTeamDeletionBlockers(team.id).catch(() => null) : null;
if (!team) Astro.response.status = 404;
const blockerRows = Object.entries(blockers ?? {})
	.filter(([, value]) => Array.isArray(value) ? value.length > 0 : Number(value) > 0)
	.map(([key, value]) => ({ name: esc(key), value: esc(Array.isArray(value) ? value.length : value) }));
const confirmation = team ? `DELETE ${team.name}` : '';
---

<TreeseedAppLayout title={team ? `Delete ${team.displayName ?? team.name}` : 'Team not found'} description="Remove one team when it has no blocking records." currentPath="/app/teams" teams={context.teams} activeTeam={context.activeTeam}>
	{team ? (
		<section class="ts-control-page" aria-label="Delete team">
			<Panel eyebrow="Team" title="Delete team" description="This action is permanent. Blocking records must be removed first.">
				<PlainTable columns={[{ key: 'name', label: 'Blocker' }, { key: 'value', label: 'Count' }]} rows={blockerRows} emptyTitle="No blockers found" emptyDescription="This team can be deleted after confirmation." />
				<form id="team-delete-form" class="ts-form-stack ts-stack-top">
					<Field label={`Type ${confirmation}`} name="confirmation" required>
						<TextInput name="confirmation" required />
					</Field>
					<FormActions align="start">
						<Button type="submit" variant="danger">Delete team</Button>
						<Button href="/app/teams" variant="secondary">Cancel</Button>
						<span class="ts-subtle" id="team-delete-status" role="status"></span>
					</FormActions>
				</form>
			</Panel>
		</section>
	) : (
		<EmptyState title="Team not found" description="This team is not available." actions={[{ label: 'Back to teams', href: '/app/teams' }]} />
	)}
</TreeseedAppLayout>

<script is:inline define:vars={{ teamId: team?.id ?? '' }}>
	const form = document.getElementById('team-delete-form');
	const status = document.getElementById('team-delete-status');
	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const confirmation = String(new FormData(form).get('confirmation') ?? '');
		if (status) status.textContent = 'Deleting...';
		const response = await fetch(`/v1/teams/${encodeURIComponent(teamId)}`, {
			method: 'DELETE',
			headers: { 'content-type': 'application/json' },
			body: JSON.stringify({ confirmation }),
		});
		const payload = await response.json().catch(() => null);
		if (!response.ok || payload?.ok === false) {
			if (status) status.textContent = payload?.error ?? 'Team could not be deleted.';
			return;
		}
		document.cookie = 'treeseed_active_team=; path=/app; max-age=0; SameSite=Lax';
		window.location.href = '/app/teams';
	});
</script>
