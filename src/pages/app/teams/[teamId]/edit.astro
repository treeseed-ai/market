---
import Button from '../../../../../packages/core/src/components/ui/forms/Button.astro';
import Field from '../../../../../packages/core/src/components/ui/forms/Field.astro';
import FormActions from '../../../../../packages/core/src/components/ui/forms/FormActions.astro';
import TextInput from '../../../../../packages/core/src/components/ui/forms/TextInput.astro';
import Textarea from '../../../../../packages/core/src/components/ui/forms/Textarea.astro';
import EmptyState from '../../../../../packages/core/src/components/ui/surface/EmptyState.astro';
import Panel from '../../../../../packages/core/src/components/ui/surface/Panel.astro';
import TreeseedAppLayout from '../../../../layouts/TreeseedAppLayout.astro';
import { loadOperationalContext } from '../../../../view-models/shared.js';

const teamId = String(Astro.params.teamId ?? '');
if (!Astro.locals.auth?.principal) {
	return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
}
const context = await loadOperationalContext(Astro.locals, Astro);
const team = context.teams.find((entry: any) => entry.id === teamId || entry.slug === teamId) ?? null;
if (!team) Astro.response.status = 404;
---

<TreeseedAppLayout title={team ? `Edit ${team.displayName ?? team.name}` : 'Team not found'} description="Edit one team." currentPath="/app/teams" teams={context.teams} activeTeam={context.activeTeam}>
	{team ? (
		<section class="ts-control-page" aria-label="Edit team">
			<Panel eyebrow="Team" title="Edit team" description="Update the team fields.">
				<form id="team-edit-form" class="ts-form-stack">
					<div class="ts-form-grid">
						<Field label="Name" name="name" required>
							<TextInput name="name" required value={team.name ?? ''} pattern="[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?" />
						</Field>
						<Field label="Display name" name="displayName">
							<TextInput name="displayName" value={team.displayName ?? ''} />
						</Field>
						<Field label="Logo URL" name="logoUrl" class="ts-field--full">
							<TextInput name="logoUrl" type="url" value={team.logoUrl ?? ''} />
						</Field>
						<Field label="Profile summary" name="profileSummary" class="ts-field--full">
							<Textarea name="profileSummary" rows={4} value={team.profileSummary ?? ''} />
						</Field>
					</div>
					<FormActions align="start">
						<Button type="submit">Save team</Button>
						<Button href="/app/teams" variant="secondary">Back</Button>
						<span class="ts-subtle" id="team-edit-status" role="status"></span>
					</FormActions>
				</form>
			</Panel>
		</section>
	) : (
		<EmptyState title="Team not found" description="This team is not available." actions={[{ label: 'Back to teams', href: '/app/teams' }]} />
	)}
</TreeseedAppLayout>

<script is:inline define:vars={{ teamId: team?.id ?? '' }}>
	const form = document.getElementById('team-edit-form');
	const status = document.getElementById('team-edit-status');
	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const data = new FormData(form);
		if (status) status.textContent = 'Saving...';
		const response = await fetch(`/v1/teams/${encodeURIComponent(teamId)}`, {
			method: 'PATCH',
			headers: { 'content-type': 'application/json' },
			body: JSON.stringify({
				name: String(data.get('name') ?? '').trim(),
				displayName: String(data.get('displayName') ?? '').trim(),
				logoUrl: String(data.get('logoUrl') ?? '').trim(),
				profileSummary: String(data.get('profileSummary') ?? '').trim(),
			}),
		});
		const payload = await response.json().catch(() => null);
		if (!response.ok || payload?.ok === false) {
			if (status) status.textContent = payload?.error ?? 'Team could not be saved.';
			return;
		}
		if (status) status.textContent = 'Saved.';
	});
</script>
