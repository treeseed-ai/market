---
import TreeseedAppLayout from '../../../layouts/TreeseedAppLayout.astro';
import Button from '../../../../packages/core/src/components/ui/forms/Button.astro';
import Field from '../../../../packages/core/src/components/ui/forms/Field.astro';
import FormActions from '../../../../packages/core/src/components/ui/forms/FormActions.astro';
import TextInput from '../../../../packages/core/src/components/ui/forms/TextInput.astro';
import Textarea from '../../../../packages/core/src/components/ui/forms/Textarea.astro';
import StatusPill from '../../../../packages/core/src/components/ui/data/StatusPill.astro';
import Panel from '../../../../packages/core/src/components/ui/surface/Panel.astro';
import { loadAccessibleTeams, resolveMarketStore } from '../../../lib/market/store.js';
import { validateTeamName } from '../../../api/store.js';

export const prerender = false;

if (!Astro.locals.auth?.principal) {
	return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent('/app/teams/new')}`);
}

const store = resolveMarketStore(Astro.locals);
const teams = await loadAccessibleTeams(Astro.locals);
let error = '';
let submittedName = '';
let submittedDisplayName = '';
let submittedLogoUrl = '';
let submittedSummary = '';

if (Astro.request.method === 'POST' && store) {
	const form = await Astro.request.formData();
	submittedName = String(form.get('name') ?? '').trim();
	submittedDisplayName = String(form.get('displayName') ?? '').trim();
	submittedLogoUrl = String(form.get('logoUrl') ?? '').trim();
	submittedSummary = String(form.get('profileSummary') ?? '').trim();
	const validation = validateTeamName(submittedName);
	if (!validation.ok) {
		error = validation.message ?? 'Team name is invalid.';
	} else if (!(await store.isTeamNameAvailable(validation.name))) {
		error = 'That team name is already taken.';
	} else {
		try {
			await store.createTeam({
				name: validation.name,
				displayName: submittedDisplayName || validation.name,
				logoUrl: submittedLogoUrl || null,
				profileSummary: submittedSummary || null,
				ownerUserId: Astro.locals.auth.principal.id,
				metadata: { source: 'team_create_page' },
			});
			return Astro.redirect(`/app/teams/${validation.name}/edit?created=1`, 303);
		} catch (createError) {
			error = createError instanceof Error ? createError.message : 'Unable to create team.';
		}
	}
}
---

<TreeseedAppLayout
	title="Create Team"
	description="Create a team workspace for projects, members, releases, and market listings."
	currentPath={Astro.url.pathname}
	teams={teams}
	activeTeam={teams[0] ?? null}
>
	<Panel
		eyebrow="New team"
		title="Add a team"
		description="The team name is public, used in URLs, and cannot be changed later."
	>
		<form class="ts-form-stack" method="POST">
			{error ? <StatusPill tone="danger">{error}</StatusPill> : null}
			<Field label="Team name" name="name" help="Public handle for /t/name and app URLs." required>
				<TextInput
					name="name"
					value={submittedName}
					required
					maxlength={39}
					pattern="[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?"
				/>
			</Field>
			<Field label="Display name" name="displayName" required>
				<TextInput name="displayName" value={submittedDisplayName} required />
			</Field>
			<Field label="Logo URL" name="logoUrl">
				<TextInput name="logoUrl" type="url" value={submittedLogoUrl} placeholder="https://example.com/logo.png" />
			</Field>
			<Field label="Profile summary" name="profileSummary">
				<Textarea name="profileSummary" rows={4} value={submittedSummary} />
			</Field>
			<FormActions align="start">
				<Button type="submit">Create team</Button>
			</FormActions>
		</form>
	</Panel>
</TreeseedAppLayout>
