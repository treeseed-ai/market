---
import TreeseedAppLayout from '../../../../../../layouts/TreeseedAppLayout.astro';
import ProjectAgentsView from '../../../../../../components/app/project/ProjectAgentsView.astro';
import ProjectCapacityView from '../../../../../../components/app/project/ProjectCapacityView.astro';
import ProjectDirectView from '../../../../../../components/app/project/ProjectDirectView.astro';
import ProjectOverviewView from '../../../../../../components/app/project/ProjectOverviewView.astro';
import ProjectReleasesView from '../../../../../../components/app/project/ProjectReleasesView.astro';
import ProjectSettingsView from '../../../../../../components/app/project/ProjectSettingsView.astro';
import ProjectShareView from '../../../../../../components/app/project/ProjectShareView.astro';
import ProjectWorkstreamsView from '../../../../../../components/app/project/ProjectWorkstreamsView.astro';
import { loadProjectAppContext } from '../../../../../../lib/market/app-data.js';
import { loadProjectSectionData, projectSectionTitles } from '../../../../../../lib/market/project-section-data.js';

const section = Astro.params.section ?? 'overview';
const sectionComponents = {
	overview: ProjectOverviewView,
	direct: ProjectDirectView,
	workstreams: ProjectWorkstreamsView,
	agents: ProjectAgentsView,
	capacity: ProjectCapacityView,
	releases: ProjectReleasesView,
	share: ProjectShareView,
	settings: ProjectSettingsView,
};
const SectionView = (sectionComponents as Record<string, any>)[section] ?? null;
if (!SectionView) {
	Astro.response.status = 404;
}

if (!Astro.locals.auth?.principal) {
	return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
}

const context = await loadProjectAppContext(Astro.locals, Astro.params.teamSlug ?? '', Astro.params.projectSlug ?? '');
if (!context.team || !context.project || !context.store) {
	Astro.response.status = 404;
}

const sectionData = await loadProjectSectionData(context, section);
const currentSectionTitle = (projectSectionTitles as Record<string, string>)[section] ?? 'Project';
---

<TreeseedAppLayout
	title={`${context.project?.name ?? 'Project'} · ${currentSectionTitle}`}
	description="Project-centric operations for direction, workstreams, agents, releases, and market sharing."
	currentPath={Astro.url.pathname}
	teams={context.teams}
	activeTeam={context.team}
	project={{
		id: context.project?.id ?? '',
		slug: context.project?.slug ?? '',
		name: context.project?.name ?? 'Project',
		health: sectionData.summary?.health ?? null,
	}}
>
	{SectionView ? <SectionView {...sectionData} /> : null}
</TreeseedAppLayout>
