---
import TreeseedAppLayout from '../../../../layouts/TreeseedAppLayout.astro';
import Button from '../../../../../packages/core/src/components/ui/forms/Button.astro';
import Field from '../../../../../packages/core/src/components/ui/forms/Field.astro';
import FormActions from '../../../../../packages/core/src/components/ui/forms/FormActions.astro';
import Select from '../../../../../packages/core/src/components/ui/forms/Select.astro';
import TextInput from '../../../../../packages/core/src/components/ui/forms/TextInput.astro';
import Textarea from '../../../../../packages/core/src/components/ui/forms/Textarea.astro';
import KeyValueList from '../../../../../packages/core/src/components/ui/data/KeyValueList.astro';
import StatusPill from '../../../../../packages/core/src/components/ui/data/StatusPill.astro';
import Panel from '../../../../../packages/core/src/components/ui/surface/Panel.astro';
import { sendAuthEmail } from '../../../../lib/auth/email';
import { loadTeamAppContext } from '../../../../lib/market/app-data.js';
import { teamDeletionConfirmationMatches, validateTeamName } from '../../../../api/store.js';

export const prerender = false;

if (!Astro.locals.auth?.principal) {
	return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
}

const context = await loadTeamAppContext(Astro.locals, Astro.params.teamSlug ?? '');
if (!context.team || !context.store) {
	return new Response('Not found', { status: 404 });
}
if (!(await context.store.principalCanManageTeam(context.principal, context.team.id))) {
	return new Response('Permission denied', { status: 403 });
}

const roles = ['team_owner', 'market_steward', 'project_lead', 'contributor', 'reviewer', 'finance'];
let status = Astro.url.searchParams.get('status') ?? (Astro.url.searchParams.get('created') ? 'created' : '');

async function sendInviteEmail(email: string, teamName: string, token: string) {
	const acceptUrl = new URL(`/team-invites/${encodeURIComponent(token)}/accept`, Astro.url.origin);
	await sendAuthEmail(Astro, {
		to: email,
		subject: `You were invited to ${teamName} on Treeseed Market`,
		text: [
			`You were invited to join ${teamName} on Treeseed Market.`,
			`Open this link to accept the invite: ${acceptUrl.href}`,
			'If you did not expect this invite, you can ignore this email.',
		].join('\n\n'),
	});
}

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const action = String(form.get('action') ?? '');
	if (action === 'settings') {
		const requestedName = String(form.get('name') ?? '').trim();
		const validation = validateTeamName(requestedName);
		if (!validation.ok) {
			return Astro.redirect(`/app/teams/${context.team.name}/edit?status=${validation.code}`, 303);
		}
		const result = await context.store.updateTeamSettings(context.team.id, {
			name: requestedName,
			displayName: String(form.get('displayName') ?? '').trim(),
			logoUrl: String(form.get('logoUrl') ?? '').trim(),
			profileSummary: String(form.get('profileSummary') ?? '').trim(),
		});
		if (!result?.ok) {
			return Astro.redirect(`/app/teams/${context.team.name}/edit?status=${result?.code ?? 'settings_failed'}`, 303);
		}
		return Astro.redirect(`/app/teams/${result.team.name}/edit?status=settings`, 303);
	}
	if (action === 'invite') {
		const result = await context.store.createTeamInvite(context.team.id, {
			email: String(form.get('email') ?? ''),
			roleKey: String(form.get('roleKey') ?? 'contributor'),
			invitedByUserId: context.principal.id,
		});
		if (result.ok && result.token && result.invite) {
			await sendInviteEmail(result.invite.email, context.team.displayName ?? context.team.name, result.token);
		}
		return Astro.redirect(`/app/teams/${context.team.name}/edit?status=${result.ok ? result.existingUser ? 'member_added' : 'invited' : result.code}`, 303);
	}
	if (action === 'role') {
		return Astro.redirect(
			`/app/teams/${context.team.name}/edit?status=${(await context.store.updateTeamMemberRole(
				context.team.id,
				String(form.get('membershipId') ?? ''),
				String(form.get('roleKey') ?? 'contributor'),
			)).ok ? 'role' : 'last_owner'}`,
			303,
		);
	}
	if (action === 'remove') {
		return Astro.redirect(
			`/app/teams/${context.team.name}/edit?status=${(await context.store.removeTeamMember(context.team.id, String(form.get('membershipId') ?? ''))).ok ? 'removed' : 'last_owner'}`,
			303,
		);
	}
	if (action === 'revoke_invite') {
		await context.store.revokeTeamInvite(context.team.id, String(form.get('inviteId') ?? ''));
		return Astro.redirect(`/app/teams/${context.team.name}/edit?status=invite_revoked`, 303);
	}
	if (action === 'delete') {
		const confirmation = String(form.get('confirmation') ?? '');
		if (!teamDeletionConfirmationMatches(confirmation, context.team.name)) {
			return Astro.redirect(`/app/teams/${context.team.name}/edit?status=delete_confirmation`, 303);
		}
		const result = await context.store.deleteTeam(context.team.id, confirmation);
		if (result.ok) {
			return Astro.redirect('/app/?team=deleted', 303);
		}
		return Astro.redirect(`/app/teams/${context.team.name}/edit?status=${result.code}`, 303);
	}
}

const refreshed = await loadTeamAppContext(Astro.locals, context.team.name);
const team = refreshed.team ?? context.team;
const [members, invites, blockers] = await Promise.all([
	context.store.listTeamMembers(team.id),
	context.store.listTeamInvites(team.id),
	context.store.evaluateTeamDeletionBlockers(team.id),
]);
const statusLabels: Record<string, string> = {
	created: 'Team created.',
	settings: 'Team settings saved.',
	invited: 'Invite email sent.',
	member_added: 'Existing user added to the team.',
	role: 'Member role updated.',
	removed: 'Member removed.',
	invite_revoked: 'Invite revoked.',
	last_owner: 'A team must keep at least one owner.',
	delete_confirmation: `Type DELETE ${team.name} to confirm deletion.`,
	blocked: 'This team still owns content and cannot be deleted yet.',
	missing: 'Team name is required.',
	format: 'Team names can use 1-39 letters, numbers, or single hyphens, with no leading or trailing hyphen.',
	reserved: 'That team name is reserved.',
	taken: 'That team name is already taken.',
	settings_failed: 'Team settings could not be saved.',
};
---

<TreeseedAppLayout
	title={`${team.displayName ?? team.name} · Edit Team`}
	description="Manage team profile settings, members, invites, and deletion safeguards."
	currentPath={Astro.url.pathname}
	teams={refreshed.teams}
	activeTeam={team}
>
	{status ? <StatusPill tone={['last_owner', 'delete_confirmation', 'blocked'].includes(status) ? 'danger' : 'success'}>{statusLabels[status] ?? status}</StatusPill> : null}
	<section class="ts-section-grid ts-stack-top">
		<Panel
			eyebrow="Team settings"
			title={team.displayName ?? team.name}
			actions={[{ label: 'View public profile', href: `/t/${team.name}`, variant: 'secondary' }]}
		>
			<form class="ts-form-stack" method="POST">
				<input type="hidden" name="action" value="settings" />
				<Field label="Team name" name="name" help="Team name is public and used in URLs." required>
					<TextInput
						data-team-name-input
						name="name"
						value={team.name}
						required
						maxlength={39}
						pattern="[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?"
						ariaDescribedby="team-name-status"
					/>
					<span id="team-name-status" data-team-name-status class="ts-field-help">Team name is public and used in URLs.</span>
				</Field>
				<Field label="Display name" name="displayName" required>
					<TextInput name="displayName" value={team.displayName ?? team.name} required />
				</Field>
				<Field label="Logo URL" name="logoUrl">
					<TextInput name="logoUrl" type="url" value={team.logoUrl ?? ''} />
				</Field>
				<Field label="Profile summary" name="profileSummary">
					<Textarea name="profileSummary" rows={4} value={team.profileSummary ?? ''} />
				</Field>
				<FormActions align="start">
					<Button type="submit">Save settings</Button>
				</FormActions>
			</form>
		</Panel>

		<Panel eyebrow="Invite" title="Add a member">
			<form class="ts-form-stack" method="POST">
				<input type="hidden" name="action" value="invite" />
				<Field label="Email" name="email" required>
					<TextInput name="email" type="email" required />
				</Field>
				<Field label="Role" name="roleKey">
					<Select name="roleKey" options={roles.map((role) => ({ label: role.replaceAll('_', ' '), value: role }))} />
				</Field>
				<FormActions align="start">
					<Button type="submit">Invite member</Button>
				</FormActions>
			</form>
		</Panel>
	</section>

	<Panel class="ts-stack-top" title="Members and invites">
		<div class="ts-member-list">
			{members.map((member: any) => (
				<div class="ts-member-row">
					<div>
						<strong>{member.displayName ?? member.email ?? member.userId}</strong>
						<span class="ts-subtle">{member.email ?? member.userId}</span>
					</div>
					<StatusPill tone="muted">{member.status}</StatusPill>
					<form method="POST" class="ts-inline-form">
						<input type="hidden" name="action" value="role" />
						<input type="hidden" name="membershipId" value={member.id} />
						<Select name="roleKey" value={member.roles[0] ?? 'contributor'} options={roles.map((role) => ({ label: role.replaceAll('_', ' '), value: role }))} />
						<Button variant="secondary" size="sm" type="submit">Save</Button>
					</form>
					<form method="POST">
						<input type="hidden" name="action" value="remove" />
						<input type="hidden" name="membershipId" value={member.id} />
						<Button variant="secondary" size="sm" type="submit">Remove</Button>
					</form>
				</div>
			))}
			{invites.map((invite: any) => (
				<div class="ts-member-row">
					<div>
						<strong>{invite.email}</strong>
						<span class="ts-subtle">Pending invite</span>
					</div>
					<StatusPill tone="warning">{invite.status}</StatusPill>
					<span>{invite.roleKey.replaceAll('_', ' ')}</span>
					<form method="POST">
						<input type="hidden" name="action" value="revoke_invite" />
						<input type="hidden" name="inviteId" value={invite.id} />
						<Button variant="secondary" size="sm" type="submit">Revoke</Button>
					</form>
				</div>
			))}
		</div>
	</Panel>

	<Panel class="ts-stack-top ts-danger-zone" eyebrow="Danger zone" title="Delete team" tone="danger">
		{blockers.length > 0 ? (
			<KeyValueList items={blockers.map((blocker: any) => ({
				key: blocker.label,
				value: blocker.code.replaceAll('_', ' '),
				tone: 'danger',
			}))} />
		) : (
			<form class="ts-form-stack" method="POST">
				<input type="hidden" name="action" value="delete" />
				<Field label="Confirmation text" name="confirmation" help={`Type DELETE ${team.name} to confirm.`}>
					<TextInput name="confirmation" autocomplete="off" />
				</Field>
				<FormActions align="start">
					<Button variant="danger" type="submit">Delete team</Button>
				</FormActions>
			</form>
		)}
	</Panel>
	<script is:inline define:vars={{ currentTeamId: team.id, currentTeamName: team.name }}>
		const teamNameInput = document.querySelector('[data-team-name-input]');
		const teamNameStatus = document.querySelector('[data-team-name-status]');
		function setTeamNameState(status, message) {
			if (!teamNameInput || !teamNameStatus) return;
			if (!status || status === 'empty') {
				teamNameInput.removeAttribute('data-team-name-state');
				teamNameStatus.removeAttribute('data-tone');
				teamNameStatus.textContent = message || 'Team name is public and used in URLs.';
				return;
			}
			teamNameInput.setAttribute('data-team-name-state', status);
			teamNameStatus.setAttribute('data-tone', status === 'available' ? 'success' : 'danger');
			teamNameStatus.textContent = message;
		}
		let teamNameCheckSequence = 0;
		async function updateTeamNameAvailability() {
			if (!teamNameInput) return;
			const value = teamNameInput.value.trim();
			const sequence = ++teamNameCheckSequence;
			if (!value) {
				setTeamNameState('empty', 'Team name is public and used in URLs.');
				return;
			}
			if (value.toLowerCase() === currentTeamName) {
				setTeamNameState('available', 'This is your current team name.');
				return;
			}
			try {
				const response = await fetch(`/app/teams/name-check?name=${encodeURIComponent(value)}&teamId=${encodeURIComponent(currentTeamId)}`, {
					headers: { accept: 'application/json' },
				});
				const result = await response.json();
				if (sequence !== teamNameCheckSequence || teamNameInput.value.trim() !== value) return;
				setTeamNameState(result.status, result.message);
			} catch {
				if (sequence !== teamNameCheckSequence) return;
				setTeamNameState('error', 'Team name availability could not be checked.');
			}
		}
		teamNameInput?.addEventListener('input', updateTeamNameAvailability);
		teamNameInput?.addEventListener('change', updateTeamNameAvailability);
		updateTeamNameAvailability();
	</script>
</TreeseedAppLayout>
