					<span class="kc-metric__value">{capacitySummary?.activeProviderCount ?? 0}</span>
				</div>
				<div class="kc-panel kc-metric">
					<span class="kc-metric__label">Blocked work</span>
					<span class="kc-metric__value">{capacitySummary?.blockedTaskCount ?? 0}</span>
				</div>
			</section>
			<section class="kc-grid-2" style="margin-top: 1rem;">
				<div class="kc-panel">
					<div class="kc-panel__header">
						<div>
							<p class="kc-section__eyebrow">Processing Capacity</p>
							<h2>{(capacitySummary?.activeProviderCount ?? 0) > 0 ? 'Helpers are ready to process work' : 'No helper capacity is connected yet'}</h2>
							<p>Capacity providers spend helper credits through active processing hosts. Multiple providers can share the same host.</p>
						</div>
						<span class="kc-status-pill" data-tone={(capacitySummary?.activeProviderCount ?? 0) > 0 ? 'success' : 'warning'}>{(capacitySummary?.activeProviderCount ?? 0) > 0 ? 'connected and healthy' : 'waiting for provider'}</span>
					</div>
					<div class="kc-list" style="margin-top:1rem;">
						<div class="kc-list-item">
							<strong>{activeTeamProcessingHosts.length} active team processing host{activeTeamProcessingHosts.length === 1 ? '' : 's'}</strong><br />
							<span class="kc-subtle">Host-backed capacity requires an active processing host. TreeSeed-managed capacity does not require team host credentials.</span>
						</div>
						<div class="kc-list-item">
							<strong>{capacityGrants.length} allocation{capacityGrants.length === 1 ? '' : 's'}</strong><br />
							<span class="kc-subtle">Project allocations decide where helper credits can be spent.</span>
						</div>
					</div>
				</div>
				<div class="kc-panel">
					<div class="kc-panel__header">
						<div>
							<p class="kc-section__eyebrow">Add provider</p>
							<h2>Connect helper capacity</h2>
							<p>Create managed capacity or attach a provider to an active processing host.</p>
						</div>
					</div>
					<div class="kc-list">
						<div class="kc-list-item">
							<div class="kc-panel__header">
								<div>
									<strong>TreeSeed-managed helper capacity</strong><br />
									<span class="kc-subtle">Creates default lanes, a team allocation, project allocations, and a provider security code.</span>
								</div>
								<button class="kc-button" type="button" data-capacity-managed-launch>Use managed capacity</button>
							</div>
						</div>
						<form class="kc-list-item kc-field" data-capacity-host-backed-form>
							<strong>Host-backed helper capacity</strong>
							<span class="kc-field__help">Select an active processing host. You can create several capacity providers on the same host.</span>
							<div class="kc-form-grid" style="margin-top:0.75rem;">
								<label class="kc-field">
									<span class="kc-field__label">Provider name</span>
									<input class="kc-control" name="name" value={`${context.team?.displayName ?? context.team?.name ?? 'Team'} helper capacity`} required />
								</label>
								<label class="kc-field">
									<span class="kc-field__label">Processing host</span>
									<select class="kc-control" name="processingHostId" required disabled={activeTeamProcessingHosts.length === 0}>
										{activeTeamProcessingHosts.map((host: any) => (
											<option value={host.id}>{host.name} · {host.provider}</option>
										))}
									</select>
								</label>
								<label class="kc-field">
									<span class="kc-field__label">Daily credits</span>
									<input class="kc-control" name="dailyCreditBudget" type="number" min="0" step="1" value="50" required />
								</label>
								<label class="kc-field">
									<span class="kc-field__label">Monthly credits</span>
									<input class="kc-control" name="monthlyCreditBudget" type="number" min="0" step="1" value="1000" required />
								</label>
								<label class="kc-field">
									<span class="kc-field__label">Max workers</span>
									<input class="kc-control" name="maxConcurrentWorkers" type="number" min="1" step="1" value="2" required />
								</label>
							</div>
							<div class="kc-inline-actions" style="margin-top:0.85rem;">
								<button class="kc-button" type="submit" disabled={activeTeamProcessingHosts.length === 0}>Create host-backed provider</button>
								{activeTeamProcessingHosts.length === 0 ? <a class="kc-button-secondary" href={`/app/teams/${teamHandle}/hosts`}>Create processing host</a> : null}
							</div>
						</form>
					</div>
					<span class="kc-subtle" data-capacity-action-status role="status"></span>
					<div class="kc-list-item" data-capacity-secret-panel hidden style="margin-top:1rem;">
						<strong>Provider security code</strong>
						<span class="kc-field__help">Copy this now. TreeSeed will not show the plaintext code again.</span>
						<textarea class="kc-control" data-capacity-secret-output rows="2" readonly></textarea>
					</div>
				</div>
			</section>
			<section class="kc-panel" style="margin-top: 1rem;">
				<div class="kc-panel__header">
					<div>
						<p class="kc-section__eyebrow">Connected providers</p>
						<h2>Provider health, security codes, and allocations</h2>
					</div>
				</div>
				<div class="kc-card-list">
					{capacityDetails.length > 0 ? capacityDetails.map((provider: any) => {
						const lastHealth = provider.metadata?.lastHealth ?? {};
						const activeKey = provider.apiKeys?.find((key: any) => key.status === 'active');
						const processingBinding = provider.hosts?.find((host: any) => host.role === 'processing');
						const processingHost = processingBinding ? processingHostsById.get(processingBinding.hostId) : null;
						const teamGrant = provider.grants?.find((grant: any) => !grant.projectId && grant.grantScope === 'team');
						const allocatedDailyCredits = provider.grants?.filter((grant: any) => grant.state === 'active').reduce((total: number, grant: any) => total + Number(grant.dailyCreditLimit ?? 0), 0) ?? 0;
						return (
							<article class="kc-card">
								<div class="kc-panel__header">
									<div>
										<h2 style="font-size:1.05rem; margin:0;">{provider.name}</h2>
										<p>{provider.provider} · {provider.kind.replaceAll('_', ' ')} · {processingHost ? `host ${processingHost.name}` : 'managed processing'} · security code {activeKey?.keyPrefix ?? provider.metadata?.apiKey?.activeKeyPrefix ?? 'not created'}</p>
									</div>
									<span class="kc-status-pill" data-tone={provider.status === 'active' ? 'success' : provider.status === 'degraded' || provider.status === 'credential_required' ? 'warning' : 'info'}>{provider.status.replaceAll('_', ' ')}</span>
								</div>
								<div class="kc-metric-strip" style="grid-template-columns: repeat(5, minmax(0, 1fr));">
									<div class="kc-metric"><span class="kc-metric__label">Queue</span><span class="kc-metric__value">{lastHealth.queueDepth ?? 0}</span></div>
									<div class="kc-metric"><span class="kc-metric__label">Active workers</span><span class="kc-metric__value">{lastHealth.activeWorkers ?? 0}</span></div>
									<div class="kc-metric"><span class="kc-metric__label">Max workers</span><span class="kc-metric__value">{provider.maxConcurrentWorkers}</span></div>
									<div class="kc-metric"><span class="kc-metric__label">Daily limit</span><span class="kc-metric__value">{provider.dailyCreditBudget ?? 'N/A'}</span></div>
									<div class="kc-metric"><span class="kc-metric__label">Allocated daily</span><span class="kc-metric__value">{allocatedDailyCredits}</span></div>
								</div>
								<div class="kc-card__meta">
									{provider.lanes.length > 0 ? provider.lanes.map((lane: any) => (
										<span>{lane.name}: {lane.scarcityLevel} · {lane.routingPolicy?.repositoryMutationAllowed ? 'repository work' : 'drafting/review'}</span>
									)) : <span>No lanes configured</span>}
								</div>
								<div class="kc-inline-actions">
									<button class="kc-button-secondary" type="button" data-capacity-key-reset={provider.id}>Reset security code</button>
									<span class="kc-subtle">Last health check {lastHealth.checkedAt ?? 'not reported yet'} · last used {activeKey?.lastUsedAt ?? provider.metadata?.apiKey?.lastUsedAt ?? 'never'}</span>
								</div>
								<div class="kc-list" style="margin-top:1rem;">
									<form class="kc-list-item kc-form-grid" data-capacity-grant-form>
										<input type="hidden" name="grantId" value={teamGrant?.id ?? ''} />
										<input type="hidden" name="capacityProviderId" value={provider.id} />
										<input type="hidden" name="grantScope" value="team" />
										<div class="kc-field kc-field--full">
											<strong>Team pooled allocation</strong>
											<span class="kc-field__help">Used after project-specific allocations for this provider.</span>
										</div>
										<label class="kc-field">
											<span class="kc-field__label">Daily credits</span>
											<input class="kc-control" name="dailyCreditLimit" type="number" min="0" step="1" value={teamGrant?.dailyCreditLimit ?? provider.dailyCreditBudget ?? 0} />
										</label>
										<label class="kc-field">
											<span class="kc-field__label">Monthly credits</span>
											<input class="kc-control" name="monthlyCreditLimit" type="number" min="0" step="1" value={teamGrant?.monthlyCreditLimit ?? provider.monthlyCreditBudget ?? 0} />
										</label>
										<label class="kc-field">
											<span class="kc-field__label">Overflow</span>
											<select class="kc-control" name="overflowPolicy">
												{['approval_required', 'deny', 'fallback_lane', 'soft_grant'].map((policy) => (
													<option value={policy} selected={(teamGrant?.overflowPolicy ?? 'approval_required') === policy}>{policy.replaceAll('_', ' ')}</option>
												))}
											</select>
										</label>
										<label class="kc-field">
											<span class="kc-field__label">State</span>
											<select class="kc-control" name="state">
												{['active', 'paused', 'disabled'].map((state) => (
													<option value={state} selected={(teamGrant?.state ?? 'active') === state}>{state}</option>
												))}
											</select>
										</label>
										<div class="kc-inline-actions">
											<button class="kc-button-secondary" type="submit">Save pooled allocation</button>
										</div>
									</form>
									{teamProjects.map((project: any) => {
										const projectGrant = provider.grants?.find((grant: any) => grant.projectId === project.id);
										return (
											<form class="kc-list-item kc-form-grid" data-capacity-grant-form>
												<input type="hidden" name="grantId" value={projectGrant?.id ?? ''} />
												<input type="hidden" name="capacityProviderId" value={provider.id} />
												<input type="hidden" name="projectId" value={project.id} />
												<input type="hidden" name="grantScope" value="project" />
												<div class="kc-field kc-field--full">
													<strong>{project.name}</strong>
													<span class="kc-field__help">Project helper capacity from this provider.</span>
												</div>
												<label class="kc-field">
													<span class="kc-field__label">Lane</span>
													<select class="kc-control" name="laneId">
														<option value="">Any lane</option>
														{provider.lanes.map((lane: any) => (
															<option value={lane.id} selected={projectGrant?.laneId === lane.id}>{lane.name}</option>
														))}
													</select>
												</label>
												<label class="kc-field">
													<span class="kc-field__label">Daily credits</span>
													<input class="kc-control" name="dailyCreditLimit" type="number" min="0" step="1" value={projectGrant?.dailyCreditLimit ?? ''} placeholder="0" />
												</label>
												<label class="kc-field">
													<span class="kc-field__label">Monthly credits</span>
													<input class="kc-control" name="monthlyCreditLimit" type="number" min="0" step="1" value={projectGrant?.monthlyCreditLimit ?? ''} placeholder="0" />
												</label>
												<label class="kc-field">
													<span class="kc-field__label">Overflow</span>
													<select class="kc-control" name="overflowPolicy">
														{['approval_required', 'deny', 'fallback_lane', 'soft_grant'].map((policy) => (
															<option value={policy} selected={(projectGrant?.overflowPolicy ?? 'approval_required') === policy}>{policy.replaceAll('_', ' ')}</option>
														))}
													</select>
												</label>
												<label class="kc-field">
													<span class="kc-field__label">State</span>
													<select class="kc-control" name="state">
														{['active', 'paused', 'disabled'].map((state) => (
															<option value={state} selected={(projectGrant?.state ?? (projectGrant ? 'active' : 'disabled')) === state}>{state}</option>
														))}
													</select>
												</label>
												<div class="kc-inline-actions">
													<button class="kc-button-secondary" type="submit">{projectGrant ? 'Save allocation' : 'Create allocation'}</button>
												</div>
											</form>
										);
									})}
								</div>
							</article>
						);
					}) : <div class="kc-empty">No processing capacity providers have been configured yet.</div>}
				</div>
			</section>
		</>
	) : null}

	{section === 'settings' ? (
		<section class="kc-grid-2">
			<div class="kc-panel">
				<div class="kc-panel__header">
					<div>
						<p class="kc-section__eyebrow">General</p>
						<h2>{context.team?.name}</h2>
					</div>
				</div>
				<div class="kc-list">
					<div class="kc-list-item"><strong>Team name</strong><br />@{context.team?.name}</div>
					<div class="kc-list-item"><strong>Members</strong><br />{members.length}</div>
					<div class="kc-list-item"><strong>Products</strong><br />{products.length}</div>
				</div>
			</div>
			<div class="kc-panel">
				<div class="kc-panel__header">
					<div>
						<p class="kc-section__eyebrow">Capabilities</p>
						<h2>Current MVP defaults</h2>
					</div>
				</div>
				<div class="kc-list">
					<div class="kc-list-item"><strong>Hub visibility</strong><br />Public-ready by default.</div>
					<div class="kc-list-item"><strong>Market publish</strong><br />Always human-approved.</div>
					<div class="kc-list-item"><strong>Repository Host</strong><br />Split software and content repositories are created through the selected repository provider.</div>
				</div>
			</div>
		</section>
	) : null}
</KnowledgeCoopAppLayout>

<script>
	import { decryptHostConfig, encryptHostConfig } from '../../../../lib/cloudflare-host-crypto.js';

	const dataElement = document.getElementById('hosts-page-data') ?? document.getElementById('capacity-page-data');
	const createForms = document.querySelectorAll('[data-host-create-form]') as NodeListOf<HTMLFormElement>;
	const repositoryHostForm = document.getElementById('repository-host-create-form') as HTMLFormElement | null;
		const data = dataElement?.textContent ? JSON.parse(dataElement.textContent) : null;
		const teamId = data?.teamId;
		const hosts = new Map((data?.hosts ?? []).map((host: any) => [host.id, host]));
		const repositoryHosts = new Map((data?.repositoryHosts ?? []).map((host: any) => [host.id, host]));
		const apiHeaders = { 'content-type': 'application/json' };
	const supportedHostProviders = new Map([
		['web', new Set(['cloudflare'])],
		['processing', new Set(['railway'])],
		['email', new Set(['smtp'])],
	]);
	const hostTabs = [...document.querySelectorAll('[data-host-tab]')] as HTMLButtonElement[];
	const hostTabPanels = [...document.querySelectorAll('[data-host-tab-panel]')] as HTMLElement[];
	const supportedTabs = new Set(['repository', 'web', 'processing', 'email']);

	function formString(form: FormData, key: string) {
		return String(form.get(key) ?? '').trim();
	}

	function hostStatusElement(hostType: string) {
		return document.querySelector(`[data-host-status="${CSS.escape(hostType)}"]`);
	}

	function hostConfigKeys(provider: string) {
		if (provider === 'railway') {
			return [
				'RAILWAY_API_TOKEN',
				'TREESEED_RAILWAY_WORKSPACE',
			];
		}
		if (provider === 'smtp') {
			return [
				'SMTP_HOST',
				'SMTP_PORT',
				'SMTP_SECURE',
				'SMTP_USERNAME',
				'SMTP_PASSWORD',
				'SMTP_FROM_EMAIL',
				'SMTP_FROM_NAME',
				'SMTP_REPLY_TO',
				'SMTP_CONNECTION_TIMEOUT_MS',
			];
		}
		return [
			'CLOUDFLARE_API_TOKEN',
			'CLOUDFLARE_ACCOUNT_ID',
		];
	}

	function hostConfigFromForm(form: FormData, provider: string) {
		const keys = hostConfigKeys(provider);
		const config = Object.fromEntries(
			keys
				.map((key) => [key, formString(form, key)])
				.filter(([, value]) => value),
		);
		if (provider === 'railway') {
			config.TREESEED_WORKER_POOL_SCALER = 'railway';
		}
		return config;
	}

		function refreshProviderControls(form: HTMLFormElement) {
			const providerSelect = form.elements.namedItem('provider') as HTMLSelectElement | null;
			if (!providerSelect) return;
		const provider = providerSelect.value;
		for (const panel of form.querySelectorAll('[data-provider-panel]')) {
			const active = (panel as HTMLElement).dataset.providerPanel === provider;
			(panel as HTMLElement).hidden = !active;
			(panel as HTMLElement).setAttribute('aria-hidden', active ? 'false' : 'true');
			(panel as HTMLElement).dataset.providerActive = active ? 'true' : 'false';
			for (const input of panel.querySelectorAll('input, select, textarea')) {
				const control = input as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
				control.disabled = !active;
					control.required = active && control.hasAttribute('data-required-when-active');
				}
			}
			sensitiveUnlock()?.refresh?.();
		}

	function selectHostTab(tabName: string, updateHash = true) {
		const selected = supportedTabs.has(tabName) ? tabName : 'repository';
		for (const tab of hostTabs) {
			const active = tab.dataset.hostTab === selected;
			tab.setAttribute('aria-selected', active ? 'true' : 'false');
			tab.setAttribute('tabindex', active ? '0' : '-1');
			tab.setAttribute('aria-current', active ? 'page' : 'false');
		}
		for (const panel of hostTabPanels) {
			panel.hidden = panel.dataset.hostTabPanel !== selected;
		}
		if (updateHash && window.location.hash !== `#${selected}`) {
			history.replaceState(null, '', `#${selected}`);
		}
	}

	for (const tab of hostTabs) {
		tab.addEventListener('click', () => selectHostTab(tab.dataset.hostTab ?? 'repository'));
	}
	window.addEventListener('hashchange', () => selectHostTab(window.location.hash.slice(1), false));
	selectHostTab(window.location.hash.slice(1) || 'repository', false);

	for (const form of createForms) {
		const providerSelect = form.elements.namedItem('provider') as HTMLSelectElement | null;
		providerSelect?.addEventListener('change', () => refreshProviderControls(form));
		refreshProviderControls(form);
	}

	function setHostStatus(hostType: string, message: string) {
		const statusElement = hostStatusElement(hostType);
		if (statusElement) statusElement.textContent = message;
	}

		function setRepositoryHostStatus(message: string) {
			const repositoryHostStatusElement = hostStatusElement('repository');
			if (repositoryHostStatusElement) repositoryHostStatusElement.textContent = message;
		}

		function sensitiveUnlock() {
			return (window as any).treeseedSensitiveUnlock ?? null;
		}

		function requireSensitivePassphrase(status: (message: string) => void) {
			const passphrase = sensitiveUnlock()?.requirePassphrase?.();
			if (!passphrase) {
				status('Unlock sensitive data from the header before saving or validating provider values.');
				throw new Error('Sensitive data is locked.');
			}
			return String(passphrase);
		}

		async function requestJson(url: string, init: RequestInit) {
			const response = await fetch(url, init);
			const payload = await response.json().catch(() => null);
			if (!response.ok || payload?.ok === false) {
				throw new Error(payload?.error ?? `Request failed with ${response.status}`);
			}
			return payload;
		}

		const capacityStatusElement = document.querySelector('[data-capacity-action-status]');
		const capacitySecretPanel = document.querySelector('[data-capacity-secret-panel]') as HTMLElement | null;
		const capacitySecretOutput = document.querySelector('[data-capacity-secret-output]') as HTMLTextAreaElement | null;
		function setCapacityStatus(message: string) {
			if (capacityStatusElement) capacityStatusElement.textContent = message;
		}
		function showCapacitySecret(value: string | null | undefined) {
			if (!capacitySecretPanel || !capacitySecretOutput || !value) return;
			capacitySecretOutput.value = value;
			capacitySecretPanel.hidden = false;
		}
		function optionalNumber(value: FormDataEntryValue | null) {
			const raw = String(value ?? '').trim();
			if (!raw) return null;
			const number = Number(raw);
			return Number.isFinite(number) ? number : null;
		}

		document.querySelector('[data-capacity-managed-launch]')?.addEventListener('click', async () => {
			if (!teamId) return;
			setCapacityStatus('Connecting TreeSeed-managed helper capacity...');
			try {
				const payload = await requestJson(`/v1/teams/${encodeURIComponent(teamId)}/capacity/providers/managed`, {
					method: 'POST',
					headers: apiHeaders,
					body: JSON.stringify({ launchSource: 'team_capacity_page' }),
				});
				showCapacitySecret(payload?.payload?.plaintextKey);
				setCapacityStatus(payload?.payload?.plaintextKey
					? 'TreeSeed-managed helper capacity is connected. Copy the provider security code, then refresh to see the new provider card.'
					: 'TreeSeed-managed helper capacity is connected. Refresh to see the latest provider card.');
			} catch (error) {
				setCapacityStatus(error instanceof Error ? error.message : String(error));
			}
		});

		document.querySelector('[data-capacity-host-backed-form]')?.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (!teamId) return;
			const form = event.currentTarget as HTMLFormElement;
			const formData = new FormData(form);
			setCapacityStatus('Creating host-backed helper capacity...');
			try {
				const payload = await requestJson(`/v1/teams/${encodeURIComponent(teamId)}/capacity/providers/host-backed`, {
					method: 'POST',
					headers: apiHeaders,
					body: JSON.stringify({
						name: String(formData.get('name') ?? '').trim(),
						processingHostId: String(formData.get('processingHostId') ?? '').trim(),
						dailyCreditBudget: optionalNumber(formData.get('dailyCreditBudget')) ?? 50,
						monthlyCreditBudget: optionalNumber(formData.get('monthlyCreditBudget')) ?? 1000,
						maxConcurrentWorkers: optionalNumber(formData.get('maxConcurrentWorkers')) ?? 2,
						launchSource: 'team_capacity_page',
					}),
				});
				showCapacitySecret(payload?.payload?.plaintextKey);
				setCapacityStatus('Host-backed helper capacity is connected. Copy the provider security code, then refresh to see the new provider card.');
			} catch (error) {
				setCapacityStatus(error instanceof Error ? error.message : String(error));
			}
		});

		for (const form of document.querySelectorAll('[data-capacity-grant-form]')) {
			form.addEventListener('submit', async (event) => {
				event.preventDefault();
				if (!teamId) return;
				const grantForm = event.currentTarget as HTMLFormElement;
				const formData = new FormData(grantForm);
				const grantId = String(formData.get('grantId') ?? '').trim();
				const capacityProviderId = String(formData.get('capacityProviderId') ?? '').trim();
				const projectId = String(formData.get('projectId') ?? '').trim();
				const laneId = String(formData.get('laneId') ?? '').trim();
				const body = {
					capacityProviderId,
					grantScope: String(formData.get('grantScope') ?? (projectId ? 'project' : 'team')),
					teamId,
					projectId: projectId || null,
					laneId: laneId || null,
					state: String(formData.get('state') ?? 'active'),
					dailyCreditLimit: optionalNumber(formData.get('dailyCreditLimit')),
					monthlyCreditLimit: optionalNumber(formData.get('monthlyCreditLimit')),
					overflowPolicy: String(formData.get('overflowPolicy') ?? 'approval_required'),
				};
				setCapacityStatus('Saving helper capacity allocation...');
				try {
					const url = grantId
						? `/v1/teams/${encodeURIComponent(teamId)}/capacity-grants/${encodeURIComponent(grantId)}`
						: `/v1/teams/${encodeURIComponent(teamId)}/capacity-grants`;
					await requestJson(url, {
						method: grantId ? 'PATCH' : 'POST',
						headers: apiHeaders,
						body: JSON.stringify(body),
					});
					setCapacityStatus('Helper capacity allocation saved.');
					window.location.reload();
				} catch (error) {
					setCapacityStatus(error instanceof Error ? error.message : String(error));
				}
			});
		}

		for (const button of document.querySelectorAll('[data-capacity-key-reset]')) {
			button.addEventListener('click', async () => {
				if (!teamId) return;
				const providerId = (button as HTMLElement).dataset.capacityKeyReset;
				if (!providerId) return;
				setCapacityStatus('Resetting provider security code...');
				try {
					const payload = await requestJson(`/v1/capacity/providers/${encodeURIComponent(providerId)}/api-keys/reset`, {
						method: 'POST',
						headers: apiHeaders,
						body: JSON.stringify({ name: 'Provider security code' }),
					});
					const prefix = payload?.payload?.key?.keyPrefix ?? 'new code';
					showCapacitySecret(payload?.payload?.plaintextKey);
					setCapacityStatus(`Provider security code was reset. Prefix: ${prefix}. Copy the new code and update the runner before it can process more work.`);
				} catch (error) {
					setCapacityStatus(error instanceof Error ? error.message : String(error));
				}
			});
		}

		async function resetTeamSensitiveData({ currentPassphrase, newPassphrase }: { currentPassphrase: string; newPassphrase: string }) {
			if (!teamId) throw new Error('Team context is missing.');
			const hostUpdates = [];
			for (const host of (data?.hosts ?? [])) {
				if (host.ownership !== 'team_owned' || !host.encryptedPayload) continue;
				const decryptedConfig = await decryptHostConfig(host.encryptedPayload, currentPassphrase);
				const encryptedPayload = await encryptHostConfig(decryptedConfig, newPassphrase);
				hostUpdates.push({ host, encryptedPayload });
			}
			const repositoryHostUpdates = [];
			for (const host of (data?.repositoryHosts ?? [])) {
				if (host.ownership !== 'team_owned' || !host.encryptedPayload) continue;
				const decryptedConfig = await decryptHostConfig(host.encryptedPayload, currentPassphrase);
				const encryptedPayload = await encryptHostConfig(decryptedConfig, newPassphrase);
				repositoryHostUpdates.push({ host, encryptedPayload });
			}
			for (const { host, encryptedPayload } of hostUpdates) {
				const payload = await requestJson(`/v1/teams/${encodeURIComponent(teamId)}/hosts/${encodeURIComponent(host.id)}`, {
					method: 'PUT',
					headers: apiHeaders,
					body: JSON.stringify({
						name: host.name,
						accountLabel: host.accountLabel ?? null,
						provider: host.provider,
						ownership: 'team_owned',
						allowedEnvironments: host.allowedEnvironments ?? ['staging', 'prod'],
						encryptedPayload,
						metadata: host.metadata ?? {},
					}),
				});
				host.encryptedPayload = payload?.payload?.encryptedPayload ?? encryptedPayload;
				hosts.set(host.id, { ...host, encryptedPayload: host.encryptedPayload });
			}
			for (const { host, encryptedPayload } of repositoryHostUpdates) {
				const payload = await requestJson(`/v1/teams/${encodeURIComponent(teamId)}/repository-hosts/${encodeURIComponent(host.id)}`, {
					method: 'PUT',
					headers: apiHeaders,
					body: JSON.stringify({
						name: host.name,
						accountLabel: host.accountLabel ?? host.organizationOrOwner,
						ownership: 'team_owned',
						organizationOrOwner: host.organizationOrOwner,
						defaultVisibility: host.defaultVisibility ?? 'private',
						softwareRepositoryNameTemplate: host.softwareRepositoryNameTemplate ?? '{hub}-site',
						contentRepositoryNameTemplate: host.contentRepositoryNameTemplate ?? '{hub}-content',
						encryptedPayload,
						metadata: host.metadata ?? {},
					}),
				});
				host.encryptedPayload = payload?.payload?.encryptedPayload ?? encryptedPayload;
				repositoryHosts.set(host.id, { ...host, encryptedPayload: host.encryptedPayload });
			}
			const count = hostUpdates.length + repositoryHostUpdates.length;
			setHostStatus('web', count > 0 ? 'Sensitive host values were re-encrypted.' : '');
			setHostStatus('processing', count > 0 ? 'Sensitive host values were re-encrypted.' : '');
			setHostStatus('email', count > 0 ? 'Sensitive host values were re-encrypted.' : '');
			setRepositoryHostStatus(count > 0 ? 'Sensitive Repository Host values were re-encrypted.' : 'No saved team-owned host credentials need reset.');
		}

		sensitiveUnlock()?.registerResetHandler?.(resetTeamSensitiveData);

	for (const createForm of createForms) {
			createForm.addEventListener('submit', async (event) => {
				event.preventDefault();
				if (!teamId) return;
				const form = new FormData(createForm);
				const hostType = createForm.dataset.hostType ?? 'web';
				const provider = formString(form, 'provider') || (hostType === 'processing' ? 'railway' : hostType === 'email' ? 'smtp' : 'cloudflare');
				if (!supportedHostProviders.get(hostType)?.has(provider)) {
					setHostStatus(hostType, 'This host provider is not supported yet.');
					return;
				}
				setHostStatus(hostType, `Encrypting ${hostType} host...`);
				try {
					const passphrase = requireSensitivePassphrase((message) => setHostStatus(hostType, message));
					const hostConfig = hostConfigFromForm(form, provider);
					const encryptedPayload = await encryptHostConfig(hostConfig, passphrase);
				await requestJson(`/v1/teams/${encodeURIComponent(teamId)}/hosts`, {
					method: 'POST',
					headers: apiHeaders,
					body: JSON.stringify({
						name: formString(form, 'name'),
						accountLabel: formString(form, 'accountLabel') || null,
						provider,
						ownership: 'team_owned',
						allowedEnvironments: ['staging', 'prod'],
						encryptedPayload,
						metadata: { hostType, configuredKeys: Object.keys(hostConfig).sort() },
					}),
				});
				setHostStatus(hostType, `${hostType === 'processing' ? 'Processing' : hostType === 'email' ? 'Email' : 'Web'} Host saved. Reloading...`);
				window.location.reload();
			} catch (error) {
				setHostStatus(hostType, error instanceof Error ? error.message : String(error));
			}
		});
	}

	repositoryHostForm?.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (!teamId) return;
			const form = new FormData(repositoryHostForm);
			const organizationOrOwner = formString(form, 'organizationOrOwner');
			const token = formString(form, 'GITHUB_TOKEN');
			if (!organizationOrOwner || !token) {
				setRepositoryHostStatus('Owner and token are required.');
				return;
			}
			setRepositoryHostStatus('Encrypting Repository Host...');
			try {
				const passphrase = requireSensitivePassphrase(setRepositoryHostStatus);
				const encryptedPayload = await encryptHostConfig({
					GITHUB_TOKEN: token,
				GH_TOKEN: token,
				organizationOrOwner,
			}, passphrase);
			await requestJson(`/v1/teams/${encodeURIComponent(teamId)}/repository-hosts`, {
				method: 'POST',
				headers: apiHeaders,
				body: JSON.stringify({
					name: formString(form, 'name'),
					accountLabel: formString(form, 'accountLabel') || organizationOrOwner,
					ownership: 'team_owned',
					organizationOrOwner,
					defaultVisibility: formString(form, 'defaultVisibility') || 'private',
					softwareRepositoryNameTemplate: formString(form, 'softwareRepositoryNameTemplate') || '{hub}-site',
					contentRepositoryNameTemplate: formString(form, 'contentRepositoryNameTemplate') || '{hub}-content',
					encryptedPayload,
					metadata: { credentialStatus: 'encrypted credentials', configuredKeys: ['GH_TOKEN', 'GITHUB_TOKEN', 'organizationOrOwner'] },
				}),
			});
			setRepositoryHostStatus('Repository Host saved. Reloading...');
			window.location.reload();
		} catch (error) {
			setRepositoryHostStatus(error instanceof Error ? error.message : String(error));
		}
	});

		for (const button of document.querySelectorAll('[data-host-validate]')) {
				button.addEventListener('click', async () => {
					const hostId = (button as HTMLElement).dataset.hostValidate ?? '';
					const hostType = (button as HTMLElement).closest('[data-host-tab-panel]')?.getAttribute('data-host-tab-panel') ?? 'web';
					setHostStatus(hostType, 'Validating host...');
				try {
					const passphrase = requireSensitivePassphrase((message) => setHostStatus(hostType, message));
					await requestJson(`/v1/teams/${encodeURIComponent(teamId)}/provider-credential-sessions`, {
						method: 'POST',
						headers: apiHeaders,
							body: JSON.stringify({
								hostKind: hostType === 'processing' ? 'processing_host' : hostType === 'email' ? 'email_host' : 'web_host',
								hostId,
							passphrase,
							purpose: `${hostType}_host_validation`,
							expiresInSeconds: 300,
						}),
					});
					setHostStatus(hostType, 'Host credentials unlocked into a short-lived validation session.');
				} catch (error) {
					if ((error as Error)?.message === 'Sensitive data is locked.') return;
					setHostStatus(hostType, error instanceof Error ? error.message : String(error));
				}
			});
	}

	for (const button of document.querySelectorAll('[data-host-delete]')) {
		button.addEventListener('click', async () => {
			const hostId = (button as HTMLElement).dataset.hostDelete ?? '';
			const hostType = (button as HTMLElement).closest('[data-host-tab-panel]')?.getAttribute('data-host-tab-panel') ?? 'web';
			if (!hostId || !window.confirm('Delete this host?')) return;
			setHostStatus(hostType, 'Deleting host...');
			try {
				await requestJson(`/v1/teams/${encodeURIComponent(teamId)}/hosts/${encodeURIComponent(hostId)}`, {
					method: 'DELETE',
				});
				window.location.reload();
			} catch (error) {
				setHostStatus(hostType, error instanceof Error ? error.message : String(error));
			}
		});
	}

		for (const button of document.querySelectorAll('[data-repository-host-validate]')) {
			button.addEventListener('click', async () => {
				const hostId = (button as HTMLElement).dataset.repositoryHostValidate ?? '';
				setRepositoryHostStatus('Unlocking Repository Host...');
				try {
					const passphrase = requireSensitivePassphrase(setRepositoryHostStatus);
					await requestJson(`/v1/teams/${encodeURIComponent(teamId)}/provider-credential-sessions`, {
					method: 'POST',
					headers: apiHeaders,
					body: JSON.stringify({
						hostKind: 'repository_host',
						hostId,
						passphrase,
						purpose: 'repository_host_validation',
						expiresInSeconds: 300,
					}),
					});
					setRepositoryHostStatus('Repository Host unlocked into a short-lived server session.');
				} catch (error) {
					if ((error as Error)?.message === 'Sensitive data is locked.') return;
					setRepositoryHostStatus(error instanceof Error ? error.message : String(error));
				}
			});
		}

	for (const button of document.querySelectorAll('[data-repository-host-delete]')) {
		button.addEventListener('click', async () => {
			const hostId = (button as HTMLElement).dataset.repositoryHostDelete ?? '';
			if (!hostId || !window.confirm('Delete this Repository Host?')) return;
			setRepositoryHostStatus('Deleting Repository Host...');
			try {
				await requestJson(`/v1/teams/${encodeURIComponent(teamId)}/repository-hosts/${encodeURIComponent(hostId)}`, {
					method: 'DELETE',
				});
				window.location.reload();
			} catch (error) {
				setRepositoryHostStatus(error instanceof Error ? error.message : String(error));
			}
		});
	}
</script>
