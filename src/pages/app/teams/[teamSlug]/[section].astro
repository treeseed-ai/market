---
import TeamCapacityView from '../../../../components/app/team/TeamCapacityView.astro';
import TeamHomeView from '../../../../components/app/team/TeamHomeView.astro';
import TeamHostsView from '../../../../components/app/team/TeamHostsView.astro';
import TeamInboxView from '../../../../components/app/team/TeamInboxView.astro';
import TeamMembersView from '../../../../components/app/team/TeamMembersView.astro';
import TeamProductsView from '../../../../components/app/team/TeamProductsView.astro';
import TeamSettingsView from '../../../../components/app/team/TeamSettingsView.astro';
import TreeseedAppLayout from '../../../../layouts/TreeseedAppLayout.astro';
import { loadTeamAppContext } from '../../../../lib/market/app-data.js';
import { loadTeamSectionData, teamSectionTitles } from '../../../../lib/market/team-section-data.js';

const section = Astro.params.section ?? 'home';
if (section === 'web-hosts') {
	return Astro.redirect(`/app/teams/${encodeURIComponent(Astro.params.teamSlug ?? '')}/hosts`);
}
const sectionComponents = {
	home: TeamHomeView,
	inbox: TeamInboxView,
	members: TeamMembersView,
	products: TeamProductsView,
	hosts: TeamHostsView,
	capacity: TeamCapacityView,
	settings: TeamSettingsView,
};
const SectionView = (sectionComponents as Record<string, any>)[section] ?? null;
if (!SectionView) {
	Astro.response.status = 404;
}

if (!Astro.locals.auth?.principal) {
	return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
}

const context = await loadTeamAppContext(Astro.locals, Astro.params.teamSlug ?? '');
const teamHandle = context.team?.name ?? context.team?.slug ?? '';
if (!context.team || !context.store) {
	Astro.response.status = 404;
}

const sectionData = await loadTeamSectionData(context, Astro.locals);
const currentSectionTitle = (teamSectionTitles as Record<string, string>)[section] ?? 'Team';
---

<TreeseedAppLayout
	title={`${context.team?.displayName ?? context.team?.name ?? 'Team'} · ${currentSectionTitle}`}
	description="Operate projects, releases, market listings, and approvals from the same cooperative control plane."
	currentPath={Astro.url.pathname}
	teams={context.teams}
	activeTeam={context.team}
>
	{SectionView ? <SectionView context={context} teamHandle={teamHandle} {...sectionData} /> : null}
</TreeseedAppLayout>
