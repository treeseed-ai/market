---
import MetricGrid from '../../../../packages/core/src/components/ui/data/MetricGrid.astro';
import EmptyState from '../../../../packages/core/src/components/ui/surface/EmptyState.astro';
import Panel from '../../../../packages/core/src/components/ui/surface/Panel.astro';
import WorkdaySummaryCard from '../../../components/app/operations/WorkdaySummaryCard.astro';
import TreeseedAppLayout from '../../../layouts/TreeseedAppLayout.astro';
import { loadWorkdayListViewModel } from '../../../view-models/workday.vm.js';

if (!Astro.locals.auth?.principal) {
	return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent('/app/workdays')}`);
}

const vm = await loadWorkdayListViewModel(Astro.locals);
---

<TreeseedAppLayout
	title="Workdays"
	description="The operational coordination record for objectives, execution, governance, and generated knowledge."
	currentPath={Astro.url.pathname}
	teams={vm.context.teams}
	activeTeam={vm.context.activeTeam}
>
	<MetricGrid metrics={vm.metrics} min="10rem" />
	<Panel eyebrow="Workdays" title="Operational work" description="Each workday connects objective intake, repository context, execution, approval, and knowledge output.">
		<div class="ts-card-list">
			{vm.workdays.length > 0 ? vm.workdays.map((workday) => (
				<WorkdaySummaryCard workday={workday} />
			)) : <EmptyState title="No workdays recorded" description="Workdays will appear after an objective is queued or a runner reports operational progress." />}
		</div>
	</Panel>
</TreeseedAppLayout>
