---
import ActionList from '../../../../packages/core/src/components/ui/data/ActionList.astro';
import KeyValueList from '../../../../packages/core/src/components/ui/data/KeyValueList.astro';
import Badge from '../../../../packages/core/src/components/ui/data/Badge.astro';
import EmptyState from '../../../../packages/core/src/components/ui/surface/EmptyState.astro';
import Panel from '../../../../packages/core/src/components/ui/surface/Panel.astro';
import GovernancePanel from '../../../components/app/operations/GovernancePanel.astro';
import KnowledgeArtifactCard from '../../../components/app/operations/KnowledgeArtifactCard.astro';
import OperationalTimeline from '../../../components/app/operations/OperationalTimeline.astro';
import RepositoryContextPanel from '../../../components/app/operations/RepositoryContextPanel.astro';
import TreeseedAppLayout from '../../../layouts/TreeseedAppLayout.astro';
import { loadWorkdayDetailViewModel } from '../../../view-models/workday.vm.js';

const workdayId = String(Astro.params.workdayId ?? '');
if (!Astro.locals.auth?.principal) {
	return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
}

const vm = await loadWorkdayDetailViewModel(Astro.locals, workdayId);
if (!vm.workday) {
	Astro.response.status = 404;
}
---

<TreeseedAppLayout
	title={vm.workday?.objective ?? 'Workday not found'}
	description="Operational timeline, artifacts, repository context, governance, and knowledge outputs."
	currentPath={Astro.url.pathname}
	teams={vm.context.teams}
	activeTeam={vm.context.activeTeam}
>
	{vm.workday ? (
		<>
			<Panel eyebrow={vm.workday.projectName} title={vm.workday.objective} description="Single operational record for coordinated work.">
				<Badge slot="actions" tone={vm.workday.tone ?? 'default'}>{vm.workday.state}</Badge>
				<KeyValueList items={[
					{ key: 'Repository context', value: vm.workday.projectName },
					{ key: 'Environment', value: vm.workday.environment },
					{ key: 'Current phase', value: vm.workday.currentPhase ?? vm.workday.state },
					{ key: 'Risk classification', value: vm.workday.riskClassification ?? 'Unclassified' },
					{ key: 'Budget', value: `${vm.workday.budget?.capacityUsed ?? 0} / ${vm.workday.budget?.capacityBudget ?? 0} credits` },
					{ key: 'Started', value: vm.workday.startedAt ?? 'not recorded' },
					{ key: 'Updated', value: vm.workday.updatedAt ?? 'not recorded' },
				]} />
			</Panel>

			<section class="ts-workday-phase-strip ts-stack-top" aria-label="Workday phases">
				{vm.phases.map((phase) => (
					<article class="ts-workday-phase-strip__item">
						<div>
							<p>{phase.label}</p>
							<strong>{phase.eventCount} event{phase.eventCount === 1 ? '' : 's'}</strong>
						</div>
						<Badge tone={phase.tone ?? 'default'} size="sm">{phase.state}</Badge>
					</article>
				))}
			</section>

			<div id="workday-report-timeline" class="ts-stack-top">
			<Panel eyebrow="Execution Timeline" title="Operational timeline" description="Research, implementation, verification, governance, and knowledge output in one trace.">
				<OperationalTimeline events={vm.timeline} phases={vm.phases} />
			</Panel>
			</div>

			<section class="ts-operational-grid ts-stack-top">
				<Panel eyebrow="Artifacts" title="Operational artifacts" description="Generated outputs are normalized by type and linked back to this workday.">
					<ActionList items={vm.artifacts.map((artifact) => ({
						title: artifact.title,
						description: artifact.description,
						href: artifact.href,
						meta: `${artifact.type} - ${artifact.state}`,
						tone: artifact.tone,
						actionLabel: artifact.href ? 'Open' : undefined,
					}))}>
						<p class="ts-empty-inline">No artifacts are attached to this workday yet.</p>
					</ActionList>
				</Panel>

				<RepositoryContextPanel repositories={vm.repositoryContext} />
			</section>

			<section class="ts-operational-grid ts-stack-top">
				<GovernancePanel title="Governance for this workday" items={vm.governance} />
				<Panel eyebrow="Knowledge Outputs" title="Produced knowledge" description="Institutional memory generated from operational work.">
					<div class="ts-card-list">
						{vm.knowledgeOutputs.length > 0 ? vm.knowledgeOutputs.map((artifact) => (
							<KnowledgeArtifactCard artifact={artifact} />
						)) : <EmptyState title="No knowledge outputs yet" description="Reports, release notes, and knowledge entries will appear after generation or publication." />}
					</div>
				</Panel>
			</section>

			<Panel eyebrow="Capacity" title="Operational capacity trace" description="Budget and routing signals recorded for this workday.">
				<KeyValueList items={[
					{ key: 'Credits used', value: String(vm.capacity?.totalCredits ?? 0) },
					{ key: 'Estimated cost', value: `$${Number(vm.capacity?.totalUsd ?? 0).toFixed(2)}` },
					{ key: 'Routing decisions', value: String(vm.capacity?.routingDecisionCount ?? 0) },
					{ key: 'Readiness', value: vm.capacity?.summary?.readiness ?? 'not recorded' },
				]} />
			</Panel>
		</>
	) : (
		<EmptyState title="Workday not found" description="This workday is not available in the current operational context." actions={[{ label: 'Back to Workdays', href: '/app/workdays' }]} />
	)}
</TreeseedAppLayout>
