---
import Panel from '../../../../packages/core/src/components/ui/surface/Panel.astro';
import PlainTable from '../../../components/app/controls/PlainTable.astro';
import TreeseedAppLayout from '../../../layouts/TreeseedAppLayout.astro';
import { loadOperationalContext } from '../../../view-models/shared.js';

if (!Astro.locals.auth?.principal) {
	return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent('/app/hosts/new')}`);
}
const context = await loadOperationalContext(Astro.locals, Astro);
const rows = [
	{ type: '<strong>Repository</strong><span>GitHub organization or owner.</span>', action: '<a class="ts-link-button" href="/app/hosts/repository/new">Create repository host</a>' },
	{ type: '<strong>Web</strong><span>Cloudflare hosting account.</span>', action: '<a class="ts-link-button" href="/app/hosts/web/new">Create web host</a>' },
	{ type: '<strong>Processing</strong><span>Railway processing workspace.</span>', action: '<a class="ts-link-button" href="/app/hosts/processing/new">Create processing host</a>' },
	{ type: '<strong>Email</strong><span>SMTP account.</span>', action: '<a class="ts-link-button" href="/app/hosts/email/new">Create email host</a>' },
	{ type: '<strong>AI</strong><span>OpenAI, Copilot, OpenRouter, or custom model access.</span>', action: '<a class="ts-link-button" href="/app/hosts/ai/new">Create AI host</a>' },
];
---

<TreeseedAppLayout title="New host" description="Choose one host type." currentPath="/app/hosts" teams={context.teams} activeTeam={context.activeTeam}>
	<section class="ts-control-page" aria-label="New host">
		<Panel eyebrow="Hosts" title="Choose host type" description="Each host type has its own named credential fields.">
			<PlainTable columns={[{ key: 'type', label: 'Host type' }, { key: 'action', label: 'Action' }]} rows={rows} />
		</Panel>
	</section>
</TreeseedAppLayout>
