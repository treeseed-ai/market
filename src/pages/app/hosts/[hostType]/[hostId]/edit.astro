---
import Button from '../../../../../../packages/core/src/components/ui/forms/Button.astro';
import Field from '../../../../../../packages/core/src/components/ui/forms/Field.astro';
import FormActions from '../../../../../../packages/core/src/components/ui/forms/FormActions.astro';
import Select from '../../../../../../packages/core/src/components/ui/forms/Select.astro';
import TextInput from '../../../../../../packages/core/src/components/ui/forms/TextInput.astro';
import EmptyState from '../../../../../../packages/core/src/components/ui/surface/EmptyState.astro';
import Panel from '../../../../../../packages/core/src/components/ui/surface/Panel.astro';
import TreeseedAppLayout from '../../../../../layouts/TreeseedAppLayout.astro';
import { hostProviderFor, hostTypeFor } from '../../../../../lib/market/control-ui.js';
import { loadOperationalContext } from '../../../../../view-models/shared.js';

const hostType = String(Astro.params.hostType ?? '');
const hostId = String(Astro.params.hostId ?? '');
const validTypes = new Set(['repository', 'web', 'processing', 'email', 'ai']);
if (!Astro.locals.auth?.principal) {
	return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
}
const context = await loadOperationalContext(Astro.locals, Astro);
const team = context.activeTeam;
let host: any = null;
if (team && context.store && validTypes.has(hostType)) {
	host = hostType === 'repository'
		? await context.store.getRepositoryHost(team.id, hostId).catch(() => null)
		: await context.store.getTeamWebHost(team.id, hostId).catch(() => null);
}
if (host && hostType !== 'repository' && hostTypeFor(host) !== hostType) host = null;
if (!host) Astro.response.status = 404;
const provider = host?.provider ?? hostProviderFor(hostType);
const data = JSON.stringify({ teamId: team?.id ?? null, hostType, hostId, provider }).replace(/</gu, '\\u003c');
---

<TreeseedAppLayout title={host ? `Edit ${host.name}` : 'Host not found'} description="Edit one host configuration." currentPath="/app/hosts" teams={context.teams} activeTeam={team}>
	{host ? (
		<section class="ts-control-page" aria-label="Edit host">
			<Panel eyebrow="Hosts" title="Edit host" description="Leave credential fields blank unless you are replacing sensitive values.">
				<form id="host-edit-form" class="ts-form-stack">
					<div class="ts-form-grid">
						<Field label="Name" name="name" required><TextInput name="name" required value={host.name ?? ''} /></Field>
						<Field label="Account label" name="accountLabel"><TextInput name="accountLabel" value={host.accountLabel ?? ''} /></Field>
						{hostType === 'repository' && (
							<>
								<Field label="GitHub owner or organization" name="organizationOrOwner" required><TextInput name="organizationOrOwner" required value={host.organizationOrOwner ?? ''} /></Field>
								<Field label="Default visibility" name="defaultVisibility"><Select name="defaultVisibility" options={[{ label: 'Private', value: 'private' }, { label: 'Public', value: 'public' }]} value={host.defaultVisibility ?? 'private'} /></Field>
								<Field label="Software repository name template" name="softwareRepositoryNameTemplate"><TextInput name="softwareRepositoryNameTemplate" value={host.softwareRepositoryNameTemplate ?? '{hub}-site'} /></Field>
								<Field label="Content repository name template" name="contentRepositoryNameTemplate"><TextInput name="contentRepositoryNameTemplate" value={host.contentRepositoryNameTemplate ?? '{hub}-content'} /></Field>
								<Field label="Default branch" name="defaultBranch"><TextInput name="defaultBranch" value={host.branchPolicy?.defaultBranch ?? 'main'} /></Field>
								<Field label="New GitHub token" name="githubToken"><TextInput name="githubToken" type="password" autocomplete="new-password" /></Field>
							</>
						)}
						{hostType !== 'repository' && (
							<>
								<Field label="Provider" name="provider" required>
									<Select name="provider" required value={provider} options={hostType === 'ai'
										? [
												{ label: 'OpenAI', value: 'openai' },
												{ label: 'GitHub Copilot', value: 'github_copilot' },
												{ label: 'OpenRouter', value: 'openrouter' },
												{ label: 'Custom', value: 'custom' },
											]
										: [{ label: provider, value: provider }]} />
								</Field>
								<Field label="Status" name="status"><Select name="status" value={host.status ?? 'active'} options={[{ label: 'Active', value: 'active' }, { label: 'Paused', value: 'paused' }]} /></Field>
							</>
						)}
						{hostType === 'web' && (
							<>
								<Field label="New Cloudflare account ID" name="cloudflareAccountId"><TextInput name="cloudflareAccountId" /></Field>
								<Field label="New Cloudflare API token" name="cloudflareApiToken"><TextInput name="cloudflareApiToken" type="password" autocomplete="new-password" /></Field>
							</>
						)}
						{hostType === 'processing' && (
							<>
								<Field label="New Railway API token" name="railwayApiToken"><TextInput name="railwayApiToken" type="password" autocomplete="new-password" /></Field>
								<Field label="New Railway workspace" name="railwayWorkspace"><TextInput name="railwayWorkspace" /></Field>
							</>
						)}
						{hostType === 'email' && (
							<>
								<Field label="New SMTP host" name="smtpHost"><TextInput name="smtpHost" /></Field>
								<Field label="New SMTP port" name="smtpPort"><TextInput name="smtpPort" type="number" /></Field>
								<Field label="New SMTP username" name="smtpUsername"><TextInput name="smtpUsername" /></Field>
								<Field label="New SMTP password" name="smtpPassword"><TextInput name="smtpPassword" type="password" autocomplete="new-password" /></Field>
								<Field label="New from email" name="smtpFromEmail"><TextInput name="smtpFromEmail" type="email" /></Field>
								<Field label="New reply-to email" name="smtpReplyTo"><TextInput name="smtpReplyTo" type="email" /></Field>
								<Field label="New secure mode" name="smtpSecure"><Select name="smtpSecure" options={[{ label: 'Keep existing', value: '' }, { label: 'STARTTLS', value: 'false' }, { label: 'TLS', value: 'true' }]} /></Field>
							</>
						)}
						{hostType === 'ai' && (
							<>
								<Field label="New API key" name="aiApiKey"><TextInput name="aiApiKey" type="password" autocomplete="new-password" /></Field>
								<Field label="New base URL" name="aiBaseUrl"><TextInput name="aiBaseUrl" type="url" /></Field>
								<Field label="New default model" name="aiDefaultModel"><TextInput name="aiDefaultModel" /></Field>
							</>
						)}
					</div>
					<FormActions align="start">
						<Button type="submit">Save host</Button>
						<Button href="/app/hosts" variant="secondary">Back</Button>
						<button class="ts-button" data-variant="danger" type="button" id="delete-host-button">Delete host</button>
						<span class="ts-subtle" id="host-edit-status" role="status"></span>
					</FormActions>
				</form>
			</Panel>
		</section>
	) : (
		<EmptyState title="Host not found" description="This host is not available to the active team." actions={[{ label: 'Back to hosts', href: '/app/hosts' }]} />
	)}
	<script is:inline type="application/json" id="host-edit-data" set:html={data}></script>
</TreeseedAppLayout>

<script>
	import { encryptHostConfig } from '../../../../../lib/cloudflare-host-crypto.js';
	const dataElement = document.getElementById('host-edit-data');
	const pageData = dataElement?.textContent ? JSON.parse(dataElement.textContent) : {};
	const form = document.getElementById('host-edit-form') as HTMLFormElement | null;
	const status = document.getElementById('host-edit-status');
	const deleteButton = document.getElementById('delete-host-button') as HTMLButtonElement | null;
	function value(formData: FormData, key: string) { return String(formData.get(key) ?? '').trim(); }
	function hasReplacementCredentials(formData: FormData) {
		return ['githubToken', 'cloudflareAccountId', 'cloudflareApiToken', 'railwayApiToken', 'railwayWorkspace', 'smtpHost', 'smtpPort', 'smtpUsername', 'smtpPassword', 'smtpFromEmail', 'smtpReplyTo', 'smtpSecure', 'aiApiKey', 'aiBaseUrl', 'aiDefaultModel'].some((key) => value(formData, key));
	}
	function credentialConfig(formData: FormData, hostType: string) {
		if (hostType === 'repository') {
			const token = value(formData, 'githubToken');
			return { GH_TOKEN: token, GITHUB_TOKEN: token, organizationOrOwner: value(formData, 'organizationOrOwner'), owner: value(formData, 'organizationOrOwner') };
		}
		if (hostType === 'web') return { CLOUDFLARE_ACCOUNT_ID: value(formData, 'cloudflareAccountId'), CLOUDFLARE_API_TOKEN: value(formData, 'cloudflareApiToken') };
		if (hostType === 'processing') return { RAILWAY_API_TOKEN: value(formData, 'railwayApiToken'), TREESEED_RAILWAY_WORKSPACE: value(formData, 'railwayWorkspace') };
		if (hostType === 'email') return { SMTP_HOST: value(formData, 'smtpHost'), SMTP_PORT: value(formData, 'smtpPort'), SMTP_USERNAME: value(formData, 'smtpUsername'), SMTP_PASSWORD: value(formData, 'smtpPassword'), SMTP_FROM_EMAIL: value(formData, 'smtpFromEmail'), SMTP_REPLY_TO: value(formData, 'smtpReplyTo'), SMTP_SECURE: value(formData, 'smtpSecure') };
		return { AI_API_KEY: value(formData, 'aiApiKey'), AI_BASE_URL: value(formData, 'aiBaseUrl'), AI_DEFAULT_MODEL: value(formData, 'aiDefaultModel'), AI_PROVIDER: value(formData, 'provider') };
	}
	async function submitJson(url: string, method: string, body?: any) {
		const response = await fetch(url, { method, headers: { 'content-type': 'application/json' }, body: body ? JSON.stringify(body) : undefined });
		const payload = await response.json().catch(() => null);
		if (!response.ok || payload?.ok === false) throw new Error(payload?.error ?? 'Request failed.');
		return payload.payload;
	}
	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const formData = new FormData(form);
		const body: any = {
			name: value(formData, 'name'),
			accountLabel: value(formData, 'accountLabel'),
		};
		if (hasReplacementCredentials(formData)) {
			const passphrase = (window as any).treeseedSensitiveUnlock?.requirePassphrase?.();
			if (!passphrase) {
				if (status) status.textContent = 'Unlock sensitive data before replacing credentials.';
				return;
			}
			body.encryptedPayload = await encryptHostConfig(credentialConfig(formData, pageData.hostType), String(passphrase));
		}
		if (pageData.hostType === 'repository') {
			Object.assign(body, {
				organizationOrOwner: value(formData, 'organizationOrOwner'),
				defaultVisibility: value(formData, 'defaultVisibility') || 'private',
				softwareRepositoryNameTemplate: value(formData, 'softwareRepositoryNameTemplate') || '{hub}-site',
				contentRepositoryNameTemplate: value(formData, 'contentRepositoryNameTemplate') || '{hub}-content',
				branchPolicy: { defaultBranch: value(formData, 'defaultBranch') || 'main' },
				workflowPolicy: {},
				allowedProjectKinds: ['knowledge_hub'],
				ownership: 'team_owned',
			});
		} else {
			Object.assign(body, {
				provider: value(formData, 'provider') || pageData.provider,
				ownership: 'team_owned',
				status: value(formData, 'status') || 'active',
				metadata: { hostType: pageData.hostType },
			});
		}
		if (status) status.textContent = 'Saving...';
		try {
			const endpoint = pageData.hostType === 'repository'
				? `/v1/teams/${encodeURIComponent(pageData.teamId)}/repository-hosts/${encodeURIComponent(pageData.hostId)}`
				: `/v1/teams/${encodeURIComponent(pageData.teamId)}/hosts/${encodeURIComponent(pageData.hostId)}`;
			await submitJson(endpoint, 'PUT', body);
			if (status) status.textContent = 'Saved.';
		} catch (error) {
			if (status) status.textContent = error instanceof Error ? error.message : 'Host could not be saved.';
		}
	});
	deleteButton?.addEventListener('click', async () => {
		if (status) status.textContent = 'Deleting...';
		try {
			const endpoint = pageData.hostType === 'repository'
				? `/v1/teams/${encodeURIComponent(pageData.teamId)}/repository-hosts/${encodeURIComponent(pageData.hostId)}`
				: `/v1/teams/${encodeURIComponent(pageData.teamId)}/hosts/${encodeURIComponent(pageData.hostId)}`;
			await submitJson(endpoint, 'DELETE');
			window.location.href = '/app/hosts';
		} catch (error) {
			if (status) status.textContent = error instanceof Error ? error.message : 'Host could not be deleted.';
		}
	});
</script>
