---
import ActionList from '../../../../../packages/core/src/components/ui/data/ActionList.astro';
import Badge from '../../../../../packages/core/src/components/ui/data/Badge.astro';
import KeyValueList from '../../../../../packages/core/src/components/ui/data/KeyValueList.astro';
import EmptyState from '../../../../../packages/core/src/components/ui/surface/EmptyState.astro';
import Panel from '../../../../../packages/core/src/components/ui/surface/Panel.astro';
import OperationalTimeline from '../../../../components/app/operations/OperationalTimeline.astro';
import RepositoryContextPanel from '../../../../components/app/operations/RepositoryContextPanel.astro';
import TreeseedAppLayout from '../../../../layouts/TreeseedAppLayout.astro';
import { loadKnowledgeArtifactViewModel } from '../../../../view-models/knowledge.vm.js';

const slug = String(Astro.params.slug ?? '');
if (!Astro.locals.auth?.principal) {
	return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
}

const vm = await loadKnowledgeArtifactViewModel(Astro.locals, slug);
if (!vm.artifact) {
	Astro.response.status = 404;
}

const artifact = vm.artifact;
const workdayItems = artifact?.relationships.workdays.map((workday) => {
	const id = workday.workDayId ?? workday.id;
	return {
		title: workday.summary?.objective ?? workday.summary?.title ?? `Workday ${id}`,
		description: workday.state ?? 'Operational workday',
		href: id ? `/app/workdays/${encodeURIComponent(id)}` : undefined,
		meta: 'workday',
		actionLabel: id ? 'Open' : undefined,
	};
}) ?? [];
const approvalItems = artifact?.relationships.approvals.map((approval) => ({
	title: approval.title ?? 'Approval request',
	description: approval.summary ?? approval.kind ?? 'Governance review',
	href: approval.id ? `/app/governance/${encodeURIComponent(approval.id)}` : undefined,
	meta: approval.state ?? 'review',
	tone: artifact.tone,
	actionLabel: approval.id ? 'Review' : undefined,
})) ?? [];
const releaseItems = artifact?.relationships.releases.map((release) => ({
	title: `Release ${release.releaseTag ?? release.tag ?? release.id ?? 'record'}`,
	description: release.status ?? release.environment ?? 'Release record',
	meta: release.environment ?? 'release',
})) ?? [];
const decisionItems = artifact?.relationships.relatedDecisions.map((decision) => ({
	title: decision.title,
	description: decision.description ?? 'Related operational decision',
	href: decision.href,
	meta: 'decision',
	actionLabel: decision.href ? 'Open' : undefined,
})) ?? [];
const reportItems = artifact?.relationships.relatedReports.map((report) => ({
	title: report.title,
	description: report.description,
	href: report.href,
	meta: 'report',
	actionLabel: 'Open',
})) ?? [];
---

<TreeseedAppLayout
	title={artifact?.title ?? 'Knowledge artifact not found'}
	description="Operational memory with its originating work, governance, repository, and release relationships."
	currentPath="/app/knowledge"
	teams={vm.context.teams}
	activeTeam={vm.context.activeTeam}
>
	{artifact ? (
		<>
			<Panel eyebrow={artifact.category} title={artifact.title} description={artifact.description}>
				<Badge slot="actions" tone={artifact.tone ?? 'default'}>{artifact.state}</Badge>
				<KeyValueList items={[
					{ key: 'Type', value: artifact.type },
					{ key: 'Produced During', value: artifact.metadata.producedDuring ?? 'not linked' },
					{ key: 'Generated By', value: artifact.metadata.generatedBy ?? 'operational work' },
					{ key: 'Approved By', value: artifact.metadata.approvedBy ?? 'not recorded' },
					{ key: 'Approval Status', value: artifact.metadata.approvalStatus ?? 'not attached' },
					{ key: 'Project', value: artifact.metadata.projectName ?? 'not linked' },
					{ key: 'Created', value: artifact.metadata.createdAt ?? 'not recorded' },
				]} />
			</Panel>

			<section class="ts-operational-grid ts-stack-top">
				<Panel eyebrow="Relationships" title="Operational links">
					<ActionList items={[
						...workdayItems,
						...approvalItems,
						...releaseItems,
						...decisionItems,
						...reportItems,
					]}>
						<p class="ts-empty-inline">No operational relationships are attached yet.</p>
					</ActionList>
				</Panel>
				<RepositoryContextPanel repositories={artifact.relationships.repositories} />
			</section>

			<Panel class="ts-stack-top" eyebrow="Trace" title="Operational timeline" description="Knowledge remains connected to the work that produced and governed it.">
				<OperationalTimeline events={artifact.timeline} emptyTitle="No timeline events recorded" />
			</Panel>
		</>
	) : (
		<EmptyState title="Knowledge artifact not found" description="This artifact is not available in the current operational context." actions={[{ label: 'Back to Knowledge', href: '/app/knowledge' }]} />
	)}
</TreeseedAppLayout>
