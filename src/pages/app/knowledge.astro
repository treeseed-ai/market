---
import MetricGrid from '../../../packages/core/src/components/ui/data/MetricGrid.astro';
import Badge from '../../../packages/core/src/components/ui/data/Badge.astro';
import EmptyState from '../../../packages/core/src/components/ui/surface/EmptyState.astro';
import Panel from '../../../packages/core/src/components/ui/surface/Panel.astro';
import KnowledgeArtifactCard from '../../components/app/operations/KnowledgeArtifactCard.astro';
import TreeseedAppLayout from '../../layouts/TreeseedAppLayout.astro';
import { loadKnowledgeViewModel } from '../../view-models/knowledge.vm.js';

if (!Astro.locals.auth?.principal) {
	return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent('/app/knowledge')}`);
}

const vm = await loadKnowledgeViewModel(Astro.locals);
const categorySections = vm.categories.map((category) => ({
	category,
	artifacts: vm.artifacts.filter((artifact) => artifact.category === category),
}));
---

<TreeseedAppLayout
	title="Knowledge"
	description="Institutional memory produced by workdays, approvals, repositories, and releases."
	currentPath={Astro.url.pathname}
	teams={vm.context.teams}
	activeTeam={vm.context.activeTeam}
>
	<MetricGrid metrics={vm.metrics} min="10rem" />

	<Panel eyebrow="Operational Memory" title="Unified knowledge index" description="Generated artifacts, reports, decisions, release records, and imports are shown by operational use.">
		<div class="ts-badge-list">
			{vm.categories.map((category) => <Badge tone="muted">{category}</Badge>)}
		</div>
		<div class="ts-operational-card__summary ts-stack-top-sm">
			<span>{vm.relationshipSummary.workdays} workday links</span>
			<span>{vm.relationshipSummary.repositories} repositories referenced</span>
			<span>{vm.relationshipSummary.approvals} approvals linked</span>
			<span>{vm.relationshipSummary.releases} releases linked</span>
		</div>
	</Panel>

	{categorySections.map(({ category, artifacts }) => (
		<Panel class="ts-stack-top" eyebrow="Operational Category" title={category}>
			<div class="ts-card-list">
				{artifacts.length > 0 ? artifacts.map((artifact) => (
					<KnowledgeArtifactCard artifact={artifact} />
				)) : <EmptyState title={`No ${category.toLowerCase()} artifacts yet`} description="This section will fill as operational work produces durable memory." />}
			</div>
		</Panel>
	))}
</TreeseedAppLayout>
