---
import EmptyState from '../../../../../packages/core/src/components/ui/surface/EmptyState.astro';
import Panel from '../../../../../packages/core/src/components/ui/surface/Panel.astro';
import PlainTable from '../../../../components/app/controls/PlainTable.astro';
import ProjectControlNav from '../../../../components/app/controls/ProjectControlNav.astro';
import TreeseedAppLayout from '../../../../layouts/TreeseedAppLayout.astro';
import { escapeHtml as esc } from '../../../../lib/market/control-ui.js';
import { loadOperationalContext } from '../../../../view-models/shared.js';

const projectParam = String(Astro.params.projectId ?? '');
if (!Astro.locals.auth?.principal) return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const context = await loadOperationalContext(Astro.locals, Astro);
const project = context.projects.find((entry: any) => entry.id === projectParam || entry.slug === projectParam || entry.handle === projectParam) ?? null;
const approvals = project && context.store && typeof context.store.listApprovalRequestsForProject === 'function'
	? await context.store.listApprovalRequestsForProject(project.id, 100).catch(() => [])
	: [];
if (!project) Astro.response.status = 404;
const rows = approvals.map((approval: any) => ({
	id: `decision-${esc(approval.id)}`,
	name: `<strong>${esc(approval.title ?? approval.kind ?? 'Decision')}</strong><span>${esc(approval.summary ?? approval.description ?? '')}</span>`,
	state: esc(approval.state ?? 'pending'),
	action: `<a class="ts-link-button" href="/app/work/decisions/${encodeURIComponent(approval.id)}">Open</a>`,
}));
---

<TreeseedAppLayout title="Project decisions" description="List decisions for one project." currentPath="/app/projects" teams={context.teams} activeTeam={context.activeTeam}>
	{project ? (
		<section class="ts-control-page" aria-label="Project decisions">
			<ProjectControlNav projectId={project.id} current="decisions" />
			<Panel eyebrow="Projects" title="Decisions" description="Open a decision to approve or reject it.">
				<PlainTable columns={[{ key: 'name', label: 'Decision' }, { key: 'state', label: 'State' }, { key: 'action', label: 'Action' }]} rows={rows} emptyTitle="No decisions" emptyDescription="Decision requests appear when project work or publishing needs review." />
			</Panel>
		</section>
	) : (
		<EmptyState title="Project not found" description="This project is not available." actions={[{ label: 'Back to Projects', href: '/app/projects' }]} />
	)}
</TreeseedAppLayout>
