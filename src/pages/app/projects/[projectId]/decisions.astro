---
import Button from '../../../../../packages/core/src/components/ui/forms/Button.astro';
import EmptyState from '../../../../../packages/core/src/components/ui/surface/EmptyState.astro';
import Panel from '../../../../../packages/core/src/components/ui/surface/Panel.astro';
import PlainTable from '../../../../components/app/controls/PlainTable.astro';
import ProjectControlNav from '../../../../components/app/controls/ProjectControlNav.astro';
import TreeseedAppLayout from '../../../../layouts/TreeseedAppLayout.astro';
import { escapeHtml as esc } from '../../../../lib/market/control-ui.js';
import { loadOperationalContext } from '../../../../view-models/shared.js';
import { loadWorkContentEntries, workContentEntriesFor, workContentRelationSummary } from '../../../../view-models/work-content.js';

const projectParam = String(Astro.params.projectId ?? '');
if (!Astro.locals.auth?.principal) return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const [context, contentEntries] = await Promise.all([
	loadOperationalContext(Astro.locals, Astro),
	loadWorkContentEntries(),
]);
const project = context.projects.find((entry: any) => entry.id === projectParam || entry.slug === projectParam || entry.handle === projectParam) ?? null;
const approvals = project && context.store && typeof context.store.listApprovalRequestsForProject === 'function'
	? await context.store.listApprovalRequestsForProject(project.id, 100).catch(() => [])
	: [];
if (!project) Astro.response.status = 404;
function contentRow(entry: any, actionLabel = 'Open') {
	return {
		id: `content-${esc(entry.id)}`,
		name: `<strong>${esc(entry.title)}</strong><span>${esc(entry.summary || entry.description)}</span>`,
		type: esc(entry.type),
		state: esc(entry.status),
		related: esc(workContentRelationSummary(entry)),
		action: `<a class="ts-link-button" href="${esc(entry.href)}">${actionLabel}</a>`,
	};
}
const proposalRows = workContentEntriesFor(contentEntries, 'proposals').map((entry: any) => contentRow(entry, 'Review'));
const decisionRows = workContentEntriesFor(contentEntries, 'decisions').map((entry: any) => contentRow(entry));
const approvalRows = approvals.map((approval: any) => ({
	id: `decision-${esc(approval.id)}`,
	name: `<strong>${esc(approval.title ?? approval.kind ?? 'Proposal review')}</strong><span>${esc(approval.summary ?? approval.description ?? '')}</span>`,
	state: esc(approval.state ?? 'pending'),
	action: `<a class="ts-link-button" href="/app/work/decisions/${encodeURIComponent(approval.id)}">Review</a>`,
}));
---

<TreeseedAppLayout title="Project decisions" description="Evaluate proposals and preserve decisions for this project." currentPath="/app/projects" teams={context.teams} activeTeam={context.activeTeam}>
	{project ? (
		<section class="ts-control-page" aria-label="Project decisions">
			<ProjectControlNav projectId={project.id} current="decisions" />
			<Panel eyebrow="Proposal review" title="Proposals" description="Suggested changes that can become one decision or be combined into a later decision.">
				<Button slot="actions" href={`/app/work/proposals/new?projectId=${encodeURIComponent(project.id)}`} size="sm">New proposal</Button>
				<PlainTable columns={[{ key: 'name', label: 'Proposal' }, { key: 'type', label: 'Type' }, { key: 'state', label: 'State' }, { key: 'related', label: 'Links' }, { key: 'action', label: 'Action' }]} rows={proposalRows} emptyTitle="No proposals" emptyDescription="Create a proposal before asking for a decision." />
			</Panel>
			<Panel eyebrow="Decision memory" title="Decisions" description="Previous decisions and the proposals, objectives, questions, or notes they cite.">
				<Button slot="actions" href={`/app/work/decisions/new?projectId=${encodeURIComponent(project.id)}`} size="sm">New decision</Button>
				<PlainTable columns={[{ key: 'name', label: 'Decision' }, { key: 'type', label: 'Type' }, { key: 'state', label: 'State' }, { key: 'related', label: 'Links' }, { key: 'action', label: 'Action' }]} rows={decisionRows} emptyTitle="No decisions" emptyDescription="Decision content appears from src/content/decisions." />
			</Panel>
			<Panel eyebrow="Operational governance" title="Pending review" description="Automation-created approval requests that need a human decision.">
				<PlainTable columns={[{ key: 'name', label: 'Review item' }, { key: 'state', label: 'State' }, { key: 'action', label: 'Action' }]} rows={approvalRows} emptyTitle="No pending review" emptyDescription="Approval requests appear here when agents need a decision." />
			</Panel>
		</section>
	) : (
		<EmptyState title="Project not found" description="This project is not available." actions={[{ label: 'Back to Projects', href: '/app/projects' }]} />
	)}
</TreeseedAppLayout>
