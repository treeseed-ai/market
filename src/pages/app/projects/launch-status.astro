---
import EmptyState from '../../../../packages/core/src/components/ui/surface/EmptyState.astro';
import Panel from '../../../../packages/core/src/components/ui/surface/Panel.astro';
import StatusPill from '../../../../packages/core/src/components/ui/data/StatusPill.astro';
import TreeseedAppLayout from '../../../layouts/TreeseedAppLayout.astro';
import { loadOperationalContext } from '../../../view-models/shared.js';

if (!Astro.locals.auth?.principal) {
	return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`);
}
const context = await loadOperationalContext(Astro.locals, Astro);
const requestId = Astro.url.searchParams.get('request') ?? '';
---

<TreeseedAppLayout title="Project launch status" description="Follow project launch progress, audit output, and support logs." currentPath="/app/projects" teams={context.teams} activeTeam={context.activeTeam}>
	{requestId ? (
		<section
			class="ts-control-page ts-launch-status-page"
			aria-label="Project launch status"
			data-launch-status-page
			data-request-id={requestId}
		>
			<Panel eyebrow="Launch monitor" title="Project deployment status" description="Follow the launch request as TreeSeed validates hosting, queues setup, and records runner progress.">
				<div class="ts-launch-console">
					<div class="ts-launch-console__header">
						<div>
							<span class="ts-launch-console__label">Current state</span>
							<h2 data-launch-title>Preparing launch request</h2>
							<p data-launch-subtitle>Reading the local launch handoff from this browser session.</p>
						</div>
						<StatusPill tone="warning" label="Starting" />
					</div>
					<div class="ts-launch-progress" aria-label="Launch progress">
						<div class="ts-launch-progress__track">
							<span data-launch-progress-bar style="width: 6%;"></span>
						</div>
						<div class="ts-launch-progress__meta">
							<strong data-launch-progress-label>6%</strong>
							<span data-launch-progress-note>Waiting for launch request</span>
						</div>
					</div>
					<ol class="ts-launch-stepper" aria-label="Project launch steps">
						<li data-launch-step="handoff" data-state="running">
							<span></span>
							<div><strong>Request handoff</strong><small>Receive launch details from the form.</small></div>
						</li>
						<li data-launch-step="preflight" data-state="pending">
							<span></span>
							<div><strong>Hosting audit</strong><small>Validate repository, web, email, and platform readiness.</small></div>
						</li>
						<li data-launch-step="queue" data-state="pending">
							<span></span>
							<div><strong>Launch queue</strong><small>Create the project, bind credential sessions, and queue launch work.</small></div>
						</li>
						<li data-launch-step="runner" data-state="pending">
							<span></span>
							<div><strong>Runner progress</strong><small>Track repository, workflow, Cloudflare, D1, R2, and verification events.</small></div>
						</li>
						<li data-launch-step="complete" data-state="pending">
							<span></span>
							<div><strong>Ready for deploy</strong><small>Open the project deployment page when launch work reaches a terminal state.</small></div>
						</li>
					</ol>
				</div>
			</Panel>

			<div class="ts-grid-2">
				<Panel eyebrow="Audit" title="Warnings and blockers" description="Actionable readiness output appears here as soon as the API reports it.">
					<div class="ts-launch-audit" data-launch-audit>
						<p class="ts-empty-inline">No blockers recorded yet.</p>
					</div>
				</Panel>
				<Panel eyebrow="Actions" title="Next useful action" description="Use the status result to continue, retry, or share details for support.">
					<div class="ts-launch-actions">
						<a class="ts-link-button ts-link-button--primary" href="/app/projects" data-launch-project-link hidden>Open project deployment</a>
						<button class="ts-link-button" type="button" data-launch-retry disabled title="Retry will be available after this launch attempt stops.">Retry launch</button>
						<button class="ts-link-button ts-launch-copy-button" type="button" data-launch-copy aria-label="Copy deployment troubleshooting report">
							<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
								<path d="M8 7a3 3 0 0 1 3-3h6a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3h-1v-2h1a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v1H8V7Zm-4 4a3 3 0 0 1 3-3h6a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3v-6Zm3-1a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-6a1 1 0 0 0-1-1H7Z" />
							</svg>
							<span>Copy troubleshooting report</span>
						</button>
						<p class="ts-subtle" data-launch-copy-status role="status" aria-live="polite"></p>
					</div>
				</Panel>
			</div>

			<Panel eyebrow="Support log" title="Copy-ready deployment log" description="Chronological launch, audit, and runner events. Copy this into an AI chat or support thread when troubleshooting.">
				<div class="ts-launch-log-shell">
					<div class="ts-launch-log" data-launch-log aria-label="Project launch log"></div>
					<textarea class="ts-launch-log-copy ts-launch-log-copy--hidden" data-launch-log-copy readonly tabindex="-1" aria-hidden="true" aria-label="Copyable project launch log"></textarea>
				</div>
			</Panel>
		</section>
	) : (
		<EmptyState title="No launch request" description="Open this page from the New Project form so TreeSeed can monitor a launch request." actions={[{ label: 'New project', href: '/app/projects/new' }]} />
	)}
</TreeseedAppLayout>

<script>
	const page = document.querySelector('[data-launch-status-page]') as HTMLElement | null;
	const requestId = page?.dataset.requestId ?? '';
	const title = document.querySelector('[data-launch-title]') as HTMLElement | null;
	const subtitle = document.querySelector('[data-launch-subtitle]') as HTMLElement | null;
	const progressBar = document.querySelector('[data-launch-progress-bar]') as HTMLElement | null;
	const progressLabel = document.querySelector('[data-launch-progress-label]') as HTMLElement | null;
	const progressNote = document.querySelector('[data-launch-progress-note]') as HTMLElement | null;
	const auditElement = document.querySelector('[data-launch-audit]') as HTMLElement | null;
	const logElement = document.querySelector('[data-launch-log]') as HTMLElement | null;
	const logCopy = document.querySelector('[data-launch-log-copy]') as HTMLTextAreaElement | null;
	const copyButton = document.querySelector('[data-launch-copy]') as HTMLButtonElement | null;
	const retryButton = document.querySelector('[data-launch-retry]') as HTMLButtonElement | null;
	const copyStatus = document.querySelector('[data-launch-copy-status]') as HTMLElement | null;
	const projectLink = document.querySelector('[data-launch-project-link]') as HTMLAnchorElement | null;
	const statePill = document.querySelector('.ts-launch-console__header .ts-status-pill') as HTMLElement | null;
	const logs: string[] = [];
	const logEntries: Array<{ step: string; timestamp: string; message: string; data?: unknown; line: string }> = [];
	const TERMINAL_JOB_STATUSES = new Set(['completed', 'succeeded', 'failed', 'cancelled', 'timed_out']);
	const STEP_LABELS: Record<string, string> = {
		handoff: 'Request handoff',
		preflight: 'Hosting audit',
		queue: 'Launch queue',
		runner: 'Runner progress',
		complete: 'Ready for deploy',
	};
	let activeLogStep = 'handoff';
	let currentLaunchRequest: any = null;
	let currentStorageKey = '';
	let currentStatusKey = '';
	let launchRunning = false;

	function text(value: unknown, fallback = '') {
		return typeof value === 'string' && value.trim() ? value.trim() : fallback;
	}
	function setStep(name: string, state: 'pending' | 'running' | 'complete' | 'failed') {
		const step = document.querySelector(`[data-launch-step="${name}"]`) as HTMLElement | null;
		if (step) step.dataset.state = state;
		if (state === 'running' || state === 'failed') activeLogStep = name;
		renderLogSections();
		refreshCopyBuffer();
	}
	function setProgress(percent: number, note: string) {
		const normalized = Math.max(0, Math.min(100, Math.round(percent)));
		if (progressBar) progressBar.style.width = `${normalized}%`;
		if (progressLabel) progressLabel.textContent = `${normalized}%`;
		if (progressNote) progressNote.textContent = note;
		refreshCopyBuffer();
	}
	function setHeading(nextTitle: string, nextSubtitle: string) {
		if (title) title.textContent = nextTitle;
		if (subtitle) subtitle.textContent = nextSubtitle;
		refreshCopyBuffer();
	}
	function setStatePill(label: string, tone: 'default' | 'info' | 'success' | 'warning' | 'danger') {
		if (!statePill) return;
		statePill.dataset.tone = tone;
		const labelElement = statePill.querySelector('span:last-child');
		if (labelElement) labelElement.textContent = label;
		refreshCopyBuffer();
	}
	function setRetryEnabled(enabled: boolean, titleText = 'Retry this deployment with the same captured form inputs.') {
		if (!retryButton) return;
		retryButton.disabled = !enabled;
		retryButton.title = enabled ? titleText : 'Retry will be available after this launch attempt stops.';
	}
	function rememberStatus(patch: Record<string, unknown> = {}) {
		if (!currentStatusKey) return;
		try {
			window.localStorage.setItem(currentStatusKey, JSON.stringify({
				updatedAt: new Date().toISOString(),
				title: text(title?.textContent, 'Project launch status'),
				subtitle: text(subtitle?.textContent),
				state: text(statePill?.textContent, 'Unknown'),
				progress: text(progressLabel?.textContent, '0%'),
				progressNote: text(progressNote?.textContent),
				steps: [...document.querySelectorAll<HTMLElement>('[data-launch-step]')].map((step) => ({
					name: step.dataset.launchStep,
					state: step.dataset.state ?? 'pending',
				})),
				logs,
				logEntries,
				auditHtml: auditElement?.innerHTML ?? '',
				projectHref: projectLink && !projectLink.hidden ? projectLink.href : null,
				...patch,
			}));
		} catch {
			// Local status persistence is a convenience for refresh/resume only.
		}
	}
	function readStoredLaunchRequest(storageKey: string) {
		const raw = window.sessionStorage.getItem(storageKey) ?? window.localStorage.getItem(storageKey);
		return raw ? JSON.parse(raw) : null;
	}
	function writeStoredLaunchRequest(storageKey: string, request: any) {
		const value = JSON.stringify(request);
		window.sessionStorage.setItem(storageKey, value);
		window.localStorage.setItem(storageKey, value);
	}
	function removeStoredLaunchRequest(storageKey: string) {
		window.sessionStorage.removeItem(storageKey);
		window.localStorage.removeItem(storageKey);
	}
	function restoreStoredStatus(status: any) {
		if (!status || typeof status !== 'object') return false;
		if (status.title || status.subtitle) setHeading(text(status.title, 'Project launch status'), text(status.subtitle));
		if (status.state) setStatePill(text(status.state), status.state === 'Complete' ? 'success' : status.state === 'Needs attention' ? 'danger' : 'warning');
		const progressMatch = /^(\d+)/u.exec(text(status.progress));
		setProgress(progressMatch ? Number(progressMatch[1]) : 100, text(status.progressNote, 'Restored saved launch status.'));
		for (const step of Array.isArray(status.steps) ? status.steps : []) {
			if (step?.name && step?.state) setStep(String(step.name), step.state);
		}
		logs.splice(0, logs.length, ...(Array.isArray(status.logs) ? status.logs : []));
		logEntries.splice(0, logEntries.length, ...(Array.isArray(status.logEntries) ? status.logEntries : []));
		if (typeof status.auditHtml === 'string' && status.auditHtml) auditElement?.replaceChildren();
		if (auditElement && typeof status.auditHtml === 'string' && status.auditHtml) auditElement.innerHTML = status.auditHtml;
		if (status.projectHref && projectLink) {
			projectLink.href = String(status.projectHref);
			projectLink.hidden = false;
		}
		renderLogSections();
		refreshCopyBuffer();
		return true;
	}
	function resetAudit(message = 'No blockers recorded yet.') {
		if (!auditElement) return;
		const empty = document.createElement('p');
		empty.className = 'ts-empty-inline';
		empty.textContent = message;
		auditElement.replaceChildren(empty);
	}
	function resetForRetry() {
		logs.length = 0;
		logEntries.length = 0;
		activeLogStep = 'handoff';
		for (const step of document.querySelectorAll<HTMLElement>('[data-launch-step]')) {
			step.dataset.state = step.dataset.launchStep === 'handoff' ? 'running' : 'pending';
		}
		if (projectLink) projectLink.hidden = true;
		resetAudit();
		setStatePill('Retrying', 'warning');
		setProgress(6, 'Retrying launch with the same captured form inputs.');
		setHeading('Retrying launch request', 'Submitting the saved launch handoff again.');
		renderLogSections();
		refreshCopyBuffer();
	}
	function appendLog(message: string, data?: unknown, step = activeLogStep) {
		const timestamp = new Date().toISOString();
		const detail = data === undefined ? '' : ` ${JSON.stringify(data, null, 2)}`;
		const line = `[${timestamp}] ${message}${detail}`;
		logs.push(line);
		logEntries.push({ step, timestamp, message, data, line });
		renderLogSections();
		refreshCopyBuffer();
		rememberStatus();
	}
	function renderLogSections() {
		if (!logElement) return;
		logElement.replaceChildren();
		const steps = Object.keys(STEP_LABELS);
		for (const step of steps) {
			const entries = logEntries.filter((entry) => entry.step === step);
			const stepElement = document.querySelector(`[data-launch-step="${step}"]`) as HTMLElement | null;
			const state = stepElement?.dataset.state ?? 'pending';
			const details = document.createElement('details');
			details.className = 'ts-launch-log-section';
			details.dataset.state = state;
			details.open = entries.length > 0 && (state === 'running' || state === 'failed' || step === activeLogStep);
			const summary = document.createElement('summary');
			const heading = document.createElement('span');
			const count = document.createElement('small');
			heading.textContent = STEP_LABELS[step] ?? step;
			count.textContent = `${state} · ${entries.length} ${entries.length === 1 ? 'entry' : 'entries'}`;
			summary.append(heading, count);
			const list = document.createElement('ol');
			for (const entry of entries) {
				const item = document.createElement('li');
				const time = document.createElement('time');
				time.dateTime = entry.timestamp;
				time.textContent = entry.timestamp;
				const body = document.createElement('pre');
				body.textContent = entry.data === undefined ? entry.message : `${entry.message}\n${JSON.stringify(entry.data, null, 2)}`;
				item.append(time, body);
				list.append(item);
			}
			if (entries.length === 0) {
				const empty = document.createElement('p');
				empty.className = 'ts-empty-inline';
				empty.textContent = 'No entries recorded for this step yet.';
				details.append(summary, empty);
			} else {
				details.append(summary, list);
			}
			logElement.append(details);
		}
	}
	function auditEntryText(entry: any) {
		if (typeof entry === 'string') return entry;
		if (!entry || typeof entry !== 'object') return '';
		return String(entry.message ?? entry.detail ?? entry.code ?? JSON.stringify(entry));
	}
	function arrayFrom(...values: unknown[]) {
		for (const value of values) {
			if (Array.isArray(value)) return value;
		}
		return [];
	}
	function failedChecksFrom(audit: any) {
		return arrayFrom(audit?.checks, audit?.readiness?.checks, audit?.details?.checks)
			.filter((entry: any) => {
				const status = String(entry?.status ?? '').toLowerCase();
				return entry?.ready === false || ['failed', 'blocked', 'error'].includes(status);
			})
			.map(auditEntryText)
			.filter(Boolean);
	}
	function renderFailureDetails(payload: any, fallback: string) {
		const audit = payload?.audit ?? payload?.details?.audit ?? payload?.payload?.audit ?? payload?.details ?? payload?.payload ?? null;
		renderAudit(audit, fallback, payload);
	}
	function renderAudit(audit: any, fallback: string, payload: any = null) {
		if (!auditElement) return;
		const errorMessage = auditEntryText(payload?.error ?? payload?.message ?? audit?.error ?? audit?.message ?? fallback);
		const blockers = [
			...arrayFrom(audit?.blockers, audit?.readiness?.blockers, audit?.details?.blockers, payload?.blockers, payload?.details?.blockers),
			...failedChecksFrom(audit),
		].map(auditEntryText).filter(Boolean);
		const missingConfig = arrayFrom(audit?.missingConfig, audit?.missing, payload?.missingConfig, payload?.details?.missingConfig)
			.map((entry: unknown) => `Missing configuration: ${String(entry)}`);
		const warnings = arrayFrom(audit?.warnings, payload?.warnings, payload?.details?.warnings).map(auditEntryText).filter(Boolean);
		const nextActions = arrayFrom(audit?.nextActions, audit?.actions, payload?.nextActions, payload?.details?.nextActions).map((entry: unknown) => String(entry));
		const groups = [
			['Errors', errorMessage ? [errorMessage] : []],
			['Blockers', blockers],
			['Missing configuration', missingConfig],
			['Warnings', warnings],
			['Next actions', nextActions],
		].filter(([, items]) => Array.isArray(items) && items.length > 0) as [string, string[]][];
		auditElement.replaceChildren();
		if (groups.length === 0) {
			const empty = document.createElement('p');
			empty.className = 'ts-empty-inline';
			empty.textContent = fallback;
			auditElement.append(empty);
			refreshCopyBuffer();
			return;
		}
		for (const [label, items] of groups) {
			const section = document.createElement('section');
			const heading = document.createElement('h3');
			const list = document.createElement('ul');
			heading.textContent = label;
			for (const item of items) {
				const row = document.createElement('li');
				row.textContent = item;
				list.append(row);
			}
			section.append(heading, list);
			auditElement.append(section);
		}
		refreshCopyBuffer();
	}
	function supportReport() {
		const stepLines = [...document.querySelectorAll<HTMLElement>('[data-launch-step]')].map((step) => {
			const label = text(step.querySelector('strong')?.textContent, step.dataset.launchStep ?? 'step');
			const detail = text(step.querySelector('small')?.textContent);
			return `- ${label}: ${step.dataset.state ?? 'pending'}${detail ? ` (${detail})` : ''}`;
		});
		const auditLines = [...document.querySelectorAll<HTMLElement>('[data-launch-audit section]')].flatMap((section) => {
			const heading = text(section.querySelector('h3')?.textContent, 'Audit');
			const items = [...section.querySelectorAll('li')].map((item) => `  - ${text(item.textContent)}`);
			return items.length ? [heading, ...items] : [];
		});
		const groupedLogLines = Object.keys(STEP_LABELS).flatMap((step) => {
			const entries = logEntries.filter((entry) => entry.step === step);
			if (entries.length === 0) return [];
			return [`### ${STEP_LABELS[step]}`, ...entries.map((entry) => entry.line)];
		});
		return [
			'# TreeSeed project launch troubleshooting report',
			`Generated: ${new Date().toISOString()}`,
			`URL: ${window.location.href}`,
			'',
			'## Current status',
			`State: ${text(statePill?.textContent, 'Unknown')}`,
			`Title: ${text(title?.textContent, 'Unknown')}`,
			`Detail: ${text(subtitle?.textContent, 'None')}`,
			`Progress: ${text(progressLabel?.textContent, '0%')} - ${text(progressNote?.textContent, 'No progress note')}`,
			`Project deployment link: ${projectLink && !projectLink.hidden ? projectLink.href : 'Not available yet'}`,
			'',
			'## Steps',
			...(stepLines.length ? stepLines : ['No step state recorded.']),
			'',
			'## Audit, warnings, and blockers',
			...(auditLines.length ? auditLines : ['No audit blockers or warnings recorded.']),
			'',
			'## Log by step',
			...(groupedLogLines.length ? groupedLogLines : ['No log lines recorded.']),
			'',
			'## Raw chronological log',
			...(logs.length ? logs : ['No log lines recorded.']),
			'',
		].join('\n');
	}
	function refreshCopyBuffer() {
		if (logCopy) logCopy.value = supportReport();
	}
	async function readJson(response: Response | null) {
		return response ? await response.json().catch(() => null) : null;
	}
	function jobFrom(payload: any) {
		return payload?.payload ?? payload?.job ?? payload?.payload?.job ?? null;
	}
	function eventRows(payload: any) {
		if (Array.isArray(payload?.payload)) return payload.payload;
		if (Array.isArray(payload?.events)) return payload.events;
		return [];
	}
	function logJobEvents(events: any[], seen: Set<string>) {
		for (const event of events) {
			const key = String(event.id ?? event.seq ?? `${event.kind}:${event.createdAt}`);
			if (seen.has(key)) continue;
			seen.add(key);
			appendLog(`Runner event: ${text(event.kind, 'event')}`, event.data ?? event, 'runner');
		}
	}
	async function pollJob(jobId: string, deployHref: string | null) {
		const seenEvents = new Set<string>();
		setStep('runner', 'running');
		setProgress(68, 'Launch job queued. Waiting for runner events.');
		rememberStatus({ jobId, deployHref, terminal: false });
		for (let attempt = 0; attempt < 180; attempt += 1) {
			const [jobPayload, eventsPayload] = await Promise.all([
				fetch(`/v1/jobs/${encodeURIComponent(jobId)}`).then(readJson).catch(() => null),
				fetch(`/v1/jobs/${encodeURIComponent(jobId)}/events`).then(readJson).catch(() => null),
			]);
			const job = jobFrom(jobPayload);
			const events = eventRows(eventsPayload);
			logJobEvents(events, seenEvents);
			const status = text(job?.status, 'queued');
			setHeading(`Launch ${status.replaceAll('_', ' ')}`, `Job ${jobId}`);
			if (status === 'pending') {
				setStatePill('Queued', 'warning');
				setProgress(72, 'Launch job is waiting for an available runner.');
			} else if (status === 'claimed') {
				setStatePill('Claimed', 'info');
				setProgress(78, 'Runner claimed the launch job.');
			} else if (status === 'running') {
				setStatePill('Running', 'info');
				setProgress(86, 'Runner is provisioning project resources.');
			} else if (status === 'waiting_for_approval') {
				setStatePill('Approval', 'warning');
				setProgress(82, 'Launch is waiting for approval.');
			}
			else if (TERMINAL_JOB_STATUSES.has(status)) {
				const failed = ['failed', 'cancelled', 'timed_out'].includes(status);
				setStatePill(failed ? 'Needs attention' : 'Complete', failed ? 'danger' : 'success');
				setStep('runner', failed ? 'failed' : 'complete');
				setStep('complete', failed ? 'failed' : 'complete');
				setProgress(100, failed ? 'Launch stopped. Review the support log.' : 'Launch completed.');
				setHeading(failed ? 'Launch needs attention' : 'Launch queued successfully', failed ? 'Review runner events and retry from the deployment page.' : 'Open the project deployment page for environment actions.');
				if (deployHref && projectLink) {
					projectLink.href = deployHref;
					projectLink.hidden = false;
				}
				rememberStatus({ jobId, deployHref, terminal: true, jobStatus: status });
				return !failed;
			}
			rememberStatus({ jobId, deployHref, terminal: false, jobStatus: status });
			await new Promise((resolve) => window.setTimeout(resolve, 4000));
		}
		appendLog('Stopped live polling after 12 minutes. The queued launch can still continue in the background.', undefined, 'runner');
		if (deployHref && projectLink) {
			projectLink.href = deployHref;
			projectLink.hidden = false;
		}
		rememberStatus({ jobId, deployHref, terminal: false, timedOut: true });
		return false;
	}
	async function executeLaunch(request: any) {
		if (!request || launchRunning) return;
		launchRunning = true;
		setRetryEnabled(false);
		appendLog('Launch request accepted by status page.', {
			projectName: request.projectName ?? null,
			projectSlug: request.projectSlug ?? null,
			action: request.action,
		}, 'handoff');
		setStep('handoff', 'complete');
		setStep('preflight', 'running');
		setStatePill('Auditing', 'warning');
		setProgress(22, 'Submitting launch request for hosting readiness audit.');
		setHeading('Running hosting audit', `${text(request.projectName, 'Project')} (${text(request.projectSlug, 'new project')})`);
		rememberStatus({ terminal: false });
		const response = await fetch(request.action, {
			method: request.method ?? 'POST',
			headers: { 'content-type': 'application/json' },
			body: JSON.stringify(request.body ?? {}),
		});
		const payload = await readJson(response);
		if (!response.ok || payload?.ok === false) {
			appendLog('Launch request failed.', {
				status: response.status,
				error: payload?.error ?? null,
				payload,
			}, 'preflight');
			setStep('preflight', 'failed');
			setStatePill('Blocked', 'danger');
			setProgress(100, 'Launch blocked before project creation.');
			setHeading('Hosting readiness audit failed', text(payload?.error, `Project launch failed with ${response.status}`));
			renderFailureDetails(payload, text(payload?.error, 'Launch request failed.'));
			rememberStatus({ terminal: true, failedBeforeQueue: true });
			launchRunning = false;
			setRetryEnabled(true);
			return;
		}
		setStep('preflight', 'complete');
		setStep('queue', 'complete');
		setStatePill('Queued', 'warning');
		setProgress(62, 'Project created and launch job queued.');
		const projectId = payload?.projectId ?? payload?.payload?.project?.id ?? payload?.payload?.project?.project?.id ?? null;
		const launchId = payload?.launchId ?? payload?.payload?.launch?.id ?? null;
		const jobId = payload?.operationId ?? payload?.payload?.launchJob?.id ?? null;
		const deployHref = payload?.deployHref ?? (projectId ? `/app/projects/${encodeURIComponent(projectId)}/deploy${launchId ? `?launch=${encodeURIComponent(launchId)}` : ''}` : null);
		if (deployHref && projectLink) {
			projectLink.href = deployHref;
			projectLink.hidden = false;
		}
		appendLog('Project launch queued.', { projectId, launchId, jobId, deployHref }, 'queue');
		rememberStatus({ projectId, launchId, jobId, deployHref, terminal: false });
		if (jobId) {
			const completed = await pollJob(jobId, deployHref);
			launchRunning = false;
			setRetryEnabled(!completed, completed ? 'Launch completed.' : 'Retry this deployment with the same captured form inputs.');
			if (completed && currentStorageKey) removeStoredLaunchRequest(currentStorageKey);
		}
		else {
			setStep('runner', 'complete');
			setStep('complete', 'complete');
			setProgress(100, 'Launch request completed.');
			launchRunning = false;
			setRetryEnabled(false, 'Launch completed.');
			rememberStatus({ projectId, launchId, deployHref, terminal: true });
			if (currentStorageKey) removeStoredLaunchRequest(currentStorageKey);
		}
	}
	async function runLaunch() {
		if (!page || !requestId) return;
		currentStorageKey = `treeseed:project-launch:${requestId}`;
		currentStatusKey = `treeseed:project-launch-status:${requestId}`;
		const storedStatus = window.localStorage.getItem(currentStatusKey);
		currentLaunchRequest = readStoredLaunchRequest(currentStorageKey);
		if (!currentLaunchRequest) {
			const restored = storedStatus ? restoreStoredStatus(JSON.parse(storedStatus)) : false;
			if (restored) {
				appendLog('Restored saved launch status for this request. No launch handoff remains to retry from this browser.', undefined, 'handoff');
				setRetryEnabled(false, 'The original launch request is no longer available in this browser session.');
				return;
			}
			appendLog('Launch handoff was not found in browser storage.', undefined, 'handoff');
			setHeading('Launch request expired', 'The browser session no longer has the launch handoff.');
			setProgress(100, 'Return to the launch form and submit again.');
			setStep('handoff', 'failed');
			setRetryEnabled(false, 'The launch request is no longer available in this browser session.');
			return;
		}
		if (storedStatus) restoreStoredStatus(JSON.parse(storedStatus));
		setRetryEnabled(false);
		await executeLaunch(currentLaunchRequest);
	}
	copyButton?.addEventListener('click', async () => {
		const content = supportReport();
		if (logCopy) logCopy.value = content;
		const copied = await navigator.clipboard?.writeText(content).then(() => true).catch(() => false);
		if (!copied && logCopy) {
			logCopy.focus();
			logCopy.select();
		}
		if (copyStatus) copyStatus.textContent = copied ? 'Troubleshooting report copied.' : 'Report selected. Use your browser copy command.';
	});
	retryButton?.addEventListener('click', async () => {
		if (!currentLaunchRequest || launchRunning) return;
		if (currentStorageKey) {
			writeStoredLaunchRequest(currentStorageKey, currentLaunchRequest);
		}
		resetForRetry();
		appendLog('Retry requested from deployment status page.', {
			projectName: currentLaunchRequest.projectName ?? null,
			projectSlug: currentLaunchRequest.projectSlug ?? null,
			action: currentLaunchRequest.action,
		}, 'handoff');
		await executeLaunch(currentLaunchRequest).catch((error) => {
			appendLog('Launch retry failed.', { message: error instanceof Error ? error.message : String(error) }, 'preflight');
			setStep('preflight', 'failed');
			setProgress(100, 'Launch retry failed.');
			setHeading('Launch retry failed', error instanceof Error ? error.message : String(error));
			renderFailureDetails({ error: error instanceof Error ? error.message : String(error) }, 'Launch retry failed.');
			launchRunning = false;
			setRetryEnabled(true);
			rememberStatus({ terminal: true, retryFailed: true });
		});
	});
	runLaunch().catch((error) => {
		appendLog('Launch monitor failed.', { message: error instanceof Error ? error.message : String(error) }, 'preflight');
		setStep('preflight', 'failed');
		setProgress(100, 'Launch monitor failed.');
		setHeading('Launch monitor failed', error instanceof Error ? error.message : String(error));
		renderFailureDetails({ error: error instanceof Error ? error.message : String(error) }, 'Launch monitor failed.');
		launchRunning = false;
		setRetryEnabled(Boolean(currentLaunchRequest));
		rememberStatus({ terminal: true, monitorFailed: true });
	});
	renderLogSections();
	refreshCopyBuffer();
</script>
