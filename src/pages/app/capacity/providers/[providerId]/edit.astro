---
import Button from '../../../../../../packages/core/src/components/ui/forms/Button.astro';
import Field from '../../../../../../packages/core/src/components/ui/forms/Field.astro';
import FormActions from '../../../../../../packages/core/src/components/ui/forms/FormActions.astro';
import Select from '../../../../../../packages/core/src/components/ui/forms/Select.astro';
import TextInput from '../../../../../../packages/core/src/components/ui/forms/TextInput.astro';
import EmptyState from '../../../../../../packages/core/src/components/ui/surface/EmptyState.astro';
import Panel from '../../../../../../packages/core/src/components/ui/surface/Panel.astro';
import TreeseedAppLayout from '../../../../../layouts/TreeseedAppLayout.astro';
import { loadOperationalContext } from '../../../../../view-models/shared.js';

const providerId = String(Astro.params.providerId ?? '');
if (!Astro.locals.auth?.principal) return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const context = await loadOperationalContext(Astro.locals, Astro);
const team = context.activeTeam;
const providers = team && context.store ? await context.store.listTeamCapacityProviders(team.id).catch(() => []) : [];
const provider = providers.find((entry: any) => entry.id === providerId) ?? null;
if (!provider) Astro.response.status = 404;
---

<TreeseedAppLayout title={provider ? `Edit ${provider.name}` : 'Provider not found'} description="Edit one capacity provider." currentPath="/app/capacity" teams={context.teams} activeTeam={team}>
	{provider ? (
		<section class="ts-control-page" aria-label="Edit provider">
			<Panel eyebrow="Capacity" title="Edit provider" description="Update one provider's budgets and concurrency.">
				<form id="provider-form" class="ts-form-stack">
					<div class="ts-form-grid">
						<Field label="Name" name="name" required><TextInput name="name" required value={provider.name ?? ''} /></Field>
						<Field label="Provider" name="provider" required><TextInput name="provider" required value={provider.provider ?? 'custom'} /></Field>
						<Field label="Kind" name="kind"><Select name="kind" value={provider.kind ?? 'team_owned'} options={[{ label: 'Team owned', value: 'team_owned' }, { label: 'Managed', value: 'managed' }, { label: 'Host backed', value: 'host_backed' }]} /></Field>
						<Field label="Status" name="status"><Select name="status" value={provider.status ?? 'active'} options={[{ label: 'Active', value: 'active' }, { label: 'Paused', value: 'paused' }, { label: 'Draining', value: 'draining' }]} /></Field>
						<Field label="Billing scope" name="billingScope"><Select name="billingScope" value={provider.billingScope ?? 'team'} options={[{ label: 'Team', value: 'team' }, { label: 'Project', value: 'project' }]} /></Field>
						<Field label="Daily credit budget" name="dailyCreditBudget"><TextInput name="dailyCreditBudget" type="number" value={provider.dailyCreditBudget ?? 0} /></Field>
						<Field label="Monthly credit budget" name="monthlyCreditBudget"><TextInput name="monthlyCreditBudget" type="number" value={provider.monthlyCreditBudget ?? 0} /></Field>
						<Field label="Max concurrent workdays" name="maxConcurrentWorkdays"><TextInput name="maxConcurrentWorkdays" type="number" value={provider.maxConcurrentWorkdays ?? 1} /></Field>
						<Field label="Max concurrent workers" name="maxConcurrentWorkers"><TextInput name="maxConcurrentWorkers" type="number" value={provider.maxConcurrentWorkers ?? 1} /></Field>
					</div>
					<FormActions align="start"><Button type="submit">Save provider</Button><Button href="/app/capacity" variant="secondary">Back</Button><span class="ts-subtle" id="provider-status" role="status"></span></FormActions>
				</form>
			</Panel>
		</section>
	) : (
		<EmptyState title="Provider not found" description="This capacity provider is not available." actions={[{ label: 'Back to Capacity', href: '/app/capacity' }]} />
	)}
</TreeseedAppLayout>

<script is:inline define:vars={{ teamId: team?.id ?? '', providerId: provider?.id ?? '' }}>
	const form = document.getElementById('provider-form');
	const status = document.getElementById('provider-status');
	function numberValue(data, key) { return Number(data.get(key) ?? 0); }
	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const data = new FormData(form);
		if (status) status.textContent = 'Saving...';
		const response = await fetch(`/v1/teams/${encodeURIComponent(teamId)}/capacity-providers/${encodeURIComponent(providerId)}`, {
			method: 'PATCH',
			headers: { 'content-type': 'application/json' },
			body: JSON.stringify({
				name: String(data.get('name') ?? '').trim(),
				provider: String(data.get('provider') ?? 'custom').trim(),
				kind: String(data.get('kind') ?? 'team_owned'),
				status: String(data.get('status') ?? 'active'),
				billingScope: String(data.get('billingScope') ?? 'team'),
				dailyCreditBudget: numberValue(data, 'dailyCreditBudget'),
				monthlyCreditBudget: numberValue(data, 'monthlyCreditBudget'),
				maxConcurrentWorkdays: numberValue(data, 'maxConcurrentWorkdays'),
				maxConcurrentWorkers: numberValue(data, 'maxConcurrentWorkers'),
				capacityModel: {},
				metadata: {},
			}),
		});
		const payload = await response.json().catch(() => null);
		if (!response.ok || payload?.ok === false) {
			if (status) status.textContent = payload?.error ?? 'Provider could not be saved.';
			return;
		}
		if (status) status.textContent = 'Saved.';
	});
</script>
