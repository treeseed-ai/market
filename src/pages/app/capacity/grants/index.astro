---
import Button from '../../../../../packages/core/src/components/ui/forms/Button.astro';
import EmptyState from '../../../../../packages/core/src/components/ui/surface/EmptyState.astro';
import Panel from '../../../../../packages/core/src/components/ui/surface/Panel.astro';
import PlainTable from '../../../../components/app/controls/PlainTable.astro';
import TreeseedAppLayout from '../../../../layouts/TreeseedAppLayout.astro';
import { escapeHtml as esc } from '../../../../lib/market/control-ui.js';
import { loadOperationalContext } from '../../../../view-models/shared.js';

if (!Astro.locals.auth?.principal) return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent('/app/capacity/grants')}`);
const context = await loadOperationalContext(Astro.locals, Astro);
const team = context.activeTeam;
const grants = team && context.store ? await context.store.listCapacityGrants(team.id).catch(() => []) : [];
const rows = grants.map((grant: any) => ({
	id: `grant-${esc(grant.id)}`,
	scope: `<strong>${esc(grant.grantScope ?? 'team')}</strong><span>${esc(grant.projectId ?? grant.environment ?? 'all')}</span>`,
	limit: esc(`${grant.dailyCreditLimit ?? '-'} daily / ${grant.monthlyCreditLimit ?? '-'} monthly`),
	state: esc(grant.state ?? 'active'),
	action: `<a class="ts-link-button" href="/app/capacity/grants/${encodeURIComponent(grant.id)}/edit">Edit</a>`,
}));
---

<TreeseedAppLayout title="Capacity grants" description="Manage team and project capacity grants." currentPath="/app/capacity" teams={context.teams} activeTeam={team}>
	<section class="ts-control-page" aria-label="Capacity grants">
		<Panel eyebrow="Capacity" title="Grants" description={team ? 'Grant provider capacity to teams or projects.' : 'Create a team before adding grants.'}>
			<Button slot="actions" href="/app/capacity/grants/new" size="sm">New grant</Button>
			{team ? (
				<PlainTable columns={[{ key: 'scope', label: 'Scope' }, { key: 'limit', label: 'Limits' }, { key: 'state', label: 'State' }, { key: 'action', label: 'Action' }]} rows={rows} emptyTitle="No grants yet" emptyDescription="Create the first capacity grant." />
			) : (
				<EmptyState title="No team selected" description="Create or switch to a team first." actions={[{ label: 'Open Team', href: '/app/teams' }]} />
			)}
		</Panel>
	</section>
</TreeseedAppLayout>
