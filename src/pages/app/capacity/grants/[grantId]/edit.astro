---
import Button from '../../../../../../packages/core/src/components/ui/forms/Button.astro';
import Field from '../../../../../../packages/core/src/components/ui/forms/Field.astro';
import FormActions from '../../../../../../packages/core/src/components/ui/forms/FormActions.astro';
import Select from '../../../../../../packages/core/src/components/ui/forms/Select.astro';
import TextInput from '../../../../../../packages/core/src/components/ui/forms/TextInput.astro';
import EmptyState from '../../../../../../packages/core/src/components/ui/surface/EmptyState.astro';
import Panel from '../../../../../../packages/core/src/components/ui/surface/Panel.astro';
import TreeseedAppLayout from '../../../../../layouts/TreeseedAppLayout.astro';
import { loadOperationalContext } from '../../../../../view-models/shared.js';

const grantId = String(Astro.params.grantId ?? '');
if (!Astro.locals.auth?.principal) return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
const context = await loadOperationalContext(Astro.locals, Astro);
const team = context.activeTeam;
const [providers, grants] = team && context.store ? await Promise.all([
	context.store.listTeamCapacityProviders(team.id).catch(() => []),
	context.store.listCapacityGrants(team.id).catch(() => []),
]) : [[], []];
const grant = grants.find((entry: any) => entry.id === grantId) ?? null;
if (!grant) Astro.response.status = 404;
---

<TreeseedAppLayout title="Edit capacity grant" description="Edit one capacity grant." currentPath="/app/capacity" teams={context.teams} activeTeam={team}>
	{grant ? (
		<section class="ts-control-page" aria-label="Edit capacity grant">
			<Panel eyebrow="Capacity" title="Edit grant" description="Update capacity assignment fields.">
				<form id="grant-form" class="ts-form-stack">
					<div class="ts-form-grid">
						<Field label="Provider" name="capacityProviderId" required><Select name="capacityProviderId" value={grant.capacityProviderId} required options={providers.map((provider: any) => ({ label: provider.name, value: provider.id }))} /></Field>
						<Field label="Scope" name="grantScope"><Select name="grantScope" value={grant.grantScope ?? 'team'} options={[{ label: 'Team', value: 'team' }, { label: 'Project', value: 'project' }]} /></Field>
						<Field label="Project" name="projectId"><Select name="projectId" value={grant.projectId ?? ''} options={[{ label: 'All projects', value: '' }, ...context.projects.map((project: any) => ({ label: project.name ?? project.slug, value: project.id }))]} /></Field>
						<Field label="Environment" name="environment"><Select name="environment" value={grant.environment ?? ''} options={[{ label: 'Any', value: '' }, { label: 'Local', value: 'local' }, { label: 'Staging', value: 'staging' }, { label: 'Production', value: 'prod' }]} /></Field>
						<Field label="State" name="state"><Select name="state" value={grant.state ?? 'active'} options={[{ label: 'Active', value: 'active' }, { label: 'Paused', value: 'paused' }]} /></Field>
						<Field label="Daily credits" name="dailyCreditLimit"><TextInput name="dailyCreditLimit" type="number" value={grant.dailyCreditLimit ?? ''} /></Field>
						<Field label="Weekly credits" name="weeklyCreditLimit"><TextInput name="weeklyCreditLimit" type="number" value={grant.weeklyCreditLimit ?? ''} /></Field>
						<Field label="Monthly credits" name="monthlyCreditLimit"><TextInput name="monthlyCreditLimit" type="number" value={grant.monthlyCreditLimit ?? ''} /></Field>
						<Field label="Daily USD" name="dailyUsdLimit"><TextInput name="dailyUsdLimit" type="number" value={grant.dailyUsdLimit ?? ''} /></Field>
						<Field label="Priority weight" name="priorityWeight"><TextInput name="priorityWeight" type="number" value={grant.priorityWeight ?? 1} /></Field>
						<Field label="Overflow policy" name="overflowPolicy"><Select name="overflowPolicy" value={grant.overflowPolicy ?? 'soft_grant'} options={[{ label: 'Soft grant', value: 'soft_grant' }, { label: 'Hard cap', value: 'hard_cap' }]} /></Field>
					</div>
					<FormActions align="start"><Button type="submit">Save grant</Button><Button href="/app/capacity/grants" variant="secondary">Back</Button><span class="ts-subtle" id="grant-status" role="status"></span></FormActions>
				</form>
			</Panel>
		</section>
	) : (
		<EmptyState title="Grant not found" description="This grant is not available." actions={[{ label: 'Back to grants', href: '/app/capacity/grants' }]} />
	)}
</TreeseedAppLayout>

<script is:inline define:vars={{ teamId: team?.id ?? '', grantId: grant?.id ?? '' }}>
	const form = document.getElementById('grant-form');
	const status = document.getElementById('grant-status');
	function nullableNumber(data, key) { const value = String(data.get(key) ?? '').trim(); return value ? Number(value) : null; }
	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const data = new FormData(form);
		if (status) status.textContent = 'Saving...';
		const response = await fetch(`/v1/teams/${encodeURIComponent(teamId)}/capacity-grants/${encodeURIComponent(grantId)}`, {
			method: 'PATCH',
			headers: { 'content-type': 'application/json' },
			body: JSON.stringify({
				capacityProviderId: String(data.get('capacityProviderId') ?? ''),
				grantScope: String(data.get('grantScope') ?? 'team'),
				projectId: String(data.get('projectId') ?? '') || null,
				environment: String(data.get('environment') ?? '') || null,
				state: String(data.get('state') ?? 'active'),
				dailyCreditLimit: nullableNumber(data, 'dailyCreditLimit'),
				weeklyCreditLimit: nullableNumber(data, 'weeklyCreditLimit'),
				monthlyCreditLimit: nullableNumber(data, 'monthlyCreditLimit'),
				dailyUsdLimit: nullableNumber(data, 'dailyUsdLimit'),
				priorityWeight: nullableNumber(data, 'priorityWeight') ?? 1,
				overflowPolicy: String(data.get('overflowPolicy') ?? 'soft_grant'),
			}),
		});
		const payload = await response.json().catch(() => null);
		if (!response.ok || payload?.ok === false) {
			if (status) status.textContent = payload?.error ?? 'Grant could not be saved.';
			return;
		}
		if (status) status.textContent = 'Saved.';
	});
</script>
