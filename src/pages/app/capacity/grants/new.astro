---
import Button from '../../../../../packages/core/src/components/ui/forms/Button.astro';
import Field from '../../../../../packages/core/src/components/ui/forms/Field.astro';
import FormActions from '../../../../../packages/core/src/components/ui/forms/FormActions.astro';
import Select from '../../../../../packages/core/src/components/ui/forms/Select.astro';
import TextInput from '../../../../../packages/core/src/components/ui/forms/TextInput.astro';
import EmptyState from '../../../../../packages/core/src/components/ui/surface/EmptyState.astro';
import Panel from '../../../../../packages/core/src/components/ui/surface/Panel.astro';
import TreeseedAppLayout from '../../../../layouts/TreeseedAppLayout.astro';
import { loadOperationalContext } from '../../../../view-models/shared.js';

if (!Astro.locals.auth?.principal) return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent('/app/capacity/grants/new')}`);
const context = await loadOperationalContext(Astro.locals, Astro);
const team = context.activeTeam;
const providers = team && context.store ? await context.store.listTeamCapacityProviders(team.id).catch(() => []) : [];
---

<TreeseedAppLayout title="New capacity grant" description="Create one capacity grant." currentPath="/app/capacity" teams={context.teams} activeTeam={team}>
	{team ? (
		<section class="ts-control-page" aria-label="New capacity grant">
			<Panel eyebrow="Capacity" title="Create grant" description="Assign capacity to a team or project.">
				<form id="grant-form" class="ts-form-stack">
					<div class="ts-form-grid">
						<Field label="Provider" name="capacityProviderId" required><Select name="capacityProviderId" required options={providers.map((provider: any) => ({ label: provider.name, value: provider.id }))} /></Field>
						<Field label="Scope" name="grantScope"><Select name="grantScope" options={[{ label: 'Team', value: 'team' }, { label: 'Project', value: 'project' }]} /></Field>
						<Field label="Project" name="projectId"><Select name="projectId" options={[{ label: 'All projects', value: '' }, ...context.projects.map((project: any) => ({ label: project.name ?? project.slug, value: project.id }))]} /></Field>
						<Field label="Environment" name="environment"><Select name="environment" options={[{ label: 'Any', value: '' }, { label: 'Local', value: 'local' }, { label: 'Staging', value: 'staging' }, { label: 'Production', value: 'prod' }]} /></Field>
						<Field label="State" name="state"><Select name="state" options={[{ label: 'Active', value: 'active' }, { label: 'Paused', value: 'paused' }]} /></Field>
						<Field label="Daily credits" name="dailyCreditLimit"><TextInput name="dailyCreditLimit" type="number" /></Field>
						<Field label="Weekly credits" name="weeklyCreditLimit"><TextInput name="weeklyCreditLimit" type="number" /></Field>
						<Field label="Monthly credits" name="monthlyCreditLimit"><TextInput name="monthlyCreditLimit" type="number" /></Field>
						<Field label="Daily USD" name="dailyUsdLimit"><TextInput name="dailyUsdLimit" type="number" /></Field>
						<Field label="Priority weight" name="priorityWeight"><TextInput name="priorityWeight" type="number" value="1" /></Field>
						<Field label="Overflow policy" name="overflowPolicy"><Select name="overflowPolicy" options={[{ label: 'Soft grant', value: 'soft_grant' }, { label: 'Hard cap', value: 'hard_cap' }]} /></Field>
					</div>
					<FormActions align="start"><Button type="submit">Create grant</Button><Button href="/app/capacity/grants" variant="secondary">Cancel</Button><span class="ts-subtle" id="grant-status" role="status"></span></FormActions>
				</form>
			</Panel>
		</section>
	) : (
		<EmptyState title="No active team" description="Create or switch to a team before creating grants." actions={[{ label: 'Open Team', href: '/app/teams' }]} />
	)}
</TreeseedAppLayout>

<script is:inline define:vars={{ teamId: team?.id ?? '' }}>
	const form = document.getElementById('grant-form');
	const status = document.getElementById('grant-status');
	function nullableNumber(data, key) { const value = String(data.get(key) ?? '').trim(); return value ? Number(value) : null; }
	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const data = new FormData(form);
		if (status) status.textContent = 'Creating...';
		const response = await fetch(`/v1/teams/${encodeURIComponent(teamId)}/capacity-grants`, {
			method: 'POST',
			headers: { 'content-type': 'application/json' },
			body: JSON.stringify({
				capacityProviderId: String(data.get('capacityProviderId') ?? ''),
				grantScope: String(data.get('grantScope') ?? 'team'),
				projectId: String(data.get('projectId') ?? '') || null,
				environment: String(data.get('environment') ?? '') || null,
				state: String(data.get('state') ?? 'active'),
				dailyCreditLimit: nullableNumber(data, 'dailyCreditLimit'),
				weeklyCreditLimit: nullableNumber(data, 'weeklyCreditLimit'),
				monthlyCreditLimit: nullableNumber(data, 'monthlyCreditLimit'),
				dailyUsdLimit: nullableNumber(data, 'dailyUsdLimit'),
				priorityWeight: nullableNumber(data, 'priorityWeight') ?? 1,
				overflowPolicy: String(data.get('overflowPolicy') ?? 'soft_grant'),
			}),
		});
		const payload = await response.json().catch(() => null);
		if (!response.ok || payload?.ok === false) {
			if (status) status.textContent = payload?.error ?? 'Grant could not be created.';
			return;
		}
		window.location.href = '/app/capacity/grants';
	});
</script>
