---
import TreeseedAppLayout from '../../layouts/TreeseedAppLayout.astro';
import Button from '../../../packages/core/src/components/ui/forms/Button.astro';
import Field from '../../../packages/core/src/components/ui/forms/Field.astro';
import FormActions from '../../../packages/core/src/components/ui/forms/FormActions.astro';
import Select from '../../../packages/core/src/components/ui/forms/Select.astro';
import TextInput from '../../../packages/core/src/components/ui/forms/TextInput.astro';
import Textarea from '../../../packages/core/src/components/ui/forms/Textarea.astro';
import KeyValueList from '../../../packages/core/src/components/ui/data/KeyValueList.astro';
import Panel from '../../../packages/core/src/components/ui/surface/Panel.astro';
import { listTreeseedManagedHostsFromConfig } from '../../lib/market/managed-hosts.js';
import { loadAccessibleTeams, resolveMarketStore } from '../../lib/market/store.js';

if (!Astro.locals.auth?.principal) {
	return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent('/app/launch')}`);
}

const store = resolveMarketStore(Astro.locals);
const teams = await loadAccessibleTeams(Astro.locals);
const hostsByTeamEntries = store
	? await Promise.all(teams.map(async (team: any) => [
			team.id,
			[
			...(await listTreeseedManagedHostsFromConfig(team.id, (Astro.locals as any).runtime ?? Astro.locals)),
			...(await store.listTeamWebHosts(team.id)),
		],
	]))
	: [];
const repositoryHostsByTeamEntries = store
	? await Promise.all(teams.map(async (team: any) => [
			team.id,
			await store.listRepositoryHosts(team.id),
	]))
	: [];
const launchJson = JSON.stringify({
	teams,
	hostsByTeam: Object.fromEntries(hostsByTeamEntries),
	repositoryHostsByTeam: Object.fromEntries(repositoryHostsByTeamEntries),
}).replace(/</gu, '\\u003c');
---

<TreeseedAppLayout
	title="New Objective"
	description="Create operational context for a new objective, repository baseline, and future workdays."
	currentPath={Astro.url.pathname}
	teams={teams}
	activeTeam={teams[0] ?? null}
>
	{teams.length === 0 ? (
		<Panel
			eyebrow="Operational context required"
			title="Add organization context in Infrastructure"
			description="Objectives need an organization context before TreeSeed can create repository context and future workdays."
		>
			<Button slot="actions" href="/app/infrastructure#teams" size="sm">Inspect infrastructure</Button>
		</Panel>
	) : (
		<section class="ts-section-grid">
			<Panel
				eyebrow="Launch"
				title="Create operational context"
				description="Provision the control-plane record now. Runtime provisioning and repository bootstrap will follow through the launch job."
			>
				<form id="project-launch-form" class="ts-form-stack">
					<Field label="Organization context" name="teamId" required>
						<Select name="teamId" options={teams.map((team: any) => ({ label: team.name, value: team.id }))} required />
					</Field>
					<Field label="Name" name="name" required>
						<TextInput name="name" required placeholder="Deployment Reliability Operations" />
					</Field>
					<Field label="Slug" name="slug" required>
						<TextInput name="slug" required placeholder="deployment-reliability-ops" />
					</Field>
					<Field label="Summary" name="summary">
						<Textarea name="summary" rows={4} placeholder="Short statement of what this hub exists to operate." />
					</Field>
					<Field label="Source kind" name="sourceKind">
						<Select name="sourceKind" options={[
							{ label: 'Blank', value: 'blank' },
							{ label: 'Workflow import', value: 'template' },
							{ label: 'Knowledge import', value: 'knowledge_pack' },
						]} />
					</Field>
					<Field label="Hosting mode" name="hostingMode">
						<Select name="hostingMode" options={[{ label: 'Managed', value: 'managed' }]} />
					</Field>
					<Field label="Repository Host" name="repositoryHostId">
						<Select name="repositoryHostId" options={[]} />
					</Field>
					<div class="ts-form-note">
						<strong>Repository topology</strong>
						<span>TreeSeed will create a software repository and a content repository.</span>
					</div>
					<Field label="Web Host" name="cloudflareHostChoice" required>
						<Select name="cloudflareHostChoice" options={[]} required />
					</Field>
					<Field label="Processing Host" name="processingHostChoice" required>
						<Select name="processingHostChoice" options={[]} required />
					</Field>
					<Field label="Email Host" name="emailHostChoice" required>
						<Select name="emailHostChoice" options={[]} required />
					</Field>
					<div class="ts-form-note" id="launch-sensitive-notice" hidden>
						<strong>Team-owned hosts require sensitive data unlock.</strong>
						<span>Unlock sensitive data from the header before launch so TreeSeed can create short-lived credential sessions for the selected hosts.</span>
					</div>
					<FormActions align="start">
						<Button type="submit">Create operational context</Button>
						<span class="ts-subtle" id="project-launch-status" role="status"></span>
					</FormActions>
				</form>
			</Panel>

			<Panel eyebrow="Launch defaults" title="Operational launch behavior">
				<KeyValueList items={[
					{ key: 'Visibility', value: 'Hub surfaces are public-ready by default. Resource publication remains governed.' },
					{ key: 'Repository provider', value: 'The selected Repository Host creates software and content repositories for launch, release, and checks.' },
					{ key: 'Release policy', value: 'Runtime work can save and verify, but humans approve staging, release, and publish.' },
				]} />
			</Panel>
		</section>
	)}
	<script is:inline type="application/json" id="launch-data" set:html={launchJson}></script>
</TreeseedAppLayout>

<script>
	const dataElement = document.getElementById('launch-data');
	const data = dataElement?.textContent ? JSON.parse(dataElement.textContent) : { teams: [], hostsByTeam: {} };
	const launchForm = document.getElementById('project-launch-form') as HTMLFormElement | null;
	const hostSelect = launchForm?.elements.namedItem('cloudflareHostChoice') as HTMLSelectElement | null;
	const processingHostSelect = launchForm?.elements.namedItem('processingHostChoice') as HTMLSelectElement | null;
	const emailHostSelect = launchForm?.elements.namedItem('emailHostChoice') as HTMLSelectElement | null;
	const repositoryHostSelect = launchForm?.elements.namedItem('repositoryHostId') as HTMLSelectElement | null;
	const teamSelect = launchForm?.elements.namedItem('teamId') as HTMLSelectElement | null;
	const sensitiveNotice = document.getElementById('launch-sensitive-notice');
	const statusElement = document.getElementById('project-launch-status');

	function setStatus(message: string) {
		if (statusElement) statusElement.textContent = message;
	}

	function hostsForSelectedTeam(hostType = 'web', provider = 'cloudflare') {
		return (data.hostsByTeam?.[teamSelect?.value ?? ''] ?? [])
			.filter((host: any) => host.provider === provider && ((host.metadata?.hostType === 'agent' ? 'processing' : host.metadata?.hostType) ?? 'web') === hostType);
	}

	function repositoryHostsForSelectedTeam() {
		return data.repositoryHostsByTeam?.[teamSelect?.value ?? ''] ?? [];
	}

	function refreshOneHostSelect(select: HTMLSelectElement | null, hostType: string, provider: string) {
		if (!select) return;
		const previous = select.value;
		select.replaceChildren();
		for (const host of hostsForSelectedTeam(hostType, provider)) {
			const mode = host.ownership === 'treeseed_managed' ? 'treeseed_managed' : 'team_owned';
			const labelSuffix = mode === 'treeseed_managed' ? 'paid managed' : (host.accountLabel ?? provider);
			select.append(new Option(`${host.name} (${labelSuffix})`, `${mode}:${host.id}`));
		}
		if ([...select.options].some((option) => option.value === previous)) select.value = previous;
	}

	function refreshHostChoices() {
		refreshOneHostSelect(hostSelect, 'web', 'cloudflare');
		refreshOneHostSelect(processingHostSelect, 'processing', 'railway');
		refreshOneHostSelect(emailHostSelect, 'email', 'smtp');
		refreshRepositoryHostChoices();
		refreshSensitiveRequirement();
	}

	function refreshRepositoryHostChoices() {
		if (!repositoryHostSelect) return;
		const previous = repositoryHostSelect.value;
		repositoryHostSelect.replaceChildren();
		for (const host of repositoryHostsForSelectedTeam()) {
			const labelSuffix = host.ownership === 'treeseed_managed' ? 'managed repository host' : (host.accountLabel ?? host.organizationOrOwner);
			repositoryHostSelect.append(new Option(`${host.name} (${labelSuffix})`, host.id));
		}
		if (repositoryHostSelect.options.length === 0) {
			repositoryHostSelect.append(new Option('TreeSeed Hosted Repositories (managed)', 'platform:github:hosted-hubs'));
		}
		if ([...repositoryHostSelect.options].some((option) => option.value === previous)) repositoryHostSelect.value = previous;
	}

	function selectedHost(select: HTMLSelectElement | null, hostType = 'web', provider = 'cloudflare') {
		const [, hostId] = String(select?.value ?? '').split(':');
		return hostsForSelectedTeam(hostType, provider).find((host: any) => host.id === hostId) ?? null;
	}

	function selectedHostMode(select: HTMLSelectElement | null) {
		return String(select?.value ?? '').startsWith('team_owned:') ? 'team_owned' : 'treeseed_managed';
	}

	function requiresSensitiveUnlock() {
		const repositoryHost = selectedRepositoryHost();
		return selectedHostMode(hostSelect) === 'team_owned'
			|| selectedHostMode(processingHostSelect) === 'team_owned'
			|| selectedHostMode(emailHostSelect) === 'team_owned'
			|| repositoryHost?.ownership === 'team_owned';
	}

	function refreshSensitiveRequirement() {
		if (!sensitiveNotice) return;
		sensitiveNotice.hidden = !requiresSensitiveUnlock();
	}

	teamSelect?.addEventListener('change', refreshHostChoices);
	hostSelect?.addEventListener('change', refreshSensitiveRequirement);
	processingHostSelect?.addEventListener('change', refreshSensitiveRequirement);
	emailHostSelect?.addEventListener('change', refreshSensitiveRequirement);
	repositoryHostSelect?.addEventListener('change', refreshSensitiveRequirement);
	window.addEventListener('treeseed:sensitive-unlock-change', refreshSensitiveRequirement);
	refreshHostChoices();

	function selectedRepositoryHost() {
		const hostId = String(repositoryHostSelect?.value ?? '');
		return repositoryHostsForSelectedTeam().find((host: any) => host.id === hostId) ?? null;
	}

	async function createCredentialSession(teamId: string, request: {
		hostKind: string;
		hostId: string;
		passphrase: string;
		purpose?: string;
	}) {
		const response = await fetch(`/v1/teams/${encodeURIComponent(teamId)}/provider-credential-sessions`, {
			method: 'POST',
			headers: { 'content-type': 'application/json' },
			body: JSON.stringify({
				...request,
				purpose: request.purpose ?? 'launch_project',
				expiresInSeconds: 900,
			}),
		});
		const payload = await response.json().catch(() => null);
		if (!response.ok || payload?.ok === false) {
			throw new Error(payload?.error ?? payload?.message ?? `Unable to unlock ${request.hostKind}.`);
		}
		return payload.payload?.id;
	}

	async function auditSelectedHosting(teamId: string, credentialSessions: Record<string, string>) {
		setStatus('Checking hosting readiness...');
		const response = await fetch(`/v1/teams/${encodeURIComponent(teamId)}/hosting-audit`, {
			method: 'POST',
			headers: { 'content-type': 'application/json' },
			body: JSON.stringify({
				environment: 'current',
				repair: false,
				hostKinds: ['repository', 'web', 'processing', 'email'],
				credentialSessions,
			}),
		});
		const payload = await response.json().catch(() => null);
		if (!response.ok || payload?.ok === false) {
			throw new Error(payload?.error ?? `Hosting audit failed with ${response.status}`);
		}
		if (payload?.payload?.ok === false) {
			const firstBlocker = payload.payload.blockers?.[0] ?? 'Hosting readiness checks found blockers.';
			throw new Error(firstBlocker);
		}
		return payload?.payload;
	}

	function launchPassphraseIfNeeded() {
		if (!requiresSensitiveUnlock()) return null;
		const passphrase = (window as any).treeseedSensitiveUnlock?.requirePassphrase?.();
		if (!passphrase) {
			setStatus('Unlock sensitive data from the header before launching with team-owned hosts.');
			throw new Error('Sensitive data is locked.');
		}
		return String(passphrase);
	}

	launchForm?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const form = new FormData(launchForm);
		const teamId = String(form.get('teamId') ?? '');
		const slug = String(form.get('slug') ?? '').trim();
		const mode = selectedHostMode(hostSelect);
		const processingMode = selectedHostMode(processingHostSelect);
		const emailMode = selectedHostMode(emailHostSelect);
		let cloudflareHostId = null;
		let processingHostId = null;
		let emailHostId = null;
		const credentialSessions: Record<string, string> = {};
		setStatus('Preparing launch...');
		try {
			const selectedWebHost: any = selectedHost(hostSelect, 'web', 'cloudflare');
			cloudflareHostId = selectedWebHost?.id ?? null;
			const selectedProcessingHost: any = selectedHost(processingHostSelect, 'processing', 'railway');
			processingHostId = selectedProcessingHost?.id ?? null;
			const selectedEmailHost: any = selectedHost(emailHostSelect, 'email', 'smtp');
			emailHostId = selectedEmailHost?.id ?? null;
			const selectedRepoHost: any = selectedRepositoryHost();
			const passphrase = launchPassphraseIfNeeded();
			if (selectedRepoHost?.ownership === 'team_owned') {
				credentialSessions.repositoryHost = await createCredentialSession(teamId, {
					hostKind: 'repository_host',
					hostId: selectedRepoHost.id,
					passphrase: passphrase ?? '',
				});
			}
			if (mode === 'team_owned') {
				credentialSessions.webHost = await createCredentialSession(teamId, {
					hostKind: 'web_host',
					hostId: selectedWebHost?.id ?? '',
					passphrase: passphrase ?? '',
				});
			}
			if (processingMode === 'team_owned') {
				credentialSessions.processingHost = await createCredentialSession(teamId, {
					hostKind: 'processing_host',
					hostId: selectedProcessingHost?.id ?? '',
					passphrase: passphrase ?? '',
				});
			}
			if (emailMode === 'team_owned') {
				credentialSessions.emailHost = await createCredentialSession(teamId, {
					hostKind: 'email_host',
					hostId: selectedEmailHost?.id ?? '',
					passphrase: passphrase ?? '',
				});
			}
			await auditSelectedHosting(teamId, credentialSessions);
			const response = await fetch(`/v1/teams/${encodeURIComponent(teamId)}/projects/launch`, {
				method: 'POST',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify({
					intent: {
						team: { id: teamId },
						hub: {
							slug,
							name: String(form.get('name') ?? '').trim(),
							purpose: String(form.get('summary') ?? '').trim(),
							visibility: 'public',
						},
						source: {
							kind: String(form.get('sourceKind') ?? 'blank') === 'blank' ? 'blank_hub' : String(form.get('sourceKind') ?? 'blank'),
						},
						repository: {
							hostId: String(form.get('repositoryHostId') ?? 'platform:github:hosted-hubs'),
							provider: 'github',
							topology: 'split_software_content',
							visibility: 'private',
						},
						hosting: {
							mode: 'treeseed_managed',
						},
						contentResolution: {
							productionSource: 'r2_published_artifacts',
							overlaySource: 'src_content_when_present',
						},
						direction: {
							decisionPolicyPreset: 'lead_approval',
						},
					},
					slug,
					name: String(form.get('name') ?? '').trim(),
					summary: String(form.get('summary') ?? '').trim(),
					sourceKind: String(form.get('sourceKind') ?? 'blank'),
					hostingMode: 'managed',
					repoProvider: 'github',
					repoVisibility: 'private',
					repositoryHostId: String(form.get('repositoryHostId') ?? 'platform:github:hosted-hubs'),
					cloudflareHostMode: mode,
					cloudflareHostId,
					processingHostMode: processingMode,
					processingHostId,
					emailHostMode: emailMode,
					emailHostId,
					credentialSessions,
					targetEnvironments: ['staging', 'prod'],
					publicSite: true,
					enableDefaultAgents: true,
				}),
			});
			const payload = await response.json().catch(() => null);
			if (!response.ok || payload?.ok === false) {
				throw new Error(payload?.error ?? `Launch failed with ${response.status}`);
			}
			setStatus('Launch queued. Opening infrastructure context...');
			window.location.href = '/app/infrastructure';
		} catch (error) {
			if ((error as Error)?.message === 'Sensitive data is locked.') return;
			setStatus(error instanceof Error ? error.message : String(error));
		}
	});
</script>
