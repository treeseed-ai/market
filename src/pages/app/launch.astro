---
import KnowledgeCoopAppLayout from '../../layouts/KnowledgeCoopAppLayout.astro';
import { loadAccessibleTeams, resolveMarketStore } from '../../lib/market/store.js';

if (!Astro.locals.auth?.principal) {
	return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent('/app/launch')}`);
}

const store = resolveMarketStore(Astro.locals);
const teams = await loadAccessibleTeams(Astro.locals);

if (Astro.request.method === 'POST' && store) {
	const form = await Astro.request.formData();
	const teamId = String(form.get('teamId') ?? '');
	const slug = String(form.get('slug') ?? '').trim();
	const name = String(form.get('name') ?? '').trim();
	const summary = String(form.get('summary') ?? '').trim();
	const sourceKind = String(form.get('sourceKind') ?? 'blank').trim();
	const hostingMode = String(form.get('hostingMode') ?? 'managed').trim();
	const team = teams.find((entry: any) => entry.id === teamId);
	if (team && slug && name) {
		const details: any = await store.createProject(team.id, {
			slug,
			name,
			description: summary || null,
			metadata: {
				sourceKind,
				publicSite: true,
				enableDefaultAgents: true,
				launchMode: hostingMode,
			},
			entitlementTier: 'free',
		});
		if (details?.project?.id) {
			await store.upsertProjectHosting(details.project.id, {
				kind: hostingMode === 'managed' ? 'hosted_project' : 'self_hosted_project',
				registration: hostingMode === 'hybrid' ? 'optional' : 'none',
				marketBaseUrl: Astro.url.origin,
				projectApiBaseUrl: null,
				executionOwner: hostingMode === 'managed' ? 'project_api' : 'project_runner',
				metadata: {
					repoProvider: 'github',
					repoVisibility: 'private',
					publicSite: true,
				},
			});
			for (const environment of ['local', 'staging', 'prod'] as const) {
				await store.upsertProjectEnvironment(details.project.id, {
					environment,
					deploymentProfile: hostingMode === 'managed' ? 'hosted_project' : 'self_hosted_project',
					baseUrl: null,
					metadata: {
						launchMode: hostingMode,
					},
				});
			}
			await store.createJob({
				projectId: details.project.id,
				namespace: 'workflow',
				operation: 'launch_project',
				preferredMode: 'auto',
				selectedTarget: hostingMode === 'managed' ? 'project_api' : 'project_runner',
				requestedByType: 'user',
				requestedById: Astro.locals.auth.principal.id,
				input: {
					projectId: details.project.id,
					teamId: team.id,
					sourceKind,
					hostingMode,
					repoProvider: 'github',
				},
			});
			return Astro.redirect(`/app/teams/${team.name}/projects/${details.project.slug}/overview`);
		}
	}
}
---

<KnowledgeCoopAppLayout
	title="Launch Project"
	description="Create a new knowledge hub in the same control plane you will use to operate, release, and publish it."
	currentPath={Astro.url.pathname}
	teams={teams}
	activeTeam={teams[0] ?? null}
>
	{teams.length === 0 ? (
		<section class="kc-panel">
			<div class="kc-panel__header">
				<div>
					<p class="kc-section__eyebrow">Team required</p>
					<h2>Create a team first</h2>
					<p>Projects belong to teams, so create a team before launching your first knowledge hub.</p>
				</div>
				<a class="kc-button" href="/app/teams/new">Create new team</a>
			</div>
		</section>
	) : (
		<section class="kc-grid-2">
			<form class="kc-panel" method="POST">
			<div class="kc-panel__header">
				<div>
					<p class="kc-section__eyebrow">Launch</p>
					<h2>Create a knowledge hub</h2>
					<p>Provision the control-plane record now. Runtime provisioning and GitHub bootstrap will follow through the launch job.</p>
				</div>
			</div>
			<div class="kc-list">
				<label class="kc-list-item">
					<strong>Team</strong><br />
					<select name="teamId" style="margin-top:0.5rem; width:100%; padding:0.75rem; border:1px solid #d0d7de; border-radius:0.8rem;">
						{teams.map((team: any) => <option value={team.id}>{team.name}</option>)}
					</select>
				</label>
				<label class="kc-list-item">
					<strong>Name</strong><br />
					<input name="name" required placeholder="Applied Systems Coop" style="margin-top:0.5rem; width:100%; padding:0.75rem; border:1px solid #d0d7de; border-radius:0.8rem;" />
				</label>
				<label class="kc-list-item">
					<strong>Slug</strong><br />
					<input name="slug" required placeholder="applied-systems-coop" style="margin-top:0.5rem; width:100%; padding:0.75rem; border:1px solid #d0d7de; border-radius:0.8rem;" />
				</label>
				<label class="kc-list-item">
					<strong>Summary</strong><br />
					<textarea name="summary" rows="4" placeholder="Short statement of what this hub exists to operate." style="margin-top:0.5rem; width:100%; padding:0.75rem; border:1px solid #d0d7de; border-radius:0.8rem;"></textarea>
				</label>
				<label class="kc-list-item">
					<strong>Source kind</strong><br />
					<select name="sourceKind" style="margin-top:0.5rem; width:100%; padding:0.75rem; border:1px solid #d0d7de; border-radius:0.8rem;">
						<option value="blank">Blank</option>
						<option value="template">Template</option>
						<option value="knowledge_pack">Knowledge pack</option>
					</select>
				</label>
				<label class="kc-list-item">
					<strong>Hosting mode</strong><br />
					<select name="hostingMode" style="margin-top:0.5rem; width:100%; padding:0.75rem; border:1px solid #d0d7de; border-radius:0.8rem;">
						<option value="managed">Managed</option>
						<option value="hybrid">Hybrid</option>
						<option value="self_hosted">Self hosted</option>
					</select>
				</label>
			</div>
			<div class="kc-inline-actions" style="margin-top: 1rem;">
				<button class="kc-button" type="submit">Create project</button>
			</div>
			</form>

			<section class="kc-panel">
			<div class="kc-panel__header">
				<div>
					<p class="kc-section__eyebrow">Launch defaults</p>
					<h2>MVP launch behavior</h2>
				</div>
			</div>
			<div class="kc-list">
				<div class="kc-list-item"><strong>Visibility</strong><br />Hub surfaces are public-ready by default. Market listing remains draft until you publish from Share.</div>
				<div class="kc-list-item"><strong>Repo provider</strong><br />GitHub is the first-class provider for launch, release, and checks.</div>
				<div class="kc-list-item"><strong>Release policy</strong><br />Agents can save and verify autonomously, but humans approve staging, release, and publish.</div>
			</div>
			</section>
		</section>
	)}
</KnowledgeCoopAppLayout>
