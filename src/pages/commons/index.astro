---
import TreeseedPublicLayout from '@treeseed/admin/layouts/TreeseedPublicLayout.astro';
import DashboardTemplate from '@treeseed/ui/components/astro/templates/DashboardTemplate.astro';
import CommonsProposalCard from '@treeseed/ui/components/astro/governance/CommonsProposalCard.astro';
import '@treeseed/ui/styles/governance.css';
import { loadCommonsPage } from '../../lib/market-public-view-models';

const page = await loadCommonsPage(Astro);
---

<TreeseedPublicLayout title={page.title} description={page.description} currentPath={Astro.url.pathname} helpContext={page.helpContext} feedbackContext={page.feedbackContext}>
	<main class="ts-governance-page">
		<DashboardTemplate viewModel={page.data.dashboard} actions={page.actions}>
			{page.data.proposals.length ? (
				<section class="ts-governance-inner">
					<div class="ts-governance-grid">
						{page.data.proposals.map((proposal) => (
							<CommonsProposalCard proposal={proposal} href={`/commons/proposals/${encodeURIComponent(proposal.id)}`} />
						))}
					</div>
				</section>
			) : null}
		</DashboardTemplate>
	</main>
</TreeseedPublicLayout>
