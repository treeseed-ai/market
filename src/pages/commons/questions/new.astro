---
import TreeseedPublicLayout from '@treeseed/admin/layouts/TreeseedPublicLayout.astro';
import '@treeseed/ui/styles/governance.css';
---

<TreeseedPublicLayout title="Ask a Commons question" description="Submit a TreeSeed Commons question." currentPath={Astro.url.pathname}>
	<main class="ts-governance-page">
		<section class="ts-governance-inner ts-governance-hero">
			<p class="ts-governance-eyebrow">Commons question</p>
			<h1 class="ts-governance-title">Ask before proposing.</h1>
			<p class="ts-governance-lede">Questions help the community clarify needs, evidence, objections, and priorities before a proposal enters the decision pipeline.</p>
		</section>
		<section class="ts-governance-inner">
			<form id="commons-question" class="ts-governance-panel">
				<label>Title <input name="title" required /></label>
				<label>Question <textarea name="body" rows="8" required></textarea></label>
				<button class="ts-governance-button" type="submit">Submit question</button>
				<p id="question-result" class="ts-governance-muted"></p>
			</form>
		</section>
	</main>
</TreeseedPublicLayout>

<script>
	// @ts-nocheck
	document.querySelector('#commons-question')?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const form = new FormData(event.currentTarget);
		const response = await fetch('/v1/commons/questions', {
			method: 'POST',
			headers: { 'content-type': 'application/json' },
			body: JSON.stringify(Object.fromEntries(form.entries())),
		});
		const envelope = await response.json().catch(() => null);
		document.querySelector('#question-result').textContent = envelope?.ok ? 'Question submitted.' : envelope?.error ?? 'Sign in to submit a question.';
	});
</script>
