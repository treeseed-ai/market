---
import TreeseedPublicLayout from '@treeseed/admin/layouts/TreeseedPublicLayout.astro';
import SettingsTemplate from '@treeseed/ui/components/astro/templates/SettingsTemplate.astro';
import '@treeseed/ui/styles/governance.css';
import { loadCommonsQuestionFormPage, submitCommonsQuestion } from '../../../lib/market-public-view-models';

let actionError: string | undefined;
let actionMessage: string | undefined;

if (Astro.request.method === 'POST') {
	const result = await submitCommonsQuestion(Astro, await Astro.request.formData());
	if (result.ok) actionMessage = 'Question submitted.';
	else actionError = result.error;
}

const page = loadCommonsQuestionFormPage(Astro, actionError);
---

<TreeseedPublicLayout title={page.title} description={page.description} currentPath={Astro.url.pathname} helpContext={page.helpContext} feedbackContext={page.feedbackContext}>
	<main class="ts-governance-page">
		<SettingsTemplate title={page.title} description={page.description} actions={page.actions}>
			<form class="ts-governance-panel" method="post">
				{actionError ? <p class="ts-governance-muted">{actionError}</p> : null}
				{actionMessage ? <p class="ts-governance-muted">{actionMessage}</p> : null}
				<label class="ts-field"><span class="ts-field__label">Title</span><input class="ts-field__control" name="title" required /></label>
				<label class="ts-field"><span class="ts-field__label">Question</span><textarea class="ts-field__control" name="body" rows="8" required></textarea></label>
				<button class="ts-governance-button" type="submit">Submit question</button>
			</form>
		</SettingsTemplate>
	</main>
</TreeseedPublicLayout>
