---
import TreeseedPublicLayout from '@treeseed/admin/layouts/TreeseedPublicLayout.astro';
import '@treeseed/ui/styles/governance.css';
const proposalId = Astro.params.proposalId;
---

<TreeseedPublicLayout title="Commons proposal" description="Review, back, and vote on a TreeSeed Commons proposal." currentPath={Astro.url.pathname}>
	<main class="ts-governance-page">
		<section class="ts-governance-inner ts-governance-hero">
			<p class="ts-governance-eyebrow">Commons proposal</p>
			<h1 id="proposal-title" class="ts-governance-title">Loading proposal...</h1>
			<p id="proposal-summary" class="ts-governance-lede"></p>
			<div class="ts-governance-actions">
				<button id="back-proposal" class="ts-governance-button" type="button">Back proposal</button>
				<button id="vote-support" class="ts-governance-button" data-variant="secondary" type="button">Vote support</button>
			</div>
		</section>
		<section class="ts-governance-inner ts-governance-two-column">
			<article class="ts-governance-panel">
				<p class="ts-governance-eyebrow">Proposal</p>
				<h2>Body</h2>
				<p id="proposal-body"></p>
			</article>
			<aside id="proposal-side" class="ts-governance-grid"></aside>
		</section>
	</main>
</TreeseedPublicLayout>

<script is:inline define:vars={{ proposalId }}>
	// @ts-nocheck
	const title = document.querySelector('#proposal-title');
	const summary = document.querySelector('#proposal-summary');
	const body = document.querySelector('#proposal-body');
	const side = document.querySelector('#proposal-side');
	async function api(path, init) {
		const response = await fetch(path, init);
		const envelope = await response.json().catch(() => null);
		if (!response.ok || !envelope?.ok) throw new Error(envelope?.error ?? `Request failed: ${response.status}`);
		return envelope.payload;
	}
	function render(proposal) {
		title.textContent = proposal.title;
		summary.textContent = proposal.summary;
		body.textContent = proposal.body;
		side.innerHTML = `
			<article class="ts-governance-panel">
				<p class="ts-governance-eyebrow">Status</p>
				<h2>${proposal.status}</h2>
				<dl class="ts-governance-kv">
					<div><dt>Backers</dt><dd>${proposal.backingCount}</dd></div>
					<div><dt>Support</dt><dd>${proposal.voteSupportWeight}</dd></div>
					<div><dt>Object</dt><dd>${proposal.voteObjectWeight}</dd></div>
				</dl>
			</article>
			<article class="ts-governance-panel">
				<p class="ts-governance-eyebrow">Timeline</p>
				<h2>Governance evidence</h2>
				<ul class="ts-governance-timeline">${(proposal.events ?? []).map((event) => `<li><strong>${event.eventType}</strong> ${event.nextState ?? ''}</li>`).join('') || '<li>No events yet.</li>'}</ul>
			</article>
		`;
	}
	async function reload() {
		render(await api(`/v1/commons/proposals/${encodeURIComponent(proposalId)}`));
	}
	document.querySelector('#back-proposal')?.addEventListener('click', async () => {
		await api(`/v1/commons/proposals/${encodeURIComponent(proposalId)}/back`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ reason: 'Backed from Commons page.' }) });
		await reload();
	});
	document.querySelector('#vote-support')?.addEventListener('click', async () => {
		await api(`/v1/commons/proposals/${encodeURIComponent(proposalId)}/vote`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ vote: 'support', reason: 'Supported from Commons page.' }) });
		await reload();
	});
	reload().catch((error) => {
		title.textContent = error instanceof Error ? error.message : 'Proposal could not be loaded.';
	});
</script>
