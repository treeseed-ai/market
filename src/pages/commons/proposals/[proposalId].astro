---
import TreeseedOperationalMarketLayout from '@treeseed/admin/layouts/TreeseedOperationalMarketLayout.astro';
import DetailTemplate from '@treeseed/ui/components/astro/templates/DetailTemplate.astro';
import Panel from '@treeseed/ui/components/astro/surface/Panel.astro';
import CommonsDecisionTimeline from '@treeseed/ui/components/astro/governance/CommonsDecisionTimeline.astro';
import CommonsVoteSummary from '@treeseed/ui/components/astro/governance/CommonsVoteSummary.astro';
import '@treeseed/ui/styles/governance.css';
import { loadCommonsProposalPage, submitCommonsProposalAction } from '../../../lib/market-public-view-models';

const proposalId = Astro.params.proposalId ?? '';
let actionError: string | undefined;

if (Astro.request.method === 'POST') {
	const result = await submitCommonsProposalAction(Astro, proposalId, await Astro.request.formData());
	if (result.ok) return Astro.redirect(Astro.url.pathname, 303);
	actionError = result.error;
}

const page = await loadCommonsProposalPage(Astro, proposalId, actionError);
const proposal = page.data.proposal;
---

<TreeseedOperationalMarketLayout title={page.title} description={page.description} currentPath={Astro.url.pathname} helpContext={page.helpContext} feedbackContext={page.feedbackContext}>
	<main class="ts-governance-page">
		<DetailTemplate title={page.title} description={page.description} eyebrow="Commons proposal" metadata={page.data.metadata} actions={page.actions}>
			{page.data.error ? <p class="ts-governance-muted">{page.data.error}</p> : null}
			<div class="ts-governance-two-column">
				<Panel title="Body">
					<p>{proposal?.body ?? 'This proposal could not be loaded.'}</p>
					{proposal ? (
						<form class="ts-governance-actions" method="post">
							<input type="hidden" name="reason" value="Recorded from the Commons proposal page." />
							<button class="ts-governance-button" type="submit" name="action" value="back">Back proposal</button>
							<button class="ts-governance-button" data-variant="secondary" type="submit" name="action" value="vote">Vote support</button>
							<input type="hidden" name="vote" value="support" />
						</form>
					) : null}
				</Panel>
				<div class="ts-governance-grid">
					<CommonsVoteSummary
						backers={proposal?.backingCount ?? proposal?.backings?.length ?? 0}
						support={proposal?.voteSupportWeight ?? 0}
						object={proposal?.voteObjectWeight ?? 0}
						abstain={proposal?.voteAbstainWeight ?? 0}
					/>
					<CommonsDecisionTimeline events={proposal?.events ?? []} />
				</div>
			</div>
		</DetailTemplate>
	</main>
</TreeseedOperationalMarketLayout>
