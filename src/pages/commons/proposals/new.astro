---
import TreeseedOperationalMarketLayout from '@treeseed/admin/layouts/TreeseedOperationalMarketLayout.astro';
import SettingsTemplate from '@treeseed/ui/components/astro/templates/SettingsTemplate.astro';
import '@treeseed/ui/styles/governance.css';
import { loadCommonsProposalFormPage, submitCommonsProposal } from '../../../lib/market-public-view-models';

let actionError: string | undefined;

if (Astro.request.method === 'POST') {
	const result = await submitCommonsProposal(Astro, await Astro.request.formData());
	if (result.ok) return Astro.redirect(`/commons/proposals/${encodeURIComponent(String(result.payload.id))}`, 303);
	actionError = result.error;
}

const page = loadCommonsProposalFormPage(Astro, actionError);
---

<TreeseedOperationalMarketLayout title={page.title} description={page.description} currentPath={Astro.url.pathname} helpContext={page.helpContext} feedbackContext={page.feedbackContext}>
	<main class="ts-governance-page">
		<SettingsTemplate title={page.title} description={page.description} actions={page.actions}>
			<form class="ts-governance-panel" method="post">
				{actionError ? <p class="ts-governance-muted">{actionError}</p> : null}
				<label class="ts-field"><span class="ts-field__label">Title</span><input class="ts-field__control" name="title" required /></label>
				<label class="ts-field"><span class="ts-field__label">Summary</span><input class="ts-field__control" name="summary" required /></label>
				<label class="ts-field"><span class="ts-field__label">Proposal</span><textarea class="ts-field__control" name="body" rows="10" required></textarea></label>
				<button class="ts-governance-button" type="submit">Create proposal</button>
			</form>
		</SettingsTemplate>
	</main>
</TreeseedOperationalMarketLayout>
