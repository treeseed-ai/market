---
import TreeseedPublicLayout from '@treeseed/admin/layouts/TreeseedPublicLayout.astro';
import '@treeseed/ui/styles/governance.css';
---

<TreeseedPublicLayout title="Submit a Commons proposal" description="Submit a TreeSeed Commons proposal." currentPath={Astro.url.pathname}>
	<main class="ts-governance-page">
		<section class="ts-governance-inner ts-governance-hero">
			<p class="ts-governance-eyebrow">Commons proposal</p>
			<h1 class="ts-governance-title">Turn a community need into governed work.</h1>
			<p class="ts-governance-lede">Proposals create transparent advisory signal. Steward decisions remain bounded by capacity, safety, architecture, and the cooperative governance and ownership model.</p>
		</section>
		<section class="ts-governance-inner">
			<form id="commons-proposal" class="ts-governance-panel">
				<label>Title <input name="title" required /></label>
				<label>Summary <input name="summary" required /></label>
				<label>Proposal <textarea name="body" rows="10" required></textarea></label>
				<button class="ts-governance-button" type="submit">Create proposal</button>
				<p id="proposal-result" class="ts-governance-muted"></p>
			</form>
		</section>
	</main>
</TreeseedPublicLayout>

<script>
	// @ts-nocheck
	document.querySelector('#commons-proposal')?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const form = new FormData(event.currentTarget);
		const response = await fetch('/v1/commons/proposals', {
			method: 'POST',
			headers: { 'content-type': 'application/json' },
			body: JSON.stringify({ ...Object.fromEntries(form.entries()), scope: 'treeseed_commons', decisionType: 'advisory' }),
		});
		const envelope = await response.json().catch(() => null);
		if (envelope?.ok) {
			location.href = `/commons/proposals/${encodeURIComponent(envelope.payload.id)}`;
		} else {
			document.querySelector('#proposal-result').textContent = envelope?.error ?? 'Sign in to submit a proposal.';
		}
	});
</script>
