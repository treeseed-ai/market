---
import MarketProductCard from '../../components/market/MarketProductCard.astro';
import { listSiteTemplates, type TemplateSiteCard } from '@treeseed/core/templates';
import { createMarketTemplateCatalogProvider } from '../../lib/market/catalog.js';

const templateListing = await listSiteTemplates({
	locals: Astro.locals,
	catalogProvider: createMarketTemplateCatalogProvider(Astro.locals),
});
if (!templateListing.rendered) {
	Astro.response.status = 404;
}
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Templates</title>
	</head>
	<body>
		{templateListing.rendered ? (
		<main class="market-shell">
			<header class="market-hero">
				<p class="market-hero__eyebrow">TreeSeed Market</p>
				<h1>Templates</h1>
				<p>First-party TreeSeed template products packaged through the market layer.</p>
			</header>
			<section class="market-grid">
				{templateListing.items.map((entry: TemplateSiteCard) => (
					<MarketProductCard
						slug={entry.slug}
						title={entry.title}
						summary={entry.summary}
						category={entry.category}
						featured={entry.featured}
						publisherName={entry.publisherName}
						templateVersion={entry.templateVersion}
						priceModel={entry.priceModel}
					/>
				))}
			</section>
		</main>
		) : (
		<main class="market-shell">
			<header class="market-hero">
				<p class="market-hero__eyebrow">TreeSeed Market</p>
				<h1>Not found</h1>
				<p>The templates model is disabled for this site.</p>
			</header>
		</main>
		)}
	</body>
</html>

<style>
	.market-shell {
		max-width: 72rem;
		margin: 0 auto;
		padding: 3rem 1.25rem 4rem;
	}

	.market-hero {
		margin-bottom: 2rem;
	}

	.market-hero__eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.82rem;
		color: var(--sl-color-gray-3);
	}

	.market-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
		gap: 1rem;
	}
 </style>
