---
import { render } from 'astro:content';
import { resolveSiteTemplate } from '@treeseed/core/templates';
import { createMarketTemplateCatalogProvider } from '../../lib/market/catalog.js';

const slug = Astro.params.slug ?? '';
const template = await resolveSiteTemplate(slug, {
	locals: Astro.locals,
	catalogProvider: createMarketTemplateCatalogProvider(Astro.locals),
});
if (!template.rendered) {
	Astro.response.status = 404;
}

if (template.rendered && !template.item) {
	return Astro.redirect('/templates/');
}

const contentRender = template.item?.contentEntry ? await render(template.item.contentEntry) : null;
const Content = contentRender?.Content;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{template.item?.title}</title>
	</head>
	<body>
		{template.rendered ? (
			<main class="template-shell">
				<p><a href="/templates/">Templates</a></p>
				<header>
					<p class="template-eyebrow">
						{`${template.item?.category ?? 'Template'} · ${template.item?.publisherName ?? 'Unknown publisher'}`}
					</p>
					<h1>{template.item?.title}</h1>
					<p>{template.item?.description}</p>
				</header>
				<section class="template-panel">
					<h2>Compatibility</h2>
					<ul>
						<li>Template version: {template.item?.compatibility.templateVersion ?? 'unknown'}</li>
						<li>Template API: {template.item?.compatibility.templateApiVersion ?? 'unknown'}</li>
						<li>Minimum CLI: {template.item?.compatibility.minCliVersion ?? 'unknown'}</li>
						<li>Minimum core: {template.item?.compatibility.minCoreVersion ?? 'unknown'}</li>
					</ul>
				</section>
				<section class="template-panel">
					<h2>Fulfillment</h2>
					<ul>
						<li>Mode: {template.item?.fulfillment.mode ?? 'unknown'}</li>
						<li>Source: {template.item?.fulfillment.sourceLabel ?? 'unknown'}</li>
						{template.item?.source === 'catalog' ? (
							<>
								{template.item.fulfillment.artifactKey ? <li>Artifact key: {template.item.fulfillment.artifactKey}</li> : null}
								{template.item.fulfillment.manifestKey ? <li>Manifest key: {template.item.fulfillment.manifestKey}</li> : null}
								<li>Offer: {template.item.priceModel?.replaceAll('_', ' ') ?? 'free'}</li>
							</>
						) : template.item?.fulfillment.objectKey ? (
							<>
								<li>Object key: {template.item.fulfillment.objectKey}</li>
								<li>Artifact version: {template.item.fulfillment.version}</li>
								{template.item.fulfillment.publicUrl ? (
									<li>Public URL: {template.item.fulfillment.publicUrl}</li>
								) : null}
							</>
						) : (
							<>
								<li>Repository: {template.item?.fulfillment.repoUrl}</li>
								<li>Directory: {template.item?.fulfillment.directory}</li>
								<li>Ref: {template.item?.fulfillment.ref}</li>
							</>
						)}
						{template.item?.source === 'catalog' ? null : <li>Hooks policy: {template.item?.fulfillment.hooksPolicy}</li>}
						{template.item?.source === 'catalog' ? null : <li>Supports reconcile: {template.item?.fulfillment.supportsReconcile ? 'yes' : 'no'}</li>}
						{template.item?.source === 'catalog' ? null : <li>Offer: {template.item?.priceModel?.replaceAll('_', ' ') ?? 'free'}</li>}
					</ul>
				</section>
				{Content ? (
				<article class="template-panel">
						<Content />
					</article>
				) : template.item?.source === 'catalog' ? (
					<article class="template-panel">
						<h2>Catalog Entry</h2>
						<p>{template.item.summary ?? 'This template is managed through the central market catalog.'}</p>
					</article>
				) : null}
			</main>
		) : (
		<main class="template-shell">
			<h1>Not found</h1>
			<p>The templates model is disabled for this site.</p>
		</main>
		)}
	</body>
</html>

<style>
	.template-shell {
		max-width: 56rem;
		margin: 0 auto;
		padding: 3rem 1.25rem 4rem;
	}

	.template-eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.82rem;
		color: var(--sl-color-gray-3);
	}

	.template-panel {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		padding: 1rem 1.1rem;
		margin-top: 1rem;
	}
 </style>
