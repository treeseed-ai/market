---
import TreeseedPublicLayout from '@treeseed/admin/layouts/TreeseedPublicLayout.astro';
import CollectionTemplate from '@treeseed/ui/components/astro/templates/CollectionTemplate.astro';
import '@treeseed/ui/styles/commerce.css';
import { loadCapacityListingsPage } from '../../lib/market-public-view-models';

const page = await loadCapacityListingsPage(Astro);
---

<TreeseedPublicLayout title={page.title} description={page.description} currentPath={Astro.url.pathname} helpContext={page.helpContext} feedbackContext={page.feedbackContext}>
	<main class="ts-commerce-page">
		<CollectionTemplate viewModel={page.data.collection} actions={page.actions} mode="cards" />
	</main>
</TreeseedPublicLayout>
