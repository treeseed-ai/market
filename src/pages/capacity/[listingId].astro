---
import TreeseedOperationalMarketLayout from '@treeseed/admin/layouts/TreeseedOperationalMarketLayout.astro';
import DetailTemplate from '@treeseed/ui/components/astro/templates/DetailTemplate.astro';
import Panel from '@treeseed/ui/components/astro/surface/Panel.astro';
import '@treeseed/ui/styles/commerce.css';
import { loadCapacityListingPage, submitCapacityInquiry } from '../../lib/market-public-view-models';

const listingId = Astro.params.listingId ?? '';
let actionError: string | undefined;
let actionMessage: string | undefined;

if (Astro.request.method === 'POST') {
	const result = await submitCapacityInquiry(Astro, listingId, await Astro.request.formData());
	if (result.ok) {
		actionMessage = 'Inquiry submitted for seller review.';
	} else {
		actionError = result.error;
	}
}

const page = await loadCapacityListingPage(Astro, listingId, actionError);
const listing = page.data.listing;
---

<TreeseedOperationalMarketLayout title={page.title} description={page.description} currentPath={Astro.url.pathname} helpContext={page.helpContext} feedbackContext={page.feedbackContext}>
	<main class="ts-commerce-page">
		<DetailTemplate title={page.title} description={page.description} eyebrow="Capacity listing" metadata={page.data.metadata} actions={page.actions}>
			<div class="ts-commerce-two-column">
				<Panel title="Readiness and risk posture">
					{listing ? (
						<>
							<p>{listing.buyerVisibleRiskSummary ?? listing.dataHandlingSummary ?? 'This listing is approved for buyer review.'}</p>
							<dl class="ts-commerce-kv">
								<div><dt>Support</dt><dd>{listing.supportPolicy ?? 'seller-defined'}</dd></div>
								<div><dt>Availability</dt><dd>{listing.availabilitySummary ?? 'seller-defined'}</dd></div>
								<div><dt>Supported services</dt><dd>{(listing.supportedServiceTypes ?? []).join(', ') || 'seller-defined'}</dd></div>
								<div><dt>Regions</dt><dd>{(listing.supportedRegions ?? []).join(', ') || 'seller-defined'}</dd></div>
							</dl>
						</>
					) : <p>{page.description}</p>}
				</Panel>
				<section class="ts-commerce-panel">
					<p class="ts-commerce-eyebrow">Inquiry</p>
					<h2>Request seller review</h2>
					<p class="ts-commerce-muted">This creates an inquiry only. It does not create checkout, billing, grants, reservations, routing, or execution work.</p>
					{actionError ? <p class="ts-commerce-error">{actionError}</p> : null}
					{actionMessage ? <p class="ts-commerce-muted">{actionMessage}</p> : null}
					<form class="ts-commerce-form" method="post">
						<label class="ts-commerce-field"><span>Service type</span><input name="requestedServiceType" autocomplete="off" /></label>
						<label class="ts-commerce-field"><span>Requested scope</span><textarea name="requestedScope" required></textarea></label>
						<label class="ts-commerce-field"><span>Data access request</span><textarea name="dataAccessRequested"></textarea></label>
						<label class="ts-commerce-field"><span>Secret access request</span><textarea name="secretAccessRequested"></textarea></label>
						<label class="ts-commerce-field"><span>Related project ID</span><input name="relatedProjectId" autocomplete="off" /></label>
						<label class="ts-commerce-field"><span>Related workday ID</span><input name="relatedWorkdayId" autocomplete="off" /></label>
						<button class="ts-commerce-button" type="submit">Submit inquiry</button>
					</form>
				</section>
			</div>
		</DetailTemplate>
	</main>
</TreeseedOperationalMarketLayout>
