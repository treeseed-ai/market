---
import TreeseedOperationalMarketLayout from '@treeseed/admin/layouts/TreeseedOperationalMarketLayout.astro';
import DashboardTemplate from '@treeseed/ui/components/astro/templates/DashboardTemplate.astro';
import SettingsTemplate from '@treeseed/ui/components/astro/templates/SettingsTemplate.astro';
import '@treeseed/ui/styles/commerce.css';
import { createCheckoutFromOffer, loadCartPage } from '../lib/market-public-view-models';

let actionError: string | undefined;

if (Astro.request.method === 'POST') {
	const result = await createCheckoutFromOffer(Astro, await Astro.request.formData());
	if (result.ok) {
		const checkoutId = result.payload?.checkout?.id;
		if (checkoutId) return Astro.redirect(`/checkout/${encodeURIComponent(String(checkoutId))}`, 303);
		actionError = 'Checkout was created, but no checkout id was returned.';
	} else {
		actionError = result.error;
	}
}

const page = loadCartPage(Astro, actionError);
---

<TreeseedOperationalMarketLayout title={page.title} description={page.description} currentPath={Astro.url.pathname} helpContext={page.helpContext} feedbackContext={page.feedbackContext}>
	<main class="ts-commerce-page">
		<DashboardTemplate viewModel={page.data.dashboard} actions={page.actions} />
		<SettingsTemplate title="Direct checkout" description="Use an approved offer id. The API resolves seller, price, amount, and entitlement scope." actions={[]}>
			<form class="ts-commerce-panel ts-commerce-form" method="post">
				{actionError ? <p class="ts-commerce-error">{actionError}</p> : null}
				<label class="ts-commerce-field"><span>Offer ID</span><input name="offerId" required autocomplete="off" /></label>
				<label class="ts-commerce-field"><span>Price ID</span><input name="priceId" autocomplete="off" /></label>
				<label class="ts-commerce-field"><span>Quantity</span><input name="quantity" type="number" min="1" value="1" /></label>
				<button class="ts-commerce-button" type="submit">Start checkout</button>
			</form>
		</SettingsTemplate>
	</main>
</TreeseedOperationalMarketLayout>
