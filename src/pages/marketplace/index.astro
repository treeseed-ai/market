---
import TreeseedPublicLayout from '@treeseed/admin/layouts/TreeseedPublicLayout.astro';
import DashboardTemplate from '@treeseed/ui/components/astro/templates/DashboardTemplate.astro';
import CollectionTemplate from '@treeseed/ui/components/astro/templates/CollectionTemplate.astro';
import MarketplaceProductCard from '@treeseed/ui/components/astro/commerce/MarketplaceProductCard.astro';
import '@treeseed/ui/styles/commerce.css';
import { loadMarketplacePage } from '../../lib/market-public-view-models';

const page = await loadMarketplacePage(Astro);
---

<TreeseedPublicLayout title={page.title} description={page.description} currentPath={Astro.url.pathname} helpContext={page.helpContext} feedbackContext={page.feedbackContext}>
	<main class="ts-commerce-page">
		<DashboardTemplate viewModel={page.data.dashboard} actions={page.actions} />
		<CollectionTemplate viewModel={page.data.collection} actions={[]} mode="cards">
			{page.data.products.length ? (
				<div class="ts-commerce-grid">
					{page.data.products.map((product) => (
						<MarketplaceProductCard {...product} />
					))}
				</div>
			) : null}
		</CollectionTemplate>
	</main>
</TreeseedPublicLayout>
