---
import KnowledgeCoopPublicLayout from '../../layouts/KnowledgeCoopPublicLayout.astro';
import { loadUserProfileByUsername, normalizeUsername, validateUsername } from '../../lib/auth/account';

export const prerender = false;

const requestedUsername = String(Astro.params.username ?? '');
const normalizedUsername = normalizeUsername(requestedUsername);
if (requestedUsername !== normalizedUsername && validateUsername(normalizedUsername).ok) {
	return Astro.redirect(`/u/${normalizedUsername}`, 301);
}
const profile = await loadUserProfileByUsername(Astro, normalizedUsername, Astro.locals.auth?.principal ?? null);
if (!profile) {
	return new Response('Not found', { status: 404 });
}
const displayName = profile.user.displayName || `@${profile.user.username}`;
const joinedDate = new Date(profile.user.joinedAt).toLocaleDateString('en', { month: 'long', year: 'numeric' });
const visibleCount = profile.activity.teams.length
	+ profile.activity.projects.length
	+ profile.activity.catalogItems.length
	+ profile.activity.knowledgePacks.length;
---

<KnowledgeCoopPublicLayout
	title={`${displayName} (@${profile.user.username}) | Knowledge Coop`}
	description={`Public Knowledge Coop profile for @${profile.user.username}.`}
	currentPath={`/u/${profile.user.username}`}
>
	<main class="kc-section">
		<section class="kc-user-profile">
			<div class="kc-user-profile__avatar" aria-hidden="true">
				{profile.user.image ? <img src={profile.user.image} alt="" loading="lazy" /> : <span>{displayName.slice(0, 1).toUpperCase()}</span>}
			</div>
			<div>
				<p class="kc-section__eyebrow">User profile</p>
				<h1>{displayName}</h1>
				<p class="kc-user-profile__handle">@{profile.user.username}</p>
				<p class="kc-user-profile__meta">Joined {joinedDate}</p>
			</div>
		</section>

		<section class="kc-grid-2 kc-profile-activity" aria-label="Profile activity">
			<div class="kc-panel">
				<div class="kc-panel__header">
					<h2>Teams</h2>
					<span class="kc-badge">{profile.activity.teams.length}</span>
				</div>
				<div class="kc-list">
					{profile.activity.teams.length > 0 ? profile.activity.teams.map((team) => (
						<a class="kc-list-item" href={`/t/${team.slug}`}>
							<strong>{team.name}</strong><br />
							<span>{team.slug}</span>
						</a>
					)) : <p>No visible teams.</p>}
				</div>
			</div>

			<div class="kc-panel">
				<div class="kc-panel__header">
					<h2>Projects</h2>
					<span class="kc-badge">{profile.activity.projects.length}</span>
				</div>
				<div class="kc-list">
					{profile.activity.projects.length > 0 ? profile.activity.projects.map((project) => (
						<div class="kc-list-item">
							<strong>{project.name}</strong><br />
							<span>{project.description || project.slug}</span>
						</div>
					)) : <p>No visible projects.</p>}
				</div>
			</div>

			<div class="kc-panel">
				<div class="kc-panel__header">
					<h2>Catalog listings</h2>
					<span class="kc-badge">{profile.activity.catalogItems.length}</span>
				</div>
				<div class="kc-list">
					{profile.activity.catalogItems.length > 0 ? profile.activity.catalogItems.map((item) => (
						<a class="kc-list-item" href={`/market/${item.kind === 'knowledge_pack' ? 'knowledge-packs' : 'templates'}/${item.slug}`}>
							<strong>{item.title}</strong><br />
							<span>{item.summary || item.kind}</span>
						</a>
					)) : <p>No visible listings.</p>}
				</div>
			</div>

			<div class="kc-panel">
				<div class="kc-panel__header">
					<h2>Knowledge packs</h2>
					<span class="kc-badge">{profile.activity.knowledgePacks.length}</span>
				</div>
				<div class="kc-list">
					{profile.activity.knowledgePacks.length > 0 ? profile.activity.knowledgePacks.map((pack) => (
						<a class="kc-list-item" href={`/market/knowledge-packs/${pack.slug}`}>
							<strong>{pack.name}</strong><br />
							<span>{pack.summary || pack.visibility}</span>
						</a>
					)) : <p>No visible knowledge packs.</p>}
				</div>
			</div>
		</section>
		{visibleCount === 0 ? <p class="kc-muted">No profile activity is visible to you yet.</p> : null}
	</main>
	<style>
		.kc-user-profile {
			display: grid;
			grid-template-columns: auto 1fr;
			align-items: center;
			gap: 1rem;
			margin-bottom: 1.5rem;
		}
		.kc-user-profile h1 {
			margin: 0.1rem 0;
			font-size: clamp(2rem, 4vw, 3rem);
			letter-spacing: 0;
		}
		.kc-user-profile__avatar {
			width: 5rem;
			height: 5rem;
			border-radius: 8px;
			overflow: hidden;
			display: grid;
			place-items: center;
			background: #204c3f;
			color: #fff;
			font-weight: 900;
			font-size: 2rem;
		}
		.kc-user-profile__avatar img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
		.kc-user-profile__handle,
		.kc-user-profile__meta,
		.kc-muted {
			margin: 0;
			color: #58665a;
		}
		.kc-profile-activity .kc-list-item {
			text-decoration: none;
			color: inherit;
		}
	</style>
</KnowledgeCoopPublicLayout>
