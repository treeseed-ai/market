---
import TreeseedPublicLayout from '@treeseed/admin/layouts/TreeseedPublicLayout.astro';
import DetailTemplate from '@treeseed/ui/components/astro/templates/DetailTemplate.astro';
import CommerceEntitlementList from '@treeseed/ui/components/astro/commerce/CommerceEntitlementList.astro';
import CommercePaymentGroupPanel from '@treeseed/ui/components/astro/commerce/CommercePaymentGroupPanel.astro';
import '@treeseed/ui/styles/commerce.css';
import { label, loadCheckoutPage, money } from '../../lib/market-public-view-models';

const checkoutId = Astro.params.checkoutId ?? '';
const page = await loadCheckoutPage(Astro, checkoutId);
---

<TreeseedPublicLayout title={page.title} description={page.description} currentPath={Astro.url.pathname} helpContext={page.helpContext} feedbackContext={page.feedbackContext}>
	<main class="ts-commerce-page">
		<DetailTemplate title="Grouped vendor checkout" description={page.description} eyebrow="Checkout" metadata={page.data.metadata} actions={page.actions}>
			{page.data.error ? <p class="ts-commerce-error">{page.data.error}</p> : null}
			<section class="ts-commerce-two-column" data-commerce-checkout data-checkout-id={checkoutId}>
				<CommercePaymentGroupPanel>
					<div class="ts-commerce-grid" data-commerce-payment-groups>
						{page.data.groups.length ? page.data.groups.map((group) => (
							<article class="ts-commerce-card" data-payment-group-id={group.id}>
								<div class="ts-commerce-panel-header">
									<div>
										<p class="ts-commerce-eyebrow">{label(group.groupKind, 'payment group')}</p>
										<h3>{money(group.totalAmount, group.currency)}</h3>
									</div>
									<span class="ts-status-pill" data-tone={group.status === 'succeeded' ? 'success' : 'muted'}>{label(group.status, 'pending')}</span>
								</div>
								<p class="ts-commerce-muted">Seller payment authority is resolved by TreeSeed and Stripe. Private account identifiers are never rendered.</p>
								<div class="ts-commerce-actions">
									{group.status === 'succeeded'
										? <span class="ts-commerce-muted">Confirmed</span>
										: <button type="button" class="ts-commerce-button" data-confirm-payment-group={group.id}>Confirm securely</button>}
								</div>
							</article>
						)) : <p class="ts-commerce-muted">No payment groups found.</p>}
					</div>
				</CommercePaymentGroupPanel>
				<CommerceEntitlementList entitlements={page.data.entitlements} />
			</section>
		</DetailTemplate>
	</main>
	<script is:inline src="https://js.stripe.com/v3/" async></script>
	<script src="../../scripts/commerce-checkout.ts"></script>
</TreeseedPublicLayout>
