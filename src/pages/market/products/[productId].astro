---
import TreeseedOperationalMarketLayout from '@treeseed/admin/layouts/TreeseedOperationalMarketLayout.astro';
import DetailTemplate from '@treeseed/ui/components/astro/templates/DetailTemplate.astro';
import Panel from '@treeseed/ui/components/astro/surface/Panel.astro';
import CommerceOwnershipSummary from '@treeseed/ui/components/astro/commerce/CommerceOwnershipSummary.astro';
import '@treeseed/ui/styles/commerce.css';
import { createCheckoutFromOffer, label, loadMarketplaceProductPage, money } from '../../../lib/market-public-view-models';

const productId = Astro.params.productId ?? '';
let actionError: string | undefined;

if (Astro.request.method === 'POST') {
	const result = await createCheckoutFromOffer(Astro, await Astro.request.formData());
	if (result.ok) {
		const checkoutId = result.payload?.checkout?.id;
		if (checkoutId) return Astro.redirect(`/checkout/${encodeURIComponent(String(checkoutId))}`, 303);
		actionError = 'Checkout was created, but no checkout id was returned.';
	} else {
		actionError = result.error;
	}
}

const page = await loadMarketplaceProductPage(Astro, productId);
const product = page.data.product;
---

<TreeseedOperationalMarketLayout title={page.title} description={page.description} currentPath={Astro.url.pathname} helpContext={page.helpContext} feedbackContext={page.feedbackContext}>
	<main class="ts-commerce-page">
		<DetailTemplate title={page.title} description={page.description} eyebrow={label(product?.kind, 'Marketplace product')} metadata={page.data.metadata} actions={page.actions}>
			{actionError ? <p class="ts-commerce-error">{actionError}</p> : null}
			{product ? (
				<div class="ts-commerce-two-column">
					<section class="ts-commerce-panel">
						<div class="ts-commerce-panel-header">
							<div>
								<p class="ts-commerce-eyebrow">Offers</p>
								<h2>Choose a governed path</h2>
							</div>
						</div>
						<div class="ts-commerce-grid">
							{page.data.offers.length ? page.data.offers.map((offer) => (
								<article class="ts-commerce-card">
									<p class="ts-commerce-eyebrow">{label(offer.mode, 'offer')}</p>
									<h3>{offer.title}</h3>
									<dl class="ts-commerce-kv">
										<div><dt>Amount</dt><dd>{money(offer.unitAmount, offer.currency, offer.billingInterval)}</dd></div>
										<div><dt>Mirror</dt><dd>{label(offer.stripeSyncStatus, 'not required')}</dd></div>
									</dl>
									<div class="ts-commerce-actions">
										{offer.checkoutEligible ? (
											<form method="post">
												<input type="hidden" name="offerId" value={offer.id} />
												<input type="hidden" name="priceId" value={offer.priceId ?? ''} />
												<input type="hidden" name="quantity" value="1" />
												<button class="ts-commerce-button" type="submit">Start checkout</button>
											</form>
										) : null}
										{offer.serviceEligible ? <a class="ts-commerce-button" href={`/services/new?offerId=${encodeURIComponent(offer.id)}`}>Request scope</a> : null}
										{offer.capacityInquiryEligible && product.capacityListingId ? <a class="ts-commerce-button" href={`/capacity/${encodeURIComponent(product.capacityListingId)}`}>Capacity inquiry</a> : null}
										{!offer.checkoutEligible && !offer.serviceEligible && !offer.capacityInquiryEligible ? <span class="ts-commerce-muted">Seller review required</span> : null}
									</div>
								</article>
							)) : <p class="ts-commerce-muted">No buyer-visible offers are available yet.</p>}
						</div>
					</section>
					<CommerceOwnershipSummary ownershipModel={product.ownershipModel} summary={product.buyerVisibleOwnershipSummary} stewards={product.stewardshipSummary ?? []} />
				</div>
			) : (
				<Panel title="Product unavailable">
					<p>{page.description}</p>
				</Panel>
			)}
		</DetailTemplate>
	</main>
</TreeseedOperationalMarketLayout>
