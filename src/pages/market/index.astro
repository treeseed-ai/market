---
import { listSiteTemplates } from '@treeseed/core/templates';
import TreeseedPublicLayout from '../../layouts/TreeseedPublicLayout.astro';
import MarketProductCard from '../../components/market/MarketProductCard.astro';
import Button from '../../../packages/core/src/components/ui/forms/Button.astro';
import Panel from '../../../packages/core/src/components/ui/surface/Panel.astro';
import EmptyState from '../../../packages/core/src/components/ui/surface/EmptyState.astro';
import { createMarketTemplateCatalogProvider } from '../../lib/market/catalog.js';
import { resolveMarketStore } from '../../lib/market/store.js';

const templateListing = await listSiteTemplates({
	locals: Astro.locals,
	catalogProvider: createMarketTemplateCatalogProvider(Astro.locals),
});
const store = resolveMarketStore(Astro.locals);
const knowledgePacks = store ? await store.listKnowledgePacks(null) : [];
---

<TreeseedPublicLayout
	title="TreeSeed Market"
	description="Browse templates and knowledge packs inside TreeSeed."
	currentPath={Astro.url.pathname}
>
	<Panel
		eyebrow="Market"
		title="Reusable foundations for knowledge hubs and agent teams"
		description="Templates give you working project scaffolds. Knowledge packs give you reusable direction, source material, and packaged operational context."
	/>

	<section class="ts-section-grid ts-stack-top">
		<Panel title="Templates" description="Launch hubs with a proven operational baseline.">
			<Button slot="actions" href="/market/templates/" variant="secondary" size="sm">Browse templates</Button>
			<div class="ts-card-list">
				{templateListing.items.map((entry) => (
					<MarketProductCard
						href={`/market/templates/${entry.slug}/`}
						slug={entry.slug}
						title={entry.title}
						summary={entry.summary}
						category={entry.category}
						featured={entry.featured}
						publisherName={entry.publisherName}
						templateVersion={entry.templateVersion}
						priceModel={entry.priceModel}
					/>
				))}
			</div>
		</Panel>
		<Panel title="Knowledge packs" description="Publish reusable knowledge sets with install and trust context attached.">
			<Button slot="actions" href="/market/knowledge-packs/" variant="secondary" size="sm">Browse packs</Button>
			<div class="ts-card-list">
				{knowledgePacks.length > 0 ? knowledgePacks.map((entry: any) => (
					<MarketProductCard
						href={`/market/knowledge-packs/${entry.slug}/`}
						slug={entry.slug}
						title={entry.name}
						summary={entry.summary ?? 'Reusable source material and market-packaged knowledge assets.'}
						category="Knowledge pack"
						publisherName="TreeSeed"
						badges={[entry.visibility, entry.installStrategy]}
					/>
				)) : <EmptyState title="No public knowledge packs" description="No public knowledge packs are published yet." />}
			</div>
		</Panel>
	</section>
</TreeseedPublicLayout>
